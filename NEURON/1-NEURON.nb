Cell[CellGroupData[{

Cell["10. Measurement-centric neuron concept", "Section",ExpressionUUID->"67294092-2a59-1541-9154-9dc44d693537"],

Cell["\<\
The project\[CloseCurlyQuote]s most important extension beyond standard \
digital neurons is to treat the neuron as a measurement system. \
\>", "Text",ExpressionUUID->"8c5cbbbe-e1cd-0e41-8998-be9b0d2fa23a"],

Cell[CellGroupData[{

Cell["10.1. Standard AI neuron view", "Subsection",ExpressionUUID->"9c690707-c79a-1b46-8594-81e7344d8c54"],

Cell["\<\
Most artificial neurons are treated as weighted transfer functions. \
\>", "Text",ExpressionUUID->"f2c918be-bd08-2f42-8664-f55d6d530fcc"]
}, Open  ]],

Cell[CellGroupData[{

Cell["10.2. Proposed measurement neuron view", "Subsection",ExpressionUUID->"f8d9f43e-ec8b-384b-a121-7a046c913349"],

Cell["A richer neuron is a system that: ", "Text",ExpressionUUID->"d49157a1-9dd7-c34c-bd6f-e781d5ce8f4d"],

Cell["samples signals,", "Item",ExpressionUUID->"cdeed24c-7498-e646-9bb4-e1a18cf1b8c8"],

Cell["filters them by scale and context,", "Item",ExpressionUUID->"23b20ff7-7507-b544-9e95-d80e319ca7ec"],

Cell["stabilizes internal distinctions,", "Item",ExpressionUUID->"4025b1d3-86e9-7946-8c94-d11764480784"],

Cell["stores relevant measurement traces,", "Item",ExpressionUUID->"abeb7681-8101-e84e-b437-dd7f145d054d"],

Cell["routes outputs based on persistence and relevance.", "Item",ExpressionUUID->"06600965-0264-c446-a753-578d8d9c0b9b"]
}, Open  ]],

Cell[CellGroupData[{

Cell["10.3. Formal statement", "Subsection",ExpressionUUID->"35f7ae94-8a60-e340-a221-a858891b74b3"],

Cell[TextData[{
 "A neuron should be modeled not just as: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["y", "TI"], "\[LongEqual]", "\[Phi]", 
         RowBox[{"(", 
           RowBox[{
             StyleBox["w", "TI"], "\[CenterDot]", 
             StyleBox["x", "TI"], "+", 
             StyleBox["b", "TI"]}], ")"}]}], TraditionalForm], "errors" -> {},
      "input" -> "y = \\phi(w\\cdot x + b)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "5727ba42-9947-fa4d-ad3b-e1aea49108e5"],
 "but as: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["y", "TI"], 
          StyleBox["t", "TI"]], "\[LongEqual]", "\[CapitalPhi]", 
         RowBox[{"(", 
           RowBox[{
             SubscriptBox[
              StyleBox["x", "TI"], 
              StyleBox["t", "TI"]], ",", 
             SubscriptBox["\[Mu]", 
              StyleBox["t", "TI"]], ",", 
             SubscriptBox[
              StyleBox["c", "TI"], 
              StyleBox["t", "TI"]], ",", 
             SubscriptBox[
              StyleBox["h", "TI"], 
              StyleBox["t", "TI"]], ",", 
             SubscriptBox[
              StyleBox["g", "TI"], 
              StyleBox["t", "TI"]], ",", 
             SubscriptBox["\[Theta]", 
              StyleBox["t", "TI"]]}], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "y_t = \\Phi(x_t, \\mu_t, c_t, h_t, g_t, \\theta_t)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "2eaefea1-384a-ba49-9eb9-152173f511be"],
 "where output depends on internal measurement, closure, history, geometry, \
and adaptive parameters. "
}], "Text",ExpressionUUID->"0bda2f90-d1fa-5b44-96eb-c43133a9a0ec"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{0},
      "Spacer1"]},
    {
     TemplateBox[{0},
      "Spacer1"]}
   },
   AutoDelete->False,
   FrameStyle->Directive[
     LightDarkSwitched[
      GrayLevel[0.8], 
      GrayLevel[0.4867756]], 
     AbsoluteThickness[1]],
   GridBoxDividers->{
    "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
   GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Text", "MarkdownDelimiter",
 ShowStringCharacters->False,
 Background->None,ExpressionUUID->"a1bdbd1e-c1c7-134a-89c2-adb20f128d98"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["11. Closure and persistence", "Section",ExpressionUUID->"8c1f23e8-f326-3740-89cd-b396cc9e3e1c"],

Cell[CellGroupData[{

Cell["\<\
11.1. Why closure is useful even before RHUFT claims are proven\
\>", "Subsection",ExpressionUUID->"6b44476e-1f0f-0448-9219-517ec3674a57"],

Cell["\<\
In computational terms, closure can be treated as a persistence metric: \
\>", "Text",ExpressionUUID->"c3e2a510-d9fc-ea46-9dee-2e1ff3f36e05"],

Cell["how much a state returns to itself,", "Item",ExpressionUUID->"c28585be-3809-844f-91ef-2908974e8412"],

Cell["how stable it remains under perturbation,", "Item",ExpressionUUID->"2f2d2d28-f830-b947-95aa-4c8eba653a96"],

Cell["how much identity is maintained through recurrent update.", "Item",ExpressionUUID->"343fc293-f7b6-9d4a-85cb-4f8a6bbd2f89"],

Cell["This already has practical engineering value. ", "Text",ExpressionUUID->"534177e7-5191-114a-bee6-14d829891d7e"]
}, Open  ]],

Cell[CellGroupData[{

Cell["11.2. Candidate computational closure measures", "Subsection",ExpressionUUID->"693d9335-772c-644d-9e93-517ae9dd8e6a"],

Cell["A closure score might be based on: ", "Text",ExpressionUUID->"64234ba6-62d9-5c42-a502-a4508fabd3ab"],

Cell["recurrence error,", "Item",ExpressionUUID->"cc6da3c2-8c97-2544-9c62-5b9467b7a3d1"],

Cell["attractor distance,", "Item",ExpressionUUID->"abca5570-3dc1-8a48-8205-960f060b2852"],

Cell["cycle consistency,", "Item",ExpressionUUID->"0d842fd7-d51a-b448-bcf6-91c19367b84f"],

Cell["memory retention,", "Item",ExpressionUUID->"4f4d26af-bc08-1246-9a99-a5dd90de5003"],

Cell["spectral radius constraints,", "Item",ExpressionUUID->"e97c2298-1156-9542-aa70-8dfa91af49e3"],

Cell["Lyapunov decrease.", "Item",ExpressionUUID->"2faaa421-5f91-ad40-afa7-828553204567"]
}, Open  ]],

Cell[CellGroupData[{

Cell["11.3. Immediate design value", "Subsection",ExpressionUUID->"030d91fe-265e-7144-a32e-6ca4343d04df"],

Cell["Closure variables can act as: ", "Text",ExpressionUUID->"c5832a2c-e3d4-ce4c-9d84-d8708aef6215"],

Cell["regularizers,", "Item",ExpressionUUID->"25492de4-fd75-0941-8a99-aaef18c3ac9c"],

Cell["routing signals,", "Item",ExpressionUUID->"8a69ce15-95d8-2449-8670-c00a2f64a618"],

Cell["memory gates,", "Item",ExpressionUUID->"453fca55-d73d-834f-817a-443776469534"],

Cell["anomaly detectors,", "Item",ExpressionUUID->"6c3ebe70-92db-834f-bd77-a69ef410c84d"],

Cell["stability monitors.", "Item",ExpressionUUID->"55d558a6-6753-6340-b1d8-0475cd425ebb"],

