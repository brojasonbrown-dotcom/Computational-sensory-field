   "Grid"]], "Text", "MarkdownDelimiter",
  ShowStringCharacters->False,
  Background->None,ExpressionUUID->"eadaad60-085d-344a-bd97-9bdbcac37497"],
 "\n9. Source fields, effective potentials, and equilibrium pockets\nThis \
section models the emergence of local stable regions from source \
distributions. \n",
 Cell[BoxData[{
  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{
     "gaussianSourcePotential", ",", "\[IndentingNewLine]", "  ", 
      "sourceFieldPotential", ",", "\[IndentingNewLine]", "  ", 
      "effectivePotential2D", ",", "\[IndentingNewLine]", "  ", 
      "effectiveForce2D", ",", "\[IndentingNewLine]", "  ", 
      "rotatingFrameEquilibria", ",", "\[IndentingNewLine]", "  ", 
      "jacobian2D", ",", "\[IndentingNewLine]", "  ", 
      "equilibriumStability2D", ",", "\[IndentingNewLine]", "  ", "hessian2D",
       ",", "\[IndentingNewLine]", "  ", "basinType2D"}], 
     "\[IndentingNewLine]", "]"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"gaussianSourcePotential", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"x0_", ",", "y0_"}], "}"}], ",", "amp_", ",", "width_"}], 
       "]"}], "[", 
      RowBox[{"x_", ",", "y_"}], "]"}], ":=", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"-", "amp"}], " ", 
      RowBox[{"Exp", "[", 
       RowBox[{
        RowBox[{"-", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"x", "-", "x0"}], ")"}], "^", "2"}], "+", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"y", "-", "y0"}], ")"}], "^", "2"}]}], ")"}]}], "/", 
        RowBox[{"width", "^", "2"}]}], "]"}]}]}], ";"}], 
   "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"sourceFieldPotential", "[", "sources_List", "]"}], "[", 
      RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
     RowBox[{"Total", "[", "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"gaussianSourcePotential", "[", 
          RowBox[{
           RowBox[{"#", "[", 
            RowBox[{"[", "1", "]"}], "]"}], ",", 
           RowBox[{"#", "[", 
            RowBox[{"[", "2", "]"}], "]"}], ",", 
           RowBox[{"#", "[", 
            RowBox[{"[", "3", "]"}], "]"}]}], "]"}], "[", 
         RowBox[{"x", ",", "y"}], "]"}], " ", "&"}], " ", "/@", " ", 
       "sources"}], "\[IndentingNewLine]", "]"}]}], ";"}], 
   "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"effectivePotential2D", "[", 
       RowBox[{"pot_", ",", 
        RowBox[{"\[CapitalOmega]_", "?", "NumericQ"}]}], "]"}], "[", 
      RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"pot", "[", 
       RowBox[{"x", ",", "y"}], "]"}], "-", 
      RowBox[{
       RowBox[{"1", "/", "2"}], " ", 
       RowBox[{"\[CapitalOmega]", "^", "2"}], " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"x", "^", "2"}], "+", 
         RowBox[{"y", "^", "2"}]}], ")"}]}]}]}], ";"}], 
   "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"effectiveForce2D", "[", 
       RowBox[{"pot_", ",", 
        RowBox[{"\[CapitalOmega]_", "?", "NumericQ"}]}], "]"}], "[", 
      RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
     RowBox[{"-", 
      RowBox[{"Grad", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"effectivePotential2D", "[", 
          RowBox[{"pot", ",", "\[CapitalOmega]"}], "]"}], "[", 
         RowBox[{"x", ",", "y"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"x", ",", "y"}], "}"}]}], "]"}]}]}], ";"}], 
   "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"rotatingFrameEquilibria", "[", 
      RowBox[{"pot_", ",", 
       RowBox[{"\[CapitalOmega]_", "?", "NumericQ"}]}], "]"}], ":=", 
     RowBox[{"Solve", "[", "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"Thread", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"effectiveForce2D", "[", 
           RowBox[{"pot", ",", "\[CapitalOmega]"}], "]"}], "[", 
          RowBox[{"x", ",", "y"}], "]"}], "==", 
         RowBox[{"{", 
          RowBox[{"0", ",", "0"}], "}"}]}], "]"}], ",", "\[IndentingNewLine]",
        "  ", 
       RowBox[{"{", 
        RowBox[{"x", ",", "y"}], "}"}], ",", "\[IndentingNewLine]", "  ", 
       "Reals"}], "\[IndentingNewLine]", "]"}]}], ";"}], 
   "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"jacobian2D", "[", 
      RowBox[{"field_", ",", "vars_List"}], "]"}], ":=", 
     RowBox[{"D", "[", 
      RowBox[{"field", ",", 
       RowBox[{"{", "vars", "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"hessian2D", "[", 
      RowBox[{"f_", ",", "vars_List"}], "]"}], ":=", 
     RowBox[{"D", "[", 
      RowBox[{"f", ",", 
       RowBox[{"{", 
        RowBox[{"vars", ",", "2"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"basinType2D", "[", 
      RowBox[{"pot_", ",", 
       RowBox[{"\[CapitalOmega]_", "?", "NumericQ"}], ",", 
       RowBox[{"point", " ", ":", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"x0_", "?", "NumericQ"}], ",", 
          RowBox[{"y0_", "?", "NumericQ"}]}], "}"}]}]}], "]"}], ":=", 
     RowBox[{"Module", "[", "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"hess", ",", "vals"}], "}"}], ",", "\[IndentingNewLine]", 
       "  ", 
       RowBox[{
        RowBox[{"hess", "=", 
         RowBox[{"N", " ", "@", " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"hessian2D", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"effectivePotential2D", "[", 
                RowBox[{"pot", ",", "\[CapitalOmega]"}], "]"}], "[", 
               RowBox[{"x", ",", "y"}], "]"}], ",", 
              RowBox[{"{", 
               RowBox[{"x", ",", "y"}], "}"}]}], "]"}], " ", "/.", " ", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"x", "->", "x0"}], ",", 
              RowBox[{"y", "->", "y0"}]}], "}"}]}], ")"}]}]}], ";", 
        "\[IndentingNewLine]", "  ", 
        RowBox[{"vals", "=", 
         RowBox[{"Eigenvalues", "[", "hess", "]"}]}], ";", 
        "\[IndentingNewLine]", "  ", 
        RowBox[{"Which", "[", "\[IndentingNewLine]", "    ", 
         RowBox[{
          RowBox[{"And", " ", "@@", " ", 
           RowBox[{"Thread", "[", 
            RowBox[{"vals", ">", "0"}], "]"}]}], ",", "\"\<LocalMinimum\>\"", 
          ",", "\[IndentingNewLine]", "    ", 
          RowBox[{"And", " ", "@@", " ", 
           RowBox[{"Thread", "[", 
            RowBox[{"vals", "<", "0"}], "]"}]}], ",", "\"\<LocalMaximum\>\"", 
          ",", "\[IndentingNewLine]", "    ", "True", ",", "\"\<Saddle\>\""}],
          "\[IndentingNewLine]", "  ", "]"}]}]}], "\[IndentingNewLine]", 
      "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"equilibriumStability2D", "[", 
     RowBox[{"pot_", ",", 
      RowBox[{"\[CapitalOmega]_", "?", "NumericQ"}], ",", 
      RowBox[{"point", " ", ":", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"x0_", "?", "NumericQ"}], ",", 
         RowBox[{"y0_", "?", "NumericQ"}]}], "}"}]}]}], "]"}], ":=", 
    RowBox[{"Module", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"{", "jac", "}"}], ",", "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"jac", "=", 
        RowBox[{"N", " ", "@", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"jacobian2D", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"effectiveForce2D", "[", 
               RowBox[{"pot", ",", "\[CapitalOmega]"}], "]"}], "[", 
              RowBox[{"x", ",", "y"}], "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"x", ",", "y"}], "}"}]}], "]"}], " ", "/.", " ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"x", "->", "x0"}], ",", 
             RowBox[{"y", "->", "y0"}]}], "}"}]}], ")"}]}]}], ";", 
       "\[IndentingNewLine]", "  ", 
       RowBox[{"<|", "\[IndentingNewLine]", "    ", 
        RowBox[{
         RowBox[{"\"\<Point\>\"", "->", "point"}], ",", "\[IndentingNewLine]",
          "    ", 
         RowBox[{"\"\<Jacobian\>\"", "->", "jac"}], ",", 
         "\[IndentingNewLine]", "    ", 
         RowBox[{"\"\<Eigenvalues\>\"", "->", 
          RowBox[{"Eigenvalues", "[", "jac", "]"}]}], ",", 
         "\[IndentingNewLine]", "    ", 
         RowBox[{"\"\<BasinType\>\"", "->", 
          RowBox[{"basinType2D", "[", 
           RowBox[{"pot", ",", "\[CapitalOmega]", ",", "point"}], "]"}]}]}], 
        "\[IndentingNewLine]", "  ", "|>"}]}]}], "\[IndentingNewLine]", 
     "]"}]}], ";"}]}], "Input",ExpressionUUID->
  "fd298d13-2cdc-174a-8c0e-591b7b273ff2"],
 "\nInterpretation\nThis is the correct mathematical form of ideas such as: \n\
stable pockets,\nresonance islands,\nlocal basin structure,\nrelative balance \
between source attraction and rotating-frame effects.\n",
 Cell[BoxData[
  TagBox[GridBox[{
     {
      TemplateBox[{0},
       "Spacer1"]},
     {
      TemplateBox[{0},
       "Spacer1"]}
    },
    AutoDelete->False,
    FrameStyle->Directive[
      LightDarkSwitched[
       GrayLevel[0.8], 
       GrayLevel[0.4867756]], 
      AbsoluteThickness[1]],
    GridBoxDividers->{
     "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
    GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
   "Grid"]], "Text", "MarkdownDelimiter",
  ShowStringCharacters->False,
  Background->None,ExpressionUUID->"449260c0-1a44-2e40-9b64-72e5f5403329"],
 "\n10. Field circulation, curl, and phase winding\nThis section separates \
distinct meanings of \[OpenCurlyDoubleQuote]vortex.\[CloseCurlyDoubleQuote] \n\
",
 Cell[BoxData[{
  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{
     "curl2D", ",", "\[IndentingNewLine]", "  ", "circulationIntegral", ",", 
      "\[IndentingNewLine]", "  ", "phaseWindingNumber", ",", 
      "\[IndentingNewLine]", "  ", "helicityDensitySymbolic", ",", 
      "\[IndentingNewLine]", "  ", "streamFunctionField"}], 
     "\[IndentingNewLine]", "]"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"curl2D", "[", "field_", "]"}], "[", 
      RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{"field", "[", 
         RowBox[{"[", "2", "]"}], "]"}], ",", "x"}], "]"}], "-", 
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{"field", "[", 
         RowBox[{"[", "1", "]"}], "]"}], ",", "y"}], "]"}]}]}], ";"}], 
   "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"circulationIntegral", "[", 
      RowBox[{"field_", ",", "curve_", ",", "s_Symbol", ",", 
       RowBox[{"{", 
        RowBox[{"smin_", ",", "smax_"}], "}"}]}], "]"}], ":=", 
     RowBox[{"Integrate", "[", "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"field", " ", "@@", " ", 
          RowBox[{"curve", "[", "s", "]"}]}], ")"}], " ", ".", " ", 
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{"curve", "[", "s", "]"}], ",", "s"}], "]"}]}], ",", 
       "\[IndentingNewLine]", "  ", 
       RowBox[{"{", 
        RowBox[{"s", ",", "smin", ",", "smax"}], "}"}]}], 
      "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"phaseWindingNumber", "[", 
      RowBox[{"phase_", ",", "curve_", ",", "s_Symbol", ",", 
       RowBox[{"{", 
        RowBox[{"smin_", ",", "smax_"}], "}"}]}], "]"}], ":=", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "/", 
        RowBox[{"(", 
         RowBox[{"2", " ", "Pi"}], ")"}]}], ")"}], " ", 
      RowBox[{"Integrate", "[", 
       RowBox[{
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{"phase", " ", "@@", " ", 
           RowBox[{"curve", "[", "s", "]"}]}], ",", "s"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"s", ",", "smin", ",", "smax"}], "}"}]}], "]"}]}]}], ";"}], 
   "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"helicityDensitySymbolic", "[", 
      RowBox[{"vecPotential_", ",", "vars_List"}], "]"}], ":=", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"vecPotential", " ", ".", " ", 
      RowBox[{"Curl", "[", 
       RowBox[{"vecPotential", ",", "vars"}], "]"}]}]}], ";"}], 
   "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"streamFunctionField", "[", "\[Psi]_", "]"}], "[", 
     RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{"\[Psi]", "[", 
         RowBox[{"x", ",", "y"}], "]"}], ",", "y"}], "]"}], ",", 
      RowBox[{"-", 
       RowBox[{"D", "[", 
        RowBox[{
         RowBox[{"\[Psi]", "[", 
          RowBox[{"x", ",", "y"}], "]"}], ",", "x"}], "]"}]}]}], "}"}]}], 
   ";"}]}], "Input",ExpressionUUID->"d2200f96-8eef-6f44-a2bc-8d54f27f5c13"],
 "\nRigorous distinction\n",
 StyleBox["Field circulation",
  FontWeight->Bold],
 ": nonzero curl or nontrivial circulation integral.\n",
 StyleBox["Phase winding",
  FontWeight->Bold],
 ": quantized or nontrivial phase loop number.\n",
 StyleBox["Rotating mode structure",
  FontWeight->Bold],
 ": eigenmodes whose geometry exhibits helical or spiral organization.\n",
 StyleBox["Helicity",
  FontWeight->Bold],
 ": linkage or twisting of field lines in 3D vector fields.\nThese are \
related but not identical concepts. \n",
 Cell[BoxData[
  TagBox[GridBox[{
     {
      TemplateBox[{0},
       "Spacer1"]},
     {
      TemplateBox[{0},
       "Spacer1"]}
    },
    AutoDelete->False,
    FrameStyle->Directive[
      LightDarkSwitched[
       GrayLevel[0.8], 
       GrayLevel[0.4867756]], 
      AbsoluteThickness[1]],
    GridBoxDividers->{
     "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
    GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
   "Grid"]], "Text", "MarkdownDelimiter",
  ShowStringCharacters->False,
  Background->None,ExpressionUUID->"168ee32e-bbe5-f749-92ad-68a60750577d"],
 "\n11. Cross-scale coupled-mode systems\n",
 Cell[BoxData[{
  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", 
     RowBox[{"coupledModeMatrix", ",", "coupledModeFlow"}], "]"}], ";"}], 
   "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"coupledModeMatrix", "[", 
      RowBox[{
       RowBox[{"n_Integer", "?", "Positive"}], ",", 
       RowBox[{"damping_", "?", "NumericQ"}], ",", 
       RowBox[{"coupling_", "?", "NumericQ"}]}], "]"}], ":=", 
     RowBox[{"Module", "[", "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"diag", ",", "off"}], "}"}], ",", "\[IndentingNewLine]", "  ", 
       RowBox[{
        RowBox[{"diag", "=", 
         RowBox[{"DiagonalMatrix", "[", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"-", "damping"}], "-", 
             RowBox[{"i", "/", "10"}]}], ",", 
            RowBox[{"{", 
             RowBox[{"i", ",", "1", ",", "n"}], "}"}]}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", "  ", 
        RowBox[{"off", "=", 
         RowBox[{
          RowBox[{"SparseArray", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{
               RowBox[{"Band", "[", 
                RowBox[{"{", 
                 RowBox[{"1", ",", "2"}], "}"}], "]"}], "->", "coupling"}], ",", 
              RowBox[{
               RowBox[{"Band", "[", 
                RowBox[{"{", 
                 RowBox[{"2", ",", "1"}], "}"}], "]"}], "->", "coupling"}]}], 
             "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"n", ",", "n"}], "}"}]}], "]"}], " ", "//", " ", 
          "Normal"}]}], ";", "\[IndentingNewLine]", "  ", 
        RowBox[{"diag", "+", "off"}]}]}], "\[IndentingNewLine]", "]"}]}], 
    ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"coupledModeFlow", "[", 
     RowBox[{
      RowBox[{"matrix_", "?", "MatrixQ"}], ",", "init_List", ",", 
      RowBox[{"tmax_", "?", "NumericQ"}]}], "]"}], ":=", 
    "\[IndentingNewLine]", "  ", 
    RowBox[{"NDSolveValue", "[", "\[IndentingNewLine]", "    ", 
     RowBox[{
      RowBox[{"{", "\[IndentingNewLine]", "      ", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"a", "'"}], "[", "t", "]"}], "==", 
         RowBox[{"matrix", " ", ".", " ", 
          RowBox[{"a", "[", "t", "]"}]}]}], ",", "\[IndentingNewLine]", 
        "      ", 
        RowBox[{
         RowBox[{"a", "[", "0", "]"}], "==", "init"}]}], 
       "\[IndentingNewLine]", "    ", "}"}], ",", "\[IndentingNewLine]", 
      "    ", "a", ",", "\[IndentingNewLine]", "    ", 
      RowBox[{"{", 
       RowBox[{"t", ",", "0", ",", "tmax"}], "}"}]}], "\[IndentingNewLine]", 
     "  ", "]"}]}], ";"}]}], "Input",ExpressionUUID->
  "42a6a039-910d-354f-94ae-d41670b027e1"],
 "\nInterpretation\nThis is a surrogate model for transfer across nearby \
scales or neighboring modes.\nTests include: \nwhether energy localizes,\n\
whether it cascades,\nwhether phase locking occurs,\nwhether long-lived mode \
families emerge.\n",
 Cell[BoxData[
  TagBox[GridBox[{
     {
      TemplateBox[{0},
       "Spacer1"]},
     {
      TemplateBox[{0},
       "Spacer1"]}
    },
    AutoDelete->False,
    FrameStyle->Directive[
      LightDarkSwitched[
       GrayLevel[0.8], 
       GrayLevel[0.4867756]], 
      AbsoluteThickness[1]],
    GridBoxDividers->{
     "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
    GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
   "Grid"]], "Text", "MarkdownDelimiter",
  ShowStringCharacters->False,
  Background->None,ExpressionUUID->"efb8de06-e625-8b43-82a4-4725ba374894"],
 "\n12. Hyperuniformity and structured order diagnostics\n",
 Cell[BoxData[{
  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{
     "primeIndicatorSequence", ",", "\[IndentingNewLine]", "  ", 
      "structureFactor1D", ",", "\[IndentingNewLine]", "  ", 
      "numberVariance1D", ",", "\[IndentingNewLine]", "  ", 
      "hyperuniformityProxy"}], "\[IndentingNewLine]", "]"}], ";"}], 
   "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"primeIndicatorSequence", "[", 
      RowBox[{"n_Integer", "?", "Positive"}], "]"}], ":=", 
     RowBox[{"Boole", "[", 
      RowBox[{"PrimeQ", " ", "/@", " ", 
       RowBox[{"Range", "[", "n", "]"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"structureFactor1D", "[", "list_List", "]"}], ":=", 
     RowBox[{
      RowBox[{
       RowBox[{"Abs", "[", 
        RowBox[{"Fourier", "[", 
         RowBox[{"N", " ", "@", " ", "list"}], "]"}], "]"}], "^", "2"}], "/", 
      RowBox[{"Length", "[", "list", "]"}]}]}], ";"}], 
   "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"numberVariance1D", "[", 
      RowBox[{"list_List", ",", 
       RowBox[{"window_Integer", "?", "Positive"}]}], "]"}], ":=", 
     RowBox[{"Module", "[", "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"{", "sums", "}"}], ",", "\[IndentingNewLine]", "  ", 
       RowBox[{
        RowBox[{"sums", "=", 
         RowBox[{"Total", " ", "/@", " ", 
          RowBox[{"Partition", "[", 
           RowBox[{"list", ",", "window", ",", "1"}], "]"}]}]}], ";", 
        "\[IndentingNewLine]", "  ", 
        RowBox[{"Variance", "[", "sums", "]"}]}]}], "\[IndentingNewLine]", 
      "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"hyperuniformityProxy", "[", "list_List", "]"}], ":=", 
    RowBox[{"Module", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"{", "sf", "}"}], ",", "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"sf", "=", 
        RowBox[{"structureFactor1D", "[", "list", "]"}]}], ";", 
       "\[IndentingNewLine]", "  ", 
       RowBox[{"<|", "\[IndentingNewLine]", "    ", 
        RowBox[{
         RowBox[{"\"\<LowFrequencyMean\>\"", "->", 
          RowBox[{"Mean", "[", 
           RowBox[{"Take", "[", 
            RowBox[{"sf", ",", 
             RowBox[{"UpTo", "[", "5", "]"}]}], "]"}], "]"}]}], ",", 
         "\[IndentingNewLine]", "    ", 
         RowBox[{"\"\<Spectrum\>\"", "->", "sf"}]}], "\[IndentingNewLine]", 
        "  ", "|>"}]}]}], "\[IndentingNewLine]", "]"}]}], ";"}]}], "Input",
  ExpressionUUID->"a32dad5b-d813-b34e-bb92-0d89710f3a09"],
 "\nInterpretation\nThis does ",
 StyleBox["not",
  FontWeight->Bold],
 " prove a physical theory of primes.\nIt provides a comparison class for: \n\
aperiodic order,\nstructured nonrandomness,\nsuppressed low-frequency \
fluctuations.\n",
 Cell[BoxData[
  TagBox[GridBox[{
     {
      TemplateBox[{0},
       "Spacer1"]},
     {
      TemplateBox[{0},
       "Spacer1"]}
    },
    AutoDelete->False,
    FrameStyle->Directive[
      LightDarkSwitched[
       GrayLevel[0.8], 
       GrayLevel[0.4867756]], 
      AbsoluteThickness[1]],
    GridBoxDividers->{
     "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
    GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
   "Grid"]], "Text", "MarkdownDelimiter",
  ShowStringCharacters->False,
  Background->None,ExpressionUUID->"fb25faef-d492-8f46-95e3-be56bc6bea54"],
 "\n13. Unified multiscale report\n",
 Cell[BoxData[{
  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", 
     RowBox[{"multiscaleResonanceReport", ",", "synthesisEvidenceScore"}], 
     "]"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"multiscaleResonanceReport", "[", "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"matrix_", "?", "MatrixQ"}], ",", "\[IndentingNewLine]", "  ", 
       "state_List", ",", "\[IndentingNewLine]", "  ", 
       RowBox[{"initialDensity_", "?", "MatrixQ"}], ",", 
       "\[IndentingNewLine]", "  ", "phaseSchedule_List", ",", 
       "\[IndentingNewLine]", "  ", 
       RowBox[{"p_", "?", "NumericQ"}], ",", "\[IndentingNewLine]", "  ", 
       RowBox[{"scaleSteps_Integer", ":", " ", "8"}], ",", 
       "\[IndentingNewLine]", "  ", 
       RowBox[{"tol_", ":", " ", 
        RowBox[{"10", "^", 
         RowBox[{"-", "8"}]}]}]}], "\[IndentingNewLine]", "]"}], ":=", 
     RowBox[{"Module", "[", "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"spec", ",", "scale", ",", "selection", ",", "verdict"}], 
        "}"}], ",", "\[IndentingNewLine]", "  ", 
       RowBox[{
        RowBox[{"spec", "=", 
         RowBox[{"spectralData", "[", "matrix", "]"}]}], ";", 
        "\[IndentingNewLine]", "  ", 
        RowBox[{"scale", "=", 
         RowBox[{"scaleFixedPointData", "[", 
          RowBox[{"state", ",", "scaleSteps", ",", "tol"}], "]"}]}], ";", 
        "\[IndentingNewLine]", "  ", 
        RowBox[{"selection", "=", 
         RowBox[{"pointerModeData", "[", 
          RowBox[{"initialDensity", ",", "phaseSchedule", ",", "p"}], "]"}]}],
         ";", "\[IndentingNewLine]", "  ", 
        RowBox[{"verdict", "=", 
         RowBox[{"<|", "\[IndentingNewLine]", "    ", 
          RowBox[{
           RowBox[{"\"\<SpectrallyStableQ\>\"", "->", 
            RowBox[{"TrueQ", "[", 
             RowBox[{"spec", "[", "\"\<ContinuousTimeStableQ\>\"", "]"}], 
             "]"}]}], ",", "\[IndentingNewLine]", "    ", 
           RowBox[{"\"\<ScaleRobustQ\>\"", "->", 
            RowBox[{"TrueQ", "[", 
             RowBox[{"scale", "[", "\"\<FixedPointQ\>\"", "]"}], "]"}]}], ",",
            "\[IndentingNewLine]", "    ", 
           RowBox[{"\"\<SelectionStableQ\>\"", "->", 
            RowBox[{
             RowBox[{"Max", "[", 
              RowBox[{"selection", "[", "\"\<PointerWeights\>\"", "]"}], 
              "]"}], ">", 
             RowBox[{"1", "/", "2"}]}]}]}], "\[IndentingNewLine]", "  ", 
          "|>"}]}], ";", " ", "\[IndentingNewLine]", "  ", 
        RowBox[{"<|", "\[IndentingNewLine]", "    ", 
         RowBox[{
          RowBox[{"\"\<Spectral\>\"", "->", "spec"}], ",", 
          "\[IndentingNewLine]", "    ", 
          RowBox[{"\"\<Scale\>\"", "->", "scale"}], ",", 
          "\[IndentingNewLine]", "    ", 
          RowBox[{"\"\<Selection\>\"", "->", "selection"}], ",", 
          "\[IndentingNewLine]", "    ", 
          RowBox[{"\"\<Verdict\>\"", "->", "verdict"}], ",", 
          "\[IndentingNewLine]", "    ", 
          RowBox[{"\"\<AllThreeQ\>\"", "->", 
           RowBox[{"And", " ", "@@", " ", 
            RowBox[{"Values", "[", "verdict", "]"}]}]}], ",", 
          "\[IndentingNewLine]", "    ", 
          RowBox[{"\"\<FixedScaleResidual\>\"", "->", 
           RowBox[{"fixedScaleResidual", "[", "state", "]"}]}]}], 
         "\[IndentingNewLine]", "  ", "|>"}]}]}], "\[IndentingNewLine]", 
      "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"synthesisEvidenceScore", "[", "report_Association", "]"}], ":=", 
    RowBox[{"Mean", " ", "@", " ", 
     RowBox[{"Boole", " ", "@", " ", 
      RowBox[{"Values", "[", 
       RowBox[{"report", "[", "\"\<Verdict\>\"", "]"}], "]"}]}]}]}], ";"}]}], 
  "Input",ExpressionUUID->"371b3fb1-2bd5-994e-9cc9-92f6909094a3"],
 "\nInterpretation\nThis does ",
 StyleBox["not",
  FontWeight->Bold],
 " assume all sectors are one law.\nIt computes them side by side and \
identifies where they agree or disagree. \n",
 Cell[BoxData[
  TagBox[GridBox[{
     {
      TemplateBox[{0},
       "Spacer1"]},
     {
      TemplateBox[{0},
       "Spacer1"]}
    },
    AutoDelete->False,
    FrameStyle->Directive[
      LightDarkSwitched[
       GrayLevel[0.8], 
       GrayLevel[0.4867756]], 
      AbsoluteThickness[1]],
    GridBoxDividers->{
     "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
    GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
   "Grid"]], "Text", "MarkdownDelimiter",
  ShowStringCharacters->False,
  Background->None,ExpressionUUID->"73e0fe7f-75ba-1747-af46-ccf7dbe2dfb1"],
 "\n14. Visual test suite\n14.1 Spectral panel\n",
 Cell[BoxData[{
  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", "spectralPanel", "]"}], ";"}], 
   "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"spectralPanel", "[", 
     RowBox[{"matrix_", "?", "MatrixQ"}], "]"}], ":=", 
    RowBox[{"Module", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"vals", "=", 
        RowBox[{"Eigenvalues", "[", 
         RowBox[{"N", " ", "@", " ", "matrix"}], "]"}]}], "}"}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"GraphicsGrid", "[", 
       RowBox[{"{", 
        RowBox[{"{", "\[IndentingNewLine]", "     ", 
         RowBox[{
          RowBox[{"ListPlot", "[", "\[IndentingNewLine]", "       ", 
           RowBox[{
            RowBox[{"Transpose", "[", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"Re", "[", "vals", "]"}], ",", 
               RowBox[{"Im", "[", "vals", "]"}]}], "}"}], "]"}], ",", 
            "\[IndentingNewLine]", "       ", 
            RowBox[{"Frame", "->", "True"}], ",", "\[IndentingNewLine]", 
            "       ", 
            RowBox[{"AspectRatio", "->", "1"}], ",", "\[IndentingNewLine]", 
            "       ", 
            RowBox[{
            "PlotLabel", "->", "\"\<Eigenvalues in complex plane\>\""}], ",", 
            "\[IndentingNewLine]", "       ", 
            RowBox[{"FrameLabel", "->", 
             RowBox[{"{", 
              RowBox[{"\"\<Re\>\"", ",", "\"\<Im\>\""}], "}"}]}], ",", 
            "\[IndentingNewLine]", "       ", 
            RowBox[{"Epilog", "->", 
             RowBox[{"{", 
              RowBox[{"Red", ",", "Dashed", ",", 
               RowBox[{"Line", "[", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"{", 
                   RowBox[{"0", ",", 
                    RowBox[{"-", "10"}]}], "}"}], ",", 
                  RowBox[{"{", 
                   RowBox[{"0", ",", "10"}], "}"}]}], "}"}], "]"}]}], 
              "}"}]}]}], "\[IndentingNewLine]", "     ", "]"}], ",", 
          "\[IndentingNewLine]", "     ", 
          RowBox[{"BarChart", "[", 
           RowBox[{
            RowBox[{"Re", "[", "vals", "]"}], ",", 
            RowBox[{"Frame", "->", "True"}], ",", 
            RowBox[{
            "PlotLabel", "->", "\"\<Real parts of eigenvalues\>\""}]}], 
           "]"}]}], "\[IndentingNewLine]", "   ", "}"}], "}"}], "]"}]}], 
     "\[IndentingNewLine]", "]"}]}], ";"}]}], "Input",ExpressionUUID->
  "272f394f-0545-e542-ada9-2fcd6f47da58"],
 "\n14.2 Scale panel\n",
 Cell[BoxData[{
  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", "scalePanel", "]"}], ";"}], 
   "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"scalePanel", "[", 
     RowBox[{"state_List", ",", 
      RowBox[{"steps_Integer", ":", " ", "6"}]}], "]"}], ":=", 
    RowBox[{"Module", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"orbit", ",", "residuals"}], "}"}], ",", "\[IndentingNewLine]",
       "  ", 
      RowBox[{
       RowBox[{"orbit", "=", 
        RowBox[{"rgOrbit", "[", 
         RowBox[{"dyadicCoarseGrain", ",", "state", ",", "steps"}], "]"}]}], ";",
        "\[IndentingNewLine]", "  ", 
       RowBox[{"residuals", "=", 
        RowBox[{"scaleResiduals", "[", 
         RowBox[{"state", ",", "steps"}], "]"}]}], ";", "\[IndentingNewLine]",
        "  ", 
       RowBox[{"GraphicsGrid", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", "\[IndentingNewLine]", "     ", 
           RowBox[{
            RowBox[{"ListLinePlot", "[", 
             RowBox[{"state", ",", 
              RowBox[{"Frame", "->", "True"}], ",", 
              RowBox[{"PlotLabel", "->", "\"\<Initial state\>\""}]}], "]"}], ",",
             "\[IndentingNewLine]", "     ", 
            RowBox[{"ListLinePlot", "[", 
             RowBox[{"residuals", ",", 
              RowBox[{"Frame", "->", "True"}], ",", 
              RowBox[{"PlotLabel", "->", "\"\<Scale residuals\>\""}]}], 
             "]"}]}], "\[IndentingNewLine]", "   ", "}"}], ",", 
          RowBox[{"{", "\[IndentingNewLine]", "     ", 
           RowBox[{
            RowBox[{"Column", "[", "\[IndentingNewLine]", "       ", 
             RowBox[{"MapIndexed", "[", "\[IndentingNewLine]", "         ", 
              RowBox[{
               RowBox[{
                RowBox[{"ListLinePlot", "[", 
                 RowBox[{"#1", ",", 
                  RowBox[{"Frame", "->", "True"}], ",", 
                  RowBox[{"PlotRange", "->", "All"}], ",", 
                  RowBox[{"PlotLabel", "->", 
                   RowBox[{"Row", "[", 
                    RowBox[{"{", 
                    RowBox[{"\"\<Scale \>\"", ",", 
                    RowBox[{
                    RowBox[{"First", "[", "#2", "]"}], "-", "1"}], 
                    ",", "\"\< length \>\"", ",", 
                    RowBox[{"Length", "[", "#1", "]"}]}], "}"}], "]"}]}]}], 
                 "]"}], " ", "&"}], ",", "\[IndentingNewLine]", "         ", 
               "orbit"}], "\[IndentingNewLine]", "       ", "]"}], 
             "\[IndentingNewLine]", "     ", "]"}], ",", 
            "\[IndentingNewLine]", "     ", 
            RowBox[{"Graphics", "[", 
             RowBox[{"{", "}"}], "]"}]}], "\[IndentingNewLine]", "   ", 
           "}"}]}], "}"}], "]"}]}]}], "\[IndentingNewLine]", "]"}]}], ";"}]}],
   "Input",ExpressionUUID->"55bc4549-e46d-4342-9eb9-3d4e0add0ee3"],
 "\n14.3 Selection panel\n",
 Cell[BoxData[{
  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", "pointerPanel", "]"}], ";"}], 
   "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
