Cell[CellGroupData[{

Cell[TextData[{
 "02",
 StyleBox["Neuron",
  FontSlant->Italic],
 "State",
 StyleBox["Space",
  FontSlant->Italic],
 "And",
 StyleBox["Biophysical",
  FontSlant->Italic],
 "Dynamics"
}], "Title",ExpressionUUID->"8eba1b7c-a130-fc48-8c96-fbeb630ccb9a"],

Cell[CellGroupData[{

Cell["Purpose", "Section",ExpressionUUID->"acf8e68d-dfef-7e4d-a7bb-566d15c96d81"],

Cell[TextData[{
 "This is ",
 StyleBox["Notebook 2",
  FontWeight->Bold],
 " in the Neuron Series."
}], "Text",ExpressionUUID->"5654a8d8-f297-734d-b5a3-ebd0998c17c4"],

Cell["\<\
Its goal is to establish a rigorous mathematical state-space formulation for \
neurons, beginning from established biophysical models and extending toward \
computationally useful digital abstractions. This notebook is foundational \
because every later addition\[LongDash]synapses, glia, measurement-state \
variables, closure functionals, multiscale sensing, and RHUFT-inspired \
extensions\[LongDash]depends on having a clean and explicit neuron state \
model.\
\>", "Text",ExpressionUUID->"9f851b09-8af0-e64a-8181-edad0464ce07"],

Cell["This notebook therefore does five things:", "Text",ExpressionUUID->"69e45f98-bfca-a241-9bfd-c070d7db7307"],

Cell["1. defines the neuron as a dynamical state-space system,", "Text",ExpressionUUID->"99814f98-3d11-4946-a591-d4794924705b"],

Cell["\<\
2. organizes a hierarchy of model classes from simple to rich,\
\>", "Text",ExpressionUUID->"5c18ce06-b527-8946-936b-269924a97d92"],

Cell["3. derives core membrane and channel equations,", "Text",ExpressionUUID->"193cc491-7204-fc45-81ac-a36f86631719"],

Cell["\<\
4. explains spatial extension through cable and compartment models,\
\>", "Text",ExpressionUUID->"046646cf-ec0b-644f-848c-22547f73f6f7"],

Cell["\<\
5. prepares the path to digital approximations and RHUFT-compatible \
extensions.\
\>", "Text",ExpressionUUID->"9655bb3a-3a02-7f4b-a9a7-1e22ff0a1fbc"],

Cell["The methodological rule is: ", "Text",ExpressionUUID->"3aa7657e-f286-e943-be48-338ab0783a24"],

Cell[BoxData[GridBox[{
   {
    PaneBox["\<\"every added mechanism must either improve explanatory power, \
computational usefulness, or testability.\"\>",
     BaseStyle->{"Text", FontColor -> LightDarkSwitched[
         GrayLevel[0.35], 
         GrayLevel[0.8602474]]},
     ImageMargins->5,
     ImageSize->{Full, Automatic}]}
  },
  AutoDelete->False,
  GridBoxBackground->{"Columns" -> {{
       LightDarkSwitched[
        GrayLevel[1], 
        GrayLevel[0.278317]]}}},
  GridBoxDividers->{"ColumnsIndexed" -> {1 -> Directive[
        LightDarkSwitched[
         RGBColor[0.87, 0.94, 1], 
         RGBColor[0.2491127, 0.3295188, 0.4231198]], 
        AbsoluteThickness[4]]}, "Rows" -> {{False}}},
  GridBoxItemSize->{
   "Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}]], "Text", \
"BlockQuote",
 Background->None,ExpressionUUID->"8b398a71-d8d0-b24e-a2c9-9b456c3b28d9"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{0},
      "Spacer1"]},
    {
     TemplateBox[{0},
      "Spacer1"]}
   },
   AutoDelete->False,
   FrameStyle->Directive[
     LightDarkSwitched[
      GrayLevel[0.8], 
      GrayLevel[0.4867756]], 
     AbsoluteThickness[1]],
   GridBoxDividers->{
    "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
   GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Text", "MarkdownDelimiter",
 ShowStringCharacters->False,
 Background->None,ExpressionUUID->"62a90bda-cfb2-7c45-b59d-791d8a94d257"]
}, Open  ]],

Cell[CellGroupData[{

Cell["1. The neuron as a state-space system", "Section",ExpressionUUID->"60f720ea-c504-ef4c-ba0a-4d4b5820165c"],

Cell["\<\
A neuron is not best understood as a scalar threshold device. It is a \
dynamical system with internal state, delayed couplings, boundary conditions, \
and multiple interacting timescales. \
\>", "Text",ExpressionUUID->"2cbead2d-a106-d24a-97b6-a23ce5d67b3a"],

Cell[CellGroupData[{

Cell["1.1. General abstract form", "Subsection",ExpressionUUID->"bd1e691c-20df-d849-8e1e-fe670ef5cab5"],

Cell[TextData[{
 "Let the neuron state be ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["x", "TI"], 
         RowBox[{"(", 
           StyleBox["t", "TI"], ")"}], "\[LongEqual]", 
         RowBox[{"(", 
           RowBox[{
             StyleBox["v", "TI"], 
             RowBox[{"(", 
               StyleBox["t", "TI"], ")"}], ",", 
             StyleBox["g", "TI"], 
             RowBox[{"(", 
               StyleBox["t", "TI"], ")"}], ",", 
             StyleBox["s", "TI"], 
             RowBox[{"(", 
               StyleBox["t", "TI"], ")"}], ",", 
             StyleBox["p", "TI"], 
             RowBox[{"(", 
               StyleBox["t", "TI"], ")"}], ",", 
             StyleBox["m", "TI"], 
             RowBox[{"(", 
               StyleBox["t", "TI"], ")"}], ",", 
             StyleBox["r", "TI"], 
             RowBox[{"(", 
               StyleBox["t", "TI"], ")"}], ",", 
             StyleBox["y", "TI"], 
             RowBox[{"(", 
               StyleBox["t", "TI"], ")"}]}], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "x(t) = \\big(v(t), g(t), s(t), p(t), m(t), r(t), y(t)\\big)", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "9b356976-662d-4349-b88c-9c26f592dc6b"],
 "where: "
}], "Text",ExpressionUUID->"5a56d933-2620-b849-9fc1-e7a8e0873ff7"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["v", "TI"], "(", 
         StyleBox["t", "TI"], ")"}], TraditionalForm], "errors" -> {}, 
     "input" -> "v(t)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "0854e6b0-c691-c645-b81c-670826c02c16"],
 " = membrane or compartment voltages,"
}], "Item",ExpressionUUID->"efd3a209-4dea-2241-99a4-04b25c74c5be"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["g", "TI"], "(", 
         StyleBox["t", "TI"], ")"}], TraditionalForm], "errors" -> {}, 
     "input" -> "g(t)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "feea2d4b-cd81-ba4b-a454-d6ca0d295cd3"],
 " = ion channel gating states,"
}], "Item",ExpressionUUID->"c46e6b15-e5af-dd4b-a4e6-479e28361104"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["s", "TI"], "(", 
         StyleBox["t", "TI"], ")"}], TraditionalForm], "errors" -> {}, 
     "input" -> "s(t)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "d637ca4a-4432-8e45-a63f-a7b2b2c32afe"],
 " = synaptic states,"
}], "Item",ExpressionUUID->"aacbcef1-779a-e246-81bf-f5459165ebfd"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["p", "TI"], "(", 
         StyleBox["t", "TI"], ")"}], TraditionalForm], "errors" -> {}, 
     "input" -> "p(t)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "a35af227-b17a-5444-8ccb-45c5db4f0efc"],
 " = plasticity states,"
}], "Item",ExpressionUUID->"102a0579-67e0-cf44-abd0-bc1119dd7303"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["m", "TI"], "(", 
         StyleBox["t", "TI"], ")"}], TraditionalForm], "errors" -> {}, 
     "input" -> "m(t)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "43960e31-212b-f445-9496-3e13ce1717df"],
 " = memory or adaptation states,"
}], "Item",ExpressionUUID->"8b4eb3e5-57e3-c44a-86ad-ddf62eba0cdf"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["r", "TI"], "(", 
         StyleBox["t", "TI"], ")"}], TraditionalForm], "errors" -> {}, 
     "input" -> "r(t)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "0b510ad8-385d-c141-9c86-02b8ab88775d"],
 " = morphology or geometry states,"
}], "Item",ExpressionUUID->"c679358f-6a77-8643-9f78-d00bacab76b5"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["y", "TI"], "(", 
         StyleBox["t", "TI"], ")"}], TraditionalForm], "errors" -> {}, 
     "input" -> "y(t)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "05f2364d-81d9-9944-a071-bbee7048d9da"],
 " = output states."
}], "Item",ExpressionUUID->"017ac1f4-131e-0140-8603-2ace88d4e51a"],

Cell[TextData[{
 "Then the neuron may be written abstractly as ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         FractionBox[
          RowBox[{
            StyleBox["d", "TI"], 
            StyleBox["x", "TI"]}], 
          RowBox[{
            StyleBox["d", "TI"], 
            StyleBox["t", "TI"]}]], "\[LongEqual]", 
         StyleBox["F", "TI"], 
         RowBox[{"(", 
           RowBox[{
             StyleBox["x", "TI"], ",", 
             StyleBox["u", "TI"], ",", "\[Theta]", ",", 
             StyleBox["t", "TI"]}], ")"}]}], TraditionalForm], "errors" -> {},
      "input" -> "\\frac{dx}{dt} = F(x, u, \\theta, t)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "8622ba2f-0d47-f947-8bbc-c7ac485408b8"],
 "with input ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["u", "TI"], "(", 
         StyleBox["t", "TI"], ")"}], TraditionalForm], "errors" -> {}, 
     "input" -> "u(t)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "d298f76a-9d57-1044-90bc-74389f7d9b85"],
 ", parameters ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Theta]", TraditionalForm], "errors" -> {}, "input" -> 
     "\\theta", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "513befca-efa4-f848-97e0-29ac77c1976b"],
 ", and output ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["z", "TI"], 
         RowBox[{"(", 
           StyleBox["t", "TI"], ")"}], "\[LongEqual]", 
         StyleBox["H", "TI"], 
         RowBox[{"(", 
           RowBox[{
             StyleBox["x", "TI"], ",", 
             StyleBox["u", "TI"], ",", "\[Theta]", ",", 
             StyleBox["t", "TI"]}], ")"}], "."}], TraditionalForm], 
     "errors" -> {}, "input" -> "z(t) = H(x, u, \\theta, t).", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "73d2bc24-4f26-0b4d-b16f-4bbb45385e20"],
 "This is the master template. Every model in this notebook is a \
specialization of this form. "
}], "Text",ExpressionUUID->"70eb9008-19a9-6e4f-9b60-e5ae819bee2b"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{0},
      "Spacer1"]},
    {
     TemplateBox[{0},
      "Spacer1"]}
   },
   AutoDelete->False,
   FrameStyle->Directive[
     LightDarkSwitched[
      GrayLevel[0.8], 
      GrayLevel[0.4867756]], 
     AbsoluteThickness[1]],
   GridBoxDividers->{
    "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
   GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Text", "MarkdownDelimiter",
 ShowStringCharacters->False,
 Background->None,ExpressionUUID->"00099b20-9228-ee42-9d7c-289688ce98dd"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["2. The model ladder", "Section",ExpressionUUID->"7059632e-ebb7-014e-a15c-9433692dcca4"],

Cell["\<\
A rigorous program needs a ladder from simple models to detailed models. \
\>", "Text",ExpressionUUID->"7012197c-efca-b649-b9fc-8ceede10eb40"],

Cell[CellGroupData[{

Cell["2.1. Level 0: abstract perceptron", "Subsection",ExpressionUUID->"0c05d1e9-2ecf-2647-8351-df6a0b7a18c3"],

Cell[TextData[{
 "The static perceptron is: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["y", "TI"], "\[LongEqual]", "\[Phi]", 
         RowBox[{"(", 
           RowBox[{
             StyleBox["w", "TI"], "\[CenterDot]", 
             StyleBox["x", "TI"], "+", 
             StyleBox["b", "TI"]}], ")"}]}], TraditionalForm], "errors" -> {},
      "input" -> "y = \\phi(w \\cdot x + b)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "321b121e-26dd-724e-a362-6a13cb90dcd3"],
 "This is computationally useful but biologically extremely poor. It has: "
}], "Text",ExpressionUUID->"d293d068-cf8e-e24b-9889-3f4ba54138a9"],

Cell["no time,", "Item",ExpressionUUID->"84c0f67d-e481-d245-aa51-3b89deb5ac4d"],

Cell["no membrane,", "Item",ExpressionUUID->"7504b95b-abe8-8b47-aa96-adf3122415bf"],

Cell["no channels,", "Item",ExpressionUUID->"443fcd68-43e1-8343-97e4-959c4bf15d31"],

Cell["no morphology,", "Item",ExpressionUUID->"4af523c1-d3ce-2e4f-9168-e643b279a0d8"],

Cell["no synaptic dynamics,", "Item",ExpressionUUID->"40a9f135-1045-0e48-8db6-337be286e030"],

Cell["no internal memory beyond weights.", "Item",ExpressionUUID->"0117816a-3ba9-ba40-9eda-7c8a0c3b0e17"],

Cell["\<\
It is therefore not a neuron in any serious biophysical sense, but it is the \
simplest AI abstraction. \
\>", "Text",ExpressionUUID->"29a1e9e7-c25d-184d-92cc-4591782aa929"]
}, Open  ]],

Cell[CellGroupData[{

Cell["2.2. Level 1: rate neuron", "Subsection",ExpressionUUID->"e4347dd8-efe5-aa49-9225-0b4f114b9902"],

Cell[TextData[{
 "A minimal dynamical rate model is: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Tau]", 
         FractionBox[
          RowBox[{
            StyleBox["d", "TI"], 
            StyleBox["h", "TI"]}], 
          RowBox[{
            StyleBox["d", "TI"], 
            StyleBox["t", "TI"]}]], "\[LongEqual]", "-", 
         StyleBox["h", "TI"], "+", 
         StyleBox["W", "TI"], 
         StyleBox["u", "TI"], "+", 
         StyleBox["b", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\tau \\frac{dh}{dt} = -h + W u + b", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "41292c77-46ed-e841-8468-5550af89715e"],
 "with output ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["y", "TI"], "\[LongEqual]", "\[Phi]", 
         RowBox[{"(", 
           StyleBox["h", "TI"], ")"}], "."}], TraditionalForm], 
     "errors" -> {}, "input" -> "y = \\phi(h).", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "659bb192-813a-7744-a635-5367d3bee966"],
 "This adds time and relaxation but remains a coarse population-style \
approximation. "
}], "Text",ExpressionUUID->"b2b78c32-3f87-ad4e-9121-4879b51e04c7"]
}, Open  ]],

Cell[CellGroupData[{

Cell["2.3. Level 2: leaky integrate-and-fire", "Subsection",ExpressionUUID->"11054f07-5bc7-a64b-a5d9-3d3bd4749d07"],

Cell[TextData[{
 "A single-compartment current-driven membrane satisfies: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["C", "TI"], 
          StyleBox["m", "TI"]], 
         FractionBox[
          RowBox[{
            StyleBox["d", "TI"], 
            StyleBox["V", "TI"]}], 
          RowBox[{
            StyleBox["d", "TI"], 
            StyleBox["t", "TI"]}]], "\[LongEqual]", "-", 
         SubscriptBox[
          StyleBox["g", "TI"], 
          StyleBox["L", "TI"]], 
         RowBox[{"(", 
           RowBox[{
             StyleBox["V", "TI"], "-", 
             SubscriptBox[
              StyleBox["E", "TI"], 
              StyleBox["L", "TI"]]}], ")"}], "+", 
         SubscriptBox[
          StyleBox["I", "TI"], 
          StyleBox["in", FontSlant -> "Plain"]], 
         RowBox[{"(", 
           StyleBox["t", "TI"], ")"}]}], TraditionalForm], "errors" -> {}, 
     "input" -> "C_m \\frac{dV}{dt} = -g_L(V-E_L) + I_{\\mathrm{in}}(t)", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "4f6222b5-329a-e04f-8821-b5fb8be4f069"],
 "with a spike rule: "
}], "Text",ExpressionUUID->"f34ee7c1-d225-f847-bc92-091707f53ead"],

Cell[TextData[{
 "if ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["V", "TI"], 
         RowBox[{"(", 
           SuperscriptBox[
            StyleBox["t", "TI"], "-"], ")"}], "\[GreaterEqual]", 
         SubscriptBox[
          StyleBox["V", "TI"], 
          StyleBox["th", FontSlant -> "Plain"]]}], TraditionalForm], 
     "errors" -> {}, "input" -> "V(t^-) \\ge V_{\\mathrm{th}}", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "a30af259-c86d-2847-9560-09d3b2a5e041"],
 ", emit a spike,"
}], "Item",ExpressionUUID->"eaae431b-bfef-5a46-af33-8caeef43954a"],

Cell[TextData[{
 "reset ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["V", "TI"], "\[Rule]", 
         SubscriptBox[
          StyleBox["V", "TI"], 
          StyleBox["reset", FontSlant -> "Plain"]]}], TraditionalForm], 
     "errors" -> {}, "input" -> "V \\to V_{\\mathrm{reset}}", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "e0a9a7c5-9d16-0b4a-85cc-6170f0c9315d"],
 ","
}], "Item",ExpressionUUID->"aa832e5c-df3c-3148-be9e-ee90c28384c6"],

Cell["optionally impose refractory interval.", "Item",ExpressionUUID->"02186e6c-c76a-294f-8844-ad5dc51296bf"],

Cell["\<\
This is the first true dynamical single-neuron model in the ladder. \
\>", "Text",ExpressionUUID->"4d68efe0-6a96-e844-9cbb-a296204ba4bc"]
}, Open  ]],

Cell[CellGroupData[{

Cell["2.4. Level 3: adaptive integrate-and-fire", "Subsection",ExpressionUUID->"0a04e8f5-fdbe-bb44-b277-7f0b4f63fe22"],

Cell[TextData[{
 "Add an adaptation variable ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["w", "TI"], TraditionalForm], "errors" -> {}, "input" -> "w", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "9358c87d-bb28-e340-84fe-d939dabf83dc"],
 ": ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["C", "TI"], 
          StyleBox["m", "TI"]], 
         FractionBox[
          RowBox[{
            StyleBox["d", "TI"], 
            StyleBox["V", "TI"]}], 
          RowBox[{
            StyleBox["d", "TI"], 
            StyleBox["t", "TI"]}]], "\[LongEqual]", "-", 
         SubscriptBox[
          StyleBox["g", "TI"], 
          StyleBox["L", "TI"]], 
         RowBox[{"(", 
           RowBox[{
             StyleBox["V", "TI"], "-", 
             SubscriptBox[
              StyleBox["E", "TI"], 
              StyleBox["L", "TI"]]}], ")"}], "+", 
         SubscriptBox[
          StyleBox["I", "TI"], 
          StyleBox["in", FontSlant -> "Plain"]], "-", 
         StyleBox["w", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "C_m \\frac{dV}{dt} = -g_L(V-E_L) + I_{\\mathrm{in}} - w", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "fe6e9deb-bb0d-6c4d-946e-f577622a8771"],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[Tau]", 
          StyleBox["w", "TI"]], 
         FractionBox[
          RowBox[{
            StyleBox["d", "TI"], 
            StyleBox["w", "TI"]}], 
          RowBox[{
            StyleBox["d", "TI"], 
            StyleBox["t", "TI"]}]], "\[LongEqual]", 
         StyleBox["a", "TI"], 
         RowBox[{"(", 
           RowBox[{
             StyleBox["V", "TI"], "-", 
             SubscriptBox[
              StyleBox["E", "TI"], 
              StyleBox["L", "TI"]]}], ")"}], "-", 
         StyleBox["w", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\tau_w \\frac{dw}{dt} = a(V-E_L) - w", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "794be01b-a128-6445-8fbd-568404cd9c48"],
 "and after a spike: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["V", "TI"], "\[Rule]", 
         SubscriptBox[
          StyleBox["V", "TI"], 
          StyleBox["reset", FontSlant -> "Plain"]], ",    ", 
         StyleBox["w", "TI"], "\[Rule]", 
         StyleBox["w", "TI"], "+", 
         StyleBox["b", "TI"], "."}], TraditionalForm], "errors" -> {}, 
     "input" -> "V \\to V_{\\mathrm{reset}}, \\qquad w \\to w + b.", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "788f78b5-9769-1249-b4f3-a250b8a5a977"],
 "This captures spike-frequency adaptation and slow internal memory. "
}], "Text",ExpressionUUID->"d1519eab-b8a4-f54e-95b0-dd3c5dad9992"]
}, Open  ]],

Cell[CellGroupData[{

Cell["2.5. Level 4: Hodgkin\[Dash]Huxley conductance model", "Subsection",ExpressionUUID->"5da3079f-726a-f64f-bf37-50a8391da787"],

Cell[TextData[{
 "The canonical conductance model is: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["C", "TI"], 
          StyleBox["m", "TI"]], 
         FractionBox[
          RowBox[{
            StyleBox["d", "TI"], 
            StyleBox["V", "TI"]}], 
          RowBox[{
            StyleBox["d", "TI"], 
            StyleBox["t", "TI"]}]], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["I", "TI"], 
          StyleBox["ext", FontSlant -> "Plain"]], "-", 
         SubscriptBox[
          OverscriptBox[
           StyleBox["g", "TI"], "_"], 
          StyleBox["Na", FontSlant -> "Plain"]], 
         SuperscriptBox[
          StyleBox["m", "TI"], "3"], 
         StyleBox["h", "TI"], 
         RowBox[{"(", 
           RowBox[{
             StyleBox["V", "TI"], "-", 
             SubscriptBox[
              StyleBox["E", "TI"], 
              StyleBox["Na", FontSlant -> "Plain"]]}], ")"}], "-", 
         SubscriptBox[
          OverscriptBox[
           StyleBox["g", "TI"], "_"], 
          StyleBox["K", FontSlant -> "Plain"]], 
         SuperscriptBox[
          StyleBox["n", "TI"], "4"], 
         RowBox[{"(", 
           RowBox[{
             StyleBox["V", "TI"], "-", 
             SubscriptBox[
              StyleBox["E", "TI"], 
              StyleBox["K", FontSlant -> "Plain"]]}], ")"}], "-", 
         SubscriptBox[
          StyleBox["g", "TI"], 
          StyleBox["L", "TI"]], 
         RowBox[{"(", 
           RowBox[{
             StyleBox["V", "TI"], "-", 
             SubscriptBox[
              StyleBox["E", "TI"], 
              StyleBox["L", "TI"]]}], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "C_m \\frac{dV}{dt}\n=\nI_{\\mathrm{ext}}\n-\n\\bar{g}_{\\mathrm{Na}} \
m^3 h (V-E_{\\mathrm{Na}})\n-\n\\bar{g}_{\\mathrm{K}} n^4 (V-E_{\\mathrm{K}})\
\n-\ng_L (V-E_L)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "a7367ca6-c5d8-ca40-a8d4-786a0bd16245"],
 "with gating dynamics ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         FractionBox[
          RowBox[{
            StyleBox["d", "TI"], 
            StyleBox["m", "TI"]}], 
          RowBox[{
            StyleBox["d", "TI"], 
            StyleBox["t", "TI"]}]], "\[LongEqual]", 
         SubscriptBox["\[Alpha]", 
          StyleBox["m", "TI"]], 
         RowBox[{"(", 
           StyleBox["V", "TI"], ")"}], 
         RowBox[{"(", 
           RowBox[{"1", "-", 
             StyleBox["m", "TI"]}], ")"}], "-", 
         SubscriptBox["\[Beta]", 
          StyleBox["m", "TI"]], 
         RowBox[{"(", 
           StyleBox["V", "TI"], ")"}], 
         StyleBox["m", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\frac{dm}{dt} = \\alpha_m(V)(1-m) - \\beta_m(V)m", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "b4363a61-7316-3043-8eb2-84d2ddfeea2e"],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         FractionBox[
          RowBox[{
            StyleBox["d", "TI"], 
            StyleBox["h", "TI"]}], 
          RowBox[{
            StyleBox["d", "TI"], 
            StyleBox["t", "TI"]}]], "\[LongEqual]", 
         SubscriptBox["\[Alpha]", 
          StyleBox["h", "TI"]], 
         RowBox[{"(", 
           StyleBox["V", "TI"], ")"}], 
         RowBox[{"(", 
           RowBox[{"1", "-", 
             StyleBox["h", "TI"]}], ")"}], "-", 
         SubscriptBox["\[Beta]", 
          StyleBox["h", "TI"]], 
         RowBox[{"(", 
           StyleBox["V", "TI"], ")"}], 
         StyleBox["h", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\frac{dh}{dt} = \\alpha_h(V)(1-h) - \\beta_h(V)h", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "7187956a-caeb-744d-ab00-45748ccfd1a3"],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         FractionBox[
          RowBox[{
            StyleBox["d", "TI"], 
            StyleBox["n", "TI"]}], 
          RowBox[{
            StyleBox["d", "TI"], 
            StyleBox["t", "TI"]}]], "\[LongEqual]", 
         SubscriptBox["\[Alpha]", 
          StyleBox["n", "TI"]], 
         RowBox[{"(", 
           StyleBox["V", "TI"], ")"}], 
         RowBox[{"(", 
           RowBox[{"1", "-", 
             StyleBox["n", "TI"]}], ")"}], "-", 
         SubscriptBox["\[Beta]", 
          StyleBox["n", "TI"]], 
         RowBox[{"(", 
           StyleBox["V", "TI"], ")"}], 
         StyleBox["n", "TI"], "."}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\frac{dn}{dt} = \\alpha_n(V)(1-n) - \\beta_n(V)n.", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "b609d54c-804e-c44d-9bfd-8259ef864fcc"],
 "This is the classical biophysical template. "
}], "Text",ExpressionUUID->"15883f67-677c-ea40-967f-e8fcef0a441c"]
}, Open  ]],

Cell[CellGroupData[{

Cell["2.6. Level 5: multicompartment cable neuron", "Subsection",ExpressionUUID->"0e8f99dd-d7f3-7f4a-9edf-db67714c9d79"],

Cell["\<\
A spatially extended neuron satisfies cable-style equations on dendrites and \
axon, either as PDEs or compartmental ODE systems. \
\>", "Text",ExpressionUUID->"98b7aa68-ecfc-8c4c-af1c-ad068a13d186"]
}, Open  ]],

Cell[CellGroupData[{

Cell["2.7. Level 6: synaptically rich adaptive neuron", "Subsection",ExpressionUUID->"27aa7bfe-c14c-3a46-b2b6-0d15a44a7582"],

Cell["\<\
Add receptor classes, delays, short-term plasticity, long-term plasticity, \
and modulatory state. \
\>", "Text",ExpressionUUID->"6988d70c-b009-0b4b-a15d-2b87c9844feb"]
}, Open  ]],

Cell[CellGroupData[{

Cell["2.8. Level 7: glia-coupled and measurement-extended neuron", \
"Subsection",ExpressionUUID->"431194ee-5b0c-034d-b6b0-2314c42c82ce"],

Cell["\<\
Add astrocyte/glia couplings, local field modulation, measurement variables, \
and closure metrics.\
\>", "Text",ExpressionUUID->"2be41b33-3cef-2044-9e40-a48e062f8bcf"],

Cell["\<\
This notebook develops Levels 1\[Dash]5 in formal detail and prepares the \
extensions. \
\>", "Text",ExpressionUUID->"f1b301d8-0973-2c4a-8622-8d0bdc450f8a"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{0},
      "Spacer1"]},
    {
     TemplateBox[{0},
      "Spacer1"]}
   },
   AutoDelete->False,
   FrameStyle->Directive[
     LightDarkSwitched[
      GrayLevel[0.8], 
      GrayLevel[0.4867756]], 
     AbsoluteThickness[1]],
   GridBoxDividers->{
    "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
   GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Text", "MarkdownDelimiter",
 ShowStringCharacters->False,
 Background->None,ExpressionUUID->"0bfd2395-486f-e448-baba-7b39594c3d71"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["3. Membrane balance law", "Section",ExpressionUUID->"8999cf1f-6451-c84b-a4c1-6dbea41b97a5"],

Cell[CellGroupData[{

Cell["3.1. Conservation principle", "Subsection",ExpressionUUID->"96138135-6593-3f49-8abe-381646c077df"],

Cell[TextData[{
 "A membrane patch acts as a capacitor with ionic and input currents. The \
fundamental balance law is: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["C", "TI"], 
          StyleBox["m", "TI"]], 
         FractionBox[
          RowBox[{
            StyleBox["d", "TI"], 
            StyleBox["V", "TI"]}], 
          RowBox[{
            StyleBox["d", "TI"], 
            StyleBox["t", "TI"]}]], "\[LongEqual]", "-", 
         UnderscriptBox["\[Sum]", 
          StyleBox["k", "TI"], LimitsPositioning -> True], 
         SubscriptBox[
          StyleBox["I", "TI"], 
          StyleBox["k", "TI"]], "+", 
         SubscriptBox[
          StyleBox["I", "TI"], 
          StyleBox["ext", FontSlant -> "Plain"]], "+", 
         SubscriptBox[
          StyleBox["I", "TI"], 
          StyleBox["syn", FontSlant -> "Plain"]]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "C_m \\frac{dV}{dt} = -\\sum_k I_k + I_{\\mathrm{ext}} + \
I_{\\mathrm{syn}}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "2d14d81b-a775-8040-8f07-ef574efd73d4"],
 "where each ionic current has form ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["I", "TI"], 
          StyleBox["k", "TI"]], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["g", "TI"], 
          StyleBox["k", "TI"]], 
         RowBox[{"(", 
           RowBox[{
             StyleBox["V", "TI"], ",", 
             SubscriptBox["\[Xi]", 
              StyleBox["k", "TI"]]}], ")"}], 
         RowBox[{"(", 
           RowBox[{
             StyleBox["V", "TI"], "-", 
             SubscriptBox[
              StyleBox["E", "TI"], 
              StyleBox["k", "TI"]]}], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> "I_k = g_k(V, \\xi_k)(V - E_k)", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "be0ed247-26eb-ab4a-aa8d-8452be5b0362"],
 "with: "
}], "Text",ExpressionUUID->"e4fb545c-5146-c74f-ad73-9d187e1f63af"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["g", "TI"], 
        StyleBox["k", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "g_k", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "a646cca1-8e74-614e-a225-73b0fde81506"],
 " = effective conductance,"
}], "Item",ExpressionUUID->"3fe4f17e-bdcb-7645-af9c-e9fedf287a4a"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox["\[Xi]", 
        StyleBox["k", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "\\xi_k", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "df64e519-4aff-4e45-8c30-584592f753be"],
 " = channel state variables,"
}], "Item",ExpressionUUID->"7d078a02-fd95-874f-afdf-7f043fe82ed2"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["E", "TI"], 
        StyleBox["k", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "E_k", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "0e08ae3a-d0cc-9849-96a0-9241486f9f58"],
 " = reversal potential."
}], "Item",ExpressionUUID->"c5ff7dab-2e0d-1246-9ddf-35fa72cb50b6"],

Cell["\<\
This is the most important equation in single-neuron biophysics. \
\>", "Text",ExpressionUUID->"4cc276ec-8c80-af4d-a735-3e929969d40e"]
}, Open  ]],

Cell[CellGroupData[{

Cell["3.2. Leak current", "Subsection",ExpressionUUID->"c6c7694b-dd69-814c-9211-4e0128bcdf4f"],

Cell[TextData[{
 "The simplest current is leak: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["I", "TI"], 
          StyleBox["L", "TI"]], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["g", "TI"], 
          StyleBox["L", "TI"]], 
         RowBox[{"(", 
           RowBox[{
             StyleBox["V", "TI"], "-", 
             SubscriptBox[
              StyleBox["E", "TI"], 
              StyleBox["L", "TI"]]}], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> "I_L = g_L(V-E_L)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "3f16478f-f9f7-ce40-85c4-807dd8d5bb43"],
 "giving the passive membrane equation ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["C", "TI"], 
          StyleBox["m", "TI"]], 
         FractionBox[
          RowBox[{
            StyleBox["d", "TI"], 
            StyleBox["V", "TI"]}], 
          RowBox[{
            StyleBox["d", "TI"], 
            StyleBox["t", "TI"]}]], "\[LongEqual]", "-", 
         SubscriptBox[
          StyleBox["g", "TI"], 
          StyleBox["L", "TI"]], 
         RowBox[{"(", 
           RowBox[{
             StyleBox["V", "TI"], "-", 
             SubscriptBox[
              StyleBox["E", "TI"], 
              StyleBox["L", "TI"]]}], ")"}], "+", 
         SubscriptBox[
          StyleBox["I", "TI"], 
          StyleBox["ext", FontSlant -> "Plain"]], "."}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "C_m \\frac{dV}{dt} = -g_L(V-E_L) + I_{\\mathrm{ext}}.", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "3f46d317-cf9a-a54b-9a94-676c7cbfb0d8"]
}], "Text",ExpressionUUID->"d13c42ac-a52d-7a4f-b64a-2700eb89bbf7"]
}, Open  ]],

Cell[CellGroupData[{

Cell["3.3. Time constant and input resistance", "Subsection",ExpressionUUID->"92b32625-eb89-184c-b9bd-61686e29f656"],

Cell[TextData[{
 "The passive membrane has: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[Tau]", 
          StyleBox["m", "TI"]], "\[LongEqual]", 
         FractionBox[
          SubscriptBox[
           StyleBox["C", "TI"], 
           StyleBox["m", "TI"]], 
          SubscriptBox[
           StyleBox["g", "TI"], 
           StyleBox["L", "TI"]]], ",    ", 
         SubscriptBox[
          StyleBox["R", "TI"], 
          StyleBox["in", FontSlant -> "Plain"]], "\[LongEqual]", 
         FractionBox["1", 
          SubscriptBox[
           StyleBox["g", "TI"], 
           StyleBox["L", "TI"]]], "."}], TraditionalForm], "errors" -> {}, 
     "input" -> 
     "\\tau_m = \\frac{C_m}{g_L}, \\qquad R_{\\mathrm{in}} = \\frac{1}{g_L}.",
      "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "780c6431-1ad9-7247-bf30-1f0e18148609"],
 "These are fundamental macroscopic quantities for reduced neuron models. "
}], "Text",ExpressionUUID->"1f2f08b0-84a1-824d-9177-0f310a572a07"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{0},
      "Spacer1"]},
    {
     TemplateBox[{0},
      "Spacer1"]}
   },
   AutoDelete->False,
   FrameStyle->Directive[
     LightDarkSwitched[
      GrayLevel[0.8], 
      GrayLevel[0.4867756]], 
     AbsoluteThickness[1]],
   GridBoxDividers->{
    "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
   GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Text", "MarkdownDelimiter",
 ShowStringCharacters->False,
 Background->None,ExpressionUUID->"7020cc07-0307-5749-bce8-f63c5405a828"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["4. Integrate-and-fire formalism", "Section",ExpressionUUID->"770b2a18-6d5c-1548-8217-87ea7f908449"],

Cell[CellGroupData[{

Cell["4.1. Deterministic LIF", "Subsection",ExpressionUUID->"af4a21a3-5ec8-0443-9eb1-e69df9028bf1"],

Cell[TextData[{
 "The leaky integrate-and-fire model is: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[Tau]", 
          StyleBox["m", "TI"]], 
         FractionBox[
          RowBox[{
            StyleBox["d", "TI"], 
            StyleBox["V", "TI"]}], 
          RowBox[{
            StyleBox["d", "TI"], 
            StyleBox["t", "TI"]}]], "\[LongEqual]", "-", 
         RowBox[{"(", 
           RowBox[{
             StyleBox["V", "TI"], "-", 
             SubscriptBox[
              StyleBox["E", "TI"], 
              StyleBox["L", "TI"]]}], ")"}], "+", 
         SubscriptBox[
          StyleBox["R", "TI"], 
          StyleBox["m", "TI"]], 
         StyleBox["I", "TI"], 
         RowBox[{"(", 
           StyleBox["t", "TI"], ")"}]}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\tau_m \\frac{dV}{dt} = -(V-E_L) + R_m I(t)", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "1a0d341b-c9ea-0b47-adb9-6ec7f1836ea5"],
 "with spike condition at threshold ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["V", "TI"], 
        StyleBox["th", FontSlant -> "Plain"]], TraditionalForm], 
     "errors" -> {}, "input" -> "V_{\\mathrm{th}}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "ac8d7fcd-ca1f-2247-9962-4ab3384502e0"],
 " and reset."
}], "Text",ExpressionUUID->"6003d1d3-53f1-3a4d-bb86-1ede1a3e6b0d"],

Cell["This model can be solved explicitly for many inputs. ", "Text",ExpressionUUID->"0897e9b9-3f3e-1147-9c2c-f0d252875a5f"]
}, Open  ]],

Cell[CellGroupData[{

Cell["4.2. Constant input solution", "Subsection",ExpressionUUID->"efd08a84-b751-e642-b701-f9095cce449d"],

Cell[TextData[{
 "For constant current ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["I", "TI"], 
         RowBox[{"(", 
           StyleBox["t", "TI"], ")"}], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["I", "TI"], "0"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "I(t)=I_0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "58216502-6040-614b-b140-b924af1aa507"],
 ", ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["V", "TI"], 
         RowBox[{"(", 
           StyleBox["t", "TI"], ")"}], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["E", "TI"], 
          StyleBox["L", "TI"]], "+", 
         SubscriptBox[
          StyleBox["R", "TI"], 
          StyleBox["m", "TI"]], 
         SubscriptBox[
          StyleBox["I", "TI"], "0"], "+", 
         RowBox[{"(", 
           RowBox[{
             StyleBox["V", "TI"], 
             RowBox[{"(", "0", ")"}], "-", 
             SubscriptBox[
              StyleBox["E", "TI"], 
              StyleBox["L", "TI"]], "-", 
             SubscriptBox[
              StyleBox["R", "TI"], 
              StyleBox["m", "TI"]], 
             SubscriptBox[
              StyleBox["I", "TI"], "0"]}], ")"}], 
         SuperscriptBox[
          StyleBox["e", "TI"], 
          RowBox[{"-", 
            StyleBox["t", "TI"], "/", 
            SubscriptBox["\[Tau]", 
             StyleBox["m", "TI"]]}]], "."}], TraditionalForm], "errors" -> {},
      "input" -> 
     "V(t) = E_L + R_m I_0 + \\big(V(0) - E_L - R_m I_0\\big)e^{-t/\\tau_m}.",
      "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "c71f1277-bd60-2c40-bcb7-85495d288719"]
}], "Text",ExpressionUUID->"67c56bae-1cf1-f649-876e-808d62fb43e9"]
}, Open  ]],

Cell[CellGroupData[{

Cell["4.3. Stochastic extension", "Subsection",ExpressionUUID->"95a2f933-5874-9e4e-9c0b-2aa1045a7d94"],

Cell[TextData[{
 "Noise can be added: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["d", "TI"], 
         StyleBox["V", "TI"], "\[LongEqual]", 
         FractionBox[
          RowBox[{"-", 
            RowBox[{"(", 
              RowBox[{
                StyleBox["V", "TI"], "-", 
                SubscriptBox[
                 StyleBox["E", "TI"], 
                 StyleBox["L", "TI"]]}], ")"}], "+", 
            SubscriptBox[
             StyleBox["R", "TI"], 
             StyleBox["m", "TI"]], 
            StyleBox["I", "TI"], 
            RowBox[{"(", 
              StyleBox["t", "TI"], ")"}]}], 
          SubscriptBox["\[Tau]", 
           StyleBox["m", "TI"]]], 
         StyleBox["d", "TI"], 
         StyleBox["t", "TI"], "+", "\[Sigma]", "\[DifferentialD]", 
         SubscriptBox[
          StyleBox["W", "TI"], 
          StyleBox["t", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "dV = \\frac{-(V-E_L) + R_m I(t)}{\\tau_m}dt + \\sigma \\, dW_t", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "bb42dd5e-49f4-fc4b-abaf-c9798daa6c3c"],
