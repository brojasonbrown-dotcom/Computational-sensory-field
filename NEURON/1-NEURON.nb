Cell[CellGroupData[{

Cell["6. The model ladder", "Section",ExpressionUUID->"dcfcf205-cb66-6143-a9d8-2636802f9690"],

Cell["\<\
A complete neuron framework should not jump to the most complex model first. \
It should define a strict ladder. \
\>", "Text",ExpressionUUID->"90934438-31a4-f043-b4d6-411db2064f09"],

Cell[CellGroupData[{

Cell["6.1. Ladder of neuron formalisms", "Subsection",ExpressionUUID->"116c67d7-3878-9e4f-88ad-49b0e8f4dcdf"],

Cell["1. perceptron,", "Text",ExpressionUUID->"d7533573-82cd-0841-a5ac-7c5fba6e1603"],

Cell["2. rate neuron,", "Text",ExpressionUUID->"36f69177-87d8-9a4d-8964-2432184a146f"],

Cell["3. leaky integrate-and-fire,", "Text",ExpressionUUID->"13512187-2a92-fe4a-ab28-58c5eeabe426"],

Cell["4. adaptive leaky integrate-and-fire,", "Text",ExpressionUUID->"a45e7c5d-1f36-b749-9c16-439b66ccd2ee"],

Cell["5. Hodgkin-Huxley neuron,", "Text",ExpressionUUID->"39ca9ebf-ebdb-0e4d-aa71-208fbc9800a0"],

Cell["6. multicompartment cable-theory neuron,", "Text",ExpressionUUID->"e46676d9-4a3c-2046-803e-467562b4bd15"],

Cell["7. synaptically rich adaptive neuron,", "Text",ExpressionUUID->"c8d3ba77-49b5-f640-9906-d564ed29d061"],

Cell["8. glia-modulated neuron,", "Text",ExpressionUUID->"ec186ccf-6e43-a549-b15b-e21e1003b4ec"],

Cell["9. measurement-aware neuron,", "Text",ExpressionUUID->"a3f25af5-f2da-d646-a669-297fcaa72513"],

Cell["10. closure-regularized digital RHUFT neuron. ", "Text",ExpressionUUID->"b676b5a4-61aa-6945-96c6-a949c73566f3"]
}, Open  ]],

Cell[CellGroupData[{

Cell["6.2. Why this ladder is necessary", "Subsection",ExpressionUUID->"23e1c169-e3cf-4a41-a765-b7572b6ae42a"],

Cell["\<\
Each level should preserve or approximate the previous while adding one new \
class of variables. This allows: \
\>", "Text",ExpressionUUID->"7285912c-33c9-4242-8dab-808423cf3df7"],

Cell["derivation,", "Item",ExpressionUUID->"aad507fa-64ae-6544-99cc-4d87afd01e58"],

Cell["approximation,", "Item",ExpressionUUID->"c5b7a2fd-dc16-d54a-9668-0a24f071d00d"],

Cell["benchmarking,", "Item",ExpressionUUID->"8bc8e435-25a9-2245-ab8c-8187d333e757"],

Cell["ablation,", "Item",ExpressionUUID->"eb009b53-6041-9c42-b3f5-08e09eed73ce"],

Cell["translation to AI.", "Item",ExpressionUUID->"7564a834-bae0-444d-9ec8-a6ef5639616f"],

