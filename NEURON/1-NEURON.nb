Cell[CellGroupData[{

Cell["3. What \[OpenCurlyDoubleQuote]complete mathematical neuron\
\[CloseCurlyDoubleQuote] means", "Section",ExpressionUUID->"2d821cc7-0e18-\
3844-8a6f-2af89568d86a"],

Cell["The phrase must be operationally defined. ", "Text",ExpressionUUID->"e4a8d769-d6d2-6b49-8b6d-358ce5be9795"],

Cell[CellGroupData[{

Cell["3.1. Definition", "Subsection",ExpressionUUID->"a8e9bdf6-3100-f944-9a28-d0ec71075d77"],

Cell[TextData[{
 "A neuron model is ",
 StyleBox["complete relative to an application class",
  FontWeight->Bold],
 " if it specifies all necessary: "
}], "Text",ExpressionUUID->"d4cb6fab-4848-d348-8053-e47536331819"],

Cell["state variables,", "Item",ExpressionUUID->"cf8a37e6-5025-0e42-a2d3-4a86e8fa3cc7"],

Cell["update laws,", "Item",ExpressionUUID->"0c8db365-411a-354e-a37c-1a9dfc4382a9"],

Cell["interaction channels,", "Item",ExpressionUUID->"4b6d03e9-e857-8b4f-8ee8-fcfaf2690aef"],

Cell["memory traces,", "Item",ExpressionUUID->"187fc19f-de22-fc41-9bbc-4304bd0554fa"],

Cell["learning rules,", "Item",ExpressionUUID->"25a8beff-09eb-f148-a563-e78b4bc6beb1"],

Cell["measurement mappings,", "Item",ExpressionUUID->"5a5b6cf4-a7ec-484b-b47a-7493fb4e90d5"],

Cell["stability criteria,", "Item",ExpressionUUID->"d84777d3-58de-6446-a98e-765ac65f1ba9"],

Cell["compositional interfaces,", "Item",ExpressionUUID->"27574572-7fd7-9d48-9f29-8355bc09546f"],

Cell["evaluation metrics,", "Item",ExpressionUUID->"40e2959f-fba8-8d42-a241-63e8f47ad605"],

Cell["\<\
required to reproduce the target computational behaviors of that class. \
\>", "Text",ExpressionUUID->"e42fda63-cf4b-d946-8f16-ba4ce255a3fd"]
}, Open  ]],

Cell[CellGroupData[{

Cell["3.2. Three completeness tiers", "Subsection",ExpressionUUID->"e9e610df-df2d-1b49-8ce3-699a0bbb890f"],

Cell[CellGroupData[{

Cell["Tier 1 \[LongDash] Biological completeness", "Subsubsection",ExpressionUUID->"21b3422a-f811-a14a-8a95-d270024ec0f9"],

Cell["\<\
A model is biologically complete enough when it includes, as needed: \
\>", "Text",ExpressionUUID->"365f4d96-3863-e546-862c-b9fe5cbd92d4"],

Cell["membrane voltage,", "Item",ExpressionUUID->"1afd58c2-c8af-194c-9508-59045a7931be"],

Cell["conductances,", "Item",ExpressionUUID->"0bb9b92b-3a87-8449-ad9f-dd29267cb9f5"],

Cell["ion channel gating,", "Item",ExpressionUUID->"64fe7f41-7538-374b-b8f9-1344360a68dd"],

Cell["morphology,", "Item",ExpressionUUID->"4f060444-a7aa-e947-bb80-b5f9aa1b10e7"],

Cell["compartments,", "Item",ExpressionUUID->"6d435978-10d8-d047-a1e5-e83d7c618c58"],

Cell["synapses,", "Item",ExpressionUUID->"5920144d-f009-ee44-ad64-ca7cb09e4573"],

Cell["delays,", "Item",ExpressionUUID->"4e37a925-99bf-5e4b-92ca-3c074134fa56"],

Cell["plasticity,", "Item",ExpressionUUID->"f6bd493b-5a0e-ac4d-af02-62140dc62b94"],

Cell["modulatory influences,", "Item",ExpressionUUID->"5d8fa672-2162-954e-adf4-00b3367fb403"],

Cell["glial coupling.", "Item",ExpressionUUID->"8593a083-fe54-004b-805a-d20e5692e4f1"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Tier 2 \[LongDash] Computational completeness", "Subsubsection",ExpressionUUID->"08efd073-58a5-c14f-8bba-118b1c8d425a"],

Cell["\<\
A model is computationally complete enough when it supports: \
\>", "Text",ExpressionUUID->"069e4655-07ac-e44b-8247-df0069aded51"],

Cell["digital implementation,", "Item",ExpressionUUID->"1479825f-cd9d-ce44-87ff-0e421dfffdd7"],

Cell["training or adaptation,", "Item",ExpressionUUID->"3162dbb4-8473-0747-ae06-e526bff323fc"],

Cell["temporal processing,", "Item",ExpressionUUID->"e8c79434-3ebc-8643-993c-7e56e4bdfe8b"],

Cell["routing and memory,", "Item",ExpressionUUID->"7a6bc5f7-6e87-2049-837d-6aaf3fb9eb37"],

Cell["efficiency constraints,", "Item",ExpressionUUID->"dfea7fc0-52f2-4d4a-9bbc-c5613448ed7a"],

Cell["composability into networks.", "Item",ExpressionUUID->"734af7d8-8a32-6e4d-9341-746c0bd3abb7"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Tier 3 \[LongDash] Measurement-closure completeness", "Subsubsection",ExpressionUUID->"e1a41fca-1e48-0841-9b88-07424cef693a"],

Cell["\<\
A model is complete in the RHUFT-extension sense when it includes: \
\>", "Text",ExpressionUUID->"eaceb786-aa08-de4e-8bca-90b77005545b"],

Cell["internal measurement variables,", "Item",ExpressionUUID->"0ab333a1-7b5e-0547-91d5-eed5a695ca60"],

Cell["multiscale observability,", "Item",ExpressionUUID->"ad8dae01-c499-544a-8fc2-5c1ee6bf0a77"],

Cell["closure/persistence scores,", "Item",ExpressionUUID->"8f08cc1e-75be-9d47-81f1-b2ce06cdf1fa"],

Cell["geometry-sensitive interfaces,", "Item",ExpressionUUID->"5c3ca995-cbea-7142-a4db-fd0e5e4851ea"],

Cell["recurrence-aware state stabilization.", "Item",ExpressionUUID->"b451dc45-32a1-2e46-8ad4-0f58351a2337"],

