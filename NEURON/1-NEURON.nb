Cell[CellGroupData[{

Cell["8. State-space design", "Section",ExpressionUUID->"d8f1d08f-d098-b64f-af00-c1d4ff406c14"],

Cell[TextData[{
 "A useful master state vector is: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["x", "TI"], 
