Cell[CellGroupData[{

Cell["7. Adaptation and burst dynamics", "Section",ExpressionUUID->"4659797d-719e-a34e-ab07-adfa183899ca"],

Cell[CellGroupData[{

Cell["7.1. Need for adaptation variables", "Subsection",ExpressionUUID->"948b8ea7-0f0d-e445-9a85-17047b918eca"],

Cell["Many neurons exhibit: ", "Text",ExpressionUUID->"8cb6c8b8-b189-6d41-8584-4dfa8b8b93a2"],

Cell["spike-frequency adaptation,", "Item",ExpressionUUID->"2b113351-fa30-7543-b1e7-bf4e57d498b9"],

Cell["rebound spiking,", "Item",ExpressionUUID->"2abaa0d6-11db-3246-85d9-b5d31fb40b35"],

Cell["bursting,", "Item",ExpressionUUID->"b63608ce-4281-4f44-a420-f5a3958e3d1b"],

Cell["slow recovery,", "Item",ExpressionUUID->"e285a840-19d7-9948-9c11-2dedc086a0f9"],

Cell["threshold modulation.", "Item",ExpressionUUID->"5f6d487f-6a65-c348-a3de-a26884a23efb"],

Cell["These require additional state variables. ", "Text",ExpressionUUID->"354b35b4-82f3-544d-a1e7-214375802c8f"]
}, Open  ]],

Cell[CellGroupData[{

Cell["7.2. Adaptive exponential integrate-and-fire form", "Subsection",ExpressionUUID->"e067bff8-e3e2-594e-acfb-18065e19a09a"],

Cell[TextData[{
 "A useful intermediate model is: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["C", "TI"], 
          StyleBox["m", "TI"]], 
         FractionBox[
          RowBox[{
            StyleBox["d", "TI"], 
            StyleBox["v", "TI"]}], 
          RowBox[{
            StyleBox["d", "TI"], 
            StyleBox["t", "TI"]}]], "\[LongEqual]", "-", 
         SubscriptBox[
          StyleBox["g", "TI"], 
          StyleBox["L", "TI"]], 
         RowBox[{"(", 
           RowBox[{
             StyleBox["v", "TI"], "-", 
             SubscriptBox[
              StyleBox["E", "TI"], 
              StyleBox["L", "TI"]]}], ")"}], "+", 
         SubscriptBox[
          StyleBox["g", "TI"], 
          StyleBox["L", "TI"]], 
         SubscriptBox["\[CapitalDelta]", 
          StyleBox["T", "TI"]], "exp", "\[NegativeThinSpace]", 
         RowBox[{"(", 
           FractionBox[
            RowBox[{
              StyleBox["v", "TI"], "-", 
              SubscriptBox[
               StyleBox["V", "TI"], 
               StyleBox["T", "TI"]]}], 
            SubscriptBox["\[CapitalDelta]", 
             StyleBox["T", "TI"]]], ")"}], "-", 
         StyleBox["w", "TI"], "+", 
         SubscriptBox[
          StyleBox["I", "TI"], "ext"], 
         RowBox[{"(", 
           StyleBox["t", "TI"], ")"}]}], TraditionalForm], "errors" -> {}, 
     "input" -> 
     "C_m \\frac{dv}{dt}\n=\n- g_L(v-E_L)\n+ g_L \\Delta_T \
\\exp\\!\\left(\\frac{v-V_T}{\\Delta_T}\\right)\n- w\n+ I_{\\text{ext}}(t)", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "1364c2f3-0dbf-4f4b-8f56-aae9ca086106"],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[Tau]", 
          StyleBox["w", "TI"]], 
         FractionBox[
          RowBox[{
            StyleBox["d", "TI"], 
            StyleBox["w", "TI"]}], 
          RowBox[{
            StyleBox["d", "TI"], 
            StyleBox["t", "TI"]}]], "\[LongEqual]", 
         StyleBox["a", "TI"], 
         RowBox[{"(", 
           RowBox[{
             StyleBox["v", "TI"], "-", 
             SubscriptBox[
              StyleBox["E", "TI"], 
              StyleBox["L", "TI"]]}], ")"}], "-", 
         StyleBox["w", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\tau_w \\frac{dw}{dt} = a(v-E_L) - w", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "8526d7e6-9c30-744e-a754-7e12df623f2f"],
 "where ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["w", "TI"], TraditionalForm], "errors" -> {}, "input" -> "w", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "249e2046-b56e-774a-8996-4a937ebfaf89"],
 " is an adaptation variable."
}], "Text",ExpressionUUID->"0bca6359-bd0a-5043-bd6b-8f9003dce51b"],

Cell["\<\
This model is often an excellent compromise between realism and efficiency. \
\>", "Text",ExpressionUUID->"4a76264c-16a1-4448-a2e0-a9153c50406c"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{0},
      "Spacer1"]},
    {
     TemplateBox[{0},
      "Spacer1"]}
   },
   AutoDelete->False,
   FrameStyle->Directive[
     LightDarkSwitched[
      GrayLevel[0.8], 
      GrayLevel[0.4867756]], 
     AbsoluteThickness[1]],
   GridBoxDividers->{
    "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
   GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Text", "MarkdownDelimiter",
 ShowStringCharacters->False,
 Background->None,ExpressionUUID->"8b2c1cad-5f1f-194a-8eb4-f4acd4517091"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["8. Spatial structure: cable theory", "Section",ExpressionUUID->"100ac686-d7b3-ee4b-8177-f1b3adab200e"],

Cell[CellGroupData[{

Cell["8.1. Why space matters", "Subsection",ExpressionUUID->"9b645fcd-8c50-fb46-8c07-3d177324e384"],

Cell["\<\
Real neurons are not point units. Dendrites and axons are spatially extended \
cable-like structures. \
\>", "Text",ExpressionUUID->"b25c5f89-6a05-b644-aaf9-1028fcd29deb"]
}, Open  ]],

Cell[CellGroupData[{

Cell["8.2. Cable equation", "Subsection",ExpressionUUID->"a367592d-a9d9-634c-ba15-d02fef5673c6"],

Cell[TextData[{
 "A standard passive cable equation is: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["c", "TI"], 
          StyleBox["m", "TI"]], 
         FractionBox[
          RowBox[{"\[PartialD]", 
            StyleBox["v", "TI"]}], 
          RowBox[{"\[PartialD]", 
            StyleBox["t", "TI"]}]], "\[LongEqual]", 
         FractionBox[
          StyleBox["a", "TI"], 
          RowBox[{"2", 
            SubscriptBox[
             StyleBox["r", "TI"], 
             StyleBox["i", "TI"]]}]], 
         FractionBox[
          RowBox[{
            SuperscriptBox["\[PartialD]", "2"], 
            StyleBox["v", "TI"]}], 
          RowBox[{"\[PartialD]", 
            SuperscriptBox[
             StyleBox["x", "TI"], "2"]}]], "-", 
         SubscriptBox[
          StyleBox["g", "TI"], 
          StyleBox["m", "TI"]], 
         RowBox[{"(", 
           RowBox[{
             StyleBox["v", "TI"], "-", 
             SubscriptBox[
              StyleBox["E", "TI"], 
              StyleBox["L", "TI"]]}], ")"}], "+", 
         SubscriptBox[
          StyleBox["i", "TI"], "ext"], 
         RowBox[{"(", 
           RowBox[{
             StyleBox["x", "TI"], ",", 
             StyleBox["t", "TI"]}], ")"}]}], TraditionalForm], "errors" -> {},
      "input" -> 
     "c_m \\frac{\\partial v}{\\partial t}\n=\n\\frac{a}{2r_i} \
\\frac{\\partial^2 v}{\\partial x^2}\n- g_m(v-E_L)\n+ i_{\\text{ext}}(x,t)", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "14f11954-8c27-8949-94e9-902e71a32b5c"],
 "where: "
}], "Text",ExpressionUUID->"3c6e5f90-7421-434c-97dd-cb1dfad29b55"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["a", "TI"], TraditionalForm], "errors" -> {}, "input" -> "a", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "7d7c4171-21b6-8a4b-aa6a-6b77dad139f6"],
 " = cable radius,"
}], "Item",ExpressionUUID->"c92530f6-15de-f342-b3e6-d1f7588678b9"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["r", "TI"], 
        StyleBox["i", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "r_i", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "a61ff578-d714-ab4e-98d1-ff5799610f88"],
 " = axial resistivity,"
}], "Item",ExpressionUUID->"9d23c327-17c2-374a-9e2c-adddb4ff8f96"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["c", "TI"], 
        StyleBox["m", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "c_m", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "3009c369-f487-c342-957c-f40a21e93d3b"],
 " = membrane capacitance per unit length,"
}], "Item",ExpressionUUID->"67624437-8a19-3e44-9584-901a38e898de"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["g", "TI"], 
        StyleBox["m", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "g_m", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f1cc6106-aec3-3d44-bdec-64a32f2e28aa"],
 " = membrane conductance per unit length."
}], "Item",ExpressionUUID->"62d3df90-d83c-6944-9c76-9ada9828205b"]
}, Open  ]],

Cell[CellGroupData[{

Cell["8.3. Active cable models", "Subsection",ExpressionUUID->"a35f7450-a3e3-5c46-8a1b-63f5e17fe909"],

Cell[TextData[{
 "In active dendrites, the cable equation gains conductance-based channel \
terms: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["c", "TI"], 
          StyleBox["m", "TI"]], 
         FractionBox[
          RowBox[{"\[PartialD]", 
            StyleBox["v", "TI"]}], 
          RowBox[{"\[PartialD]", 
            StyleBox["t", "TI"]}]], "\[LongEqual]", 
         FractionBox[
          StyleBox["a", "TI"], 
          RowBox[{"2", 
            SubscriptBox[
             StyleBox["r", "TI"], 
             StyleBox["i", "TI"]]}]], 
         FractionBox[
          RowBox[{
            SuperscriptBox["\[PartialD]", "2"], 
            StyleBox["v", "TI"]}], 
          RowBox[{"\[PartialD]", 
            SuperscriptBox[
             StyleBox["x", "TI"], "2"]}]], "-", 
         UnderscriptBox["\[Sum]", 
          StyleBox["k", "TI"], LimitsPositioning -> True], 
         SubscriptBox[
          StyleBox["i", "TI"], 
          StyleBox["k", "TI"]], 
         RowBox[{"(", 
           RowBox[{
             StyleBox["v", "TI"], ",", 
             StyleBox["g", "TI"], ",", 
             StyleBox["x", "TI"], ",", 
             StyleBox["t", "TI"]}], ")"}], "+", 
         SubscriptBox[
          StyleBox["i", "TI"], "syn"], 
         RowBox[{"(", 
           RowBox[{
             StyleBox["x", "TI"], ",", 
             StyleBox["t", "TI"]}], ")"}], "+", 
         SubscriptBox[
          StyleBox["i", "TI"], "ext"], 
         RowBox[{"(", 
           RowBox[{
             StyleBox["x", "TI"], ",", 
             StyleBox["t", "TI"]}], ")"}]}], TraditionalForm], "errors" -> {},
      "input" -> 
     "c_m \\frac{\\partial v}{\\partial t}\n=\n\\frac{a}{2r_i} \
\\frac{\\partial^2 v}{\\partial x^2}\n- \\sum_k i_k(v,g,x,t)\n+ \
i_{\\text{syn}}(x,t)\n+ i_{\\text{ext}}(x,t)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "a1b6cce9-7726-4941-aa2c-85df179cb28c"],
 "This is essential for dendritic computation. "
}], "Text",ExpressionUUID->"8d7eed6a-2ab7-b746-8355-70ecd0b0b954"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{0},
