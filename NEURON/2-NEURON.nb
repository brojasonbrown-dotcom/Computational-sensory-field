Cell[CellGroupData[{

Cell["15.2. Measurement state variables", "Subsection",ExpressionUUID->"f94c9dc0-e763-3f4b-a0e9-fccf1a4b28cd"],

Cell["A neuron may later be augmented with variables such as: ", "Text",ExpressionUUID->"919cd4d1-4c59-9f4d-b4af-e5e5332df764"],

Cell["effective scale band,", "Item",ExpressionUUID->"ea99aaee-af85-bf4d-8cd5-a827cfe40dc0"],

Cell["phase coherence proxy,", "Item",ExpressionUUID->"7b9d217d-dd28-0441-9e07-46c5a5b5e7b1"],

Cell["recurrence score,", "Item",ExpressionUUID->"6f4f292f-ee91-7d41-8e13-316cf5da185a"],

Cell["history trace,", "Item",ExpressionUUID->"66bef097-1219-7746-b407-5804bcb32dea"],

Cell["geometry descriptor.", "Item",ExpressionUUID->"0b94d6cc-670b-3c46-b7cf-cd31e17254b7"],

Cell["\<\
These are not part of the classical membrane equations, but they can be \
attached as auxiliary state variables. \
\>", "Text",ExpressionUUID->"f928663b-4a4b-6f47-9eb0-d18c9e48fe9d"]
}, Open  ]],

Cell[CellGroupData[{

Cell["15.3. Closure variables", "Subsection",ExpressionUUID->"ef42c37a-a47c-744c-8617-1512e48cc785"],

Cell["\<\
Recurrence and persistence can be tracked by functionals of the trajectory, \
such as: \
\>", "Text",ExpressionUUID->"54023692-e568-d441-b75b-9579a4bb8684"],

Cell["return-to-attractor distance,", "Item",ExpressionUUID->"911d831d-4c00-9240-9e35-1aa5c2206d98"],

Cell["cycle consistency,", "Item",ExpressionUUID->"38ca7ddf-3718-ec4a-b083-0d840bdfa0d3"],

Cell["hysteresis,", "Item",ExpressionUUID->"87b8e368-d7f4-8840-bc49-c8fa991bdb89"],

Cell["history sensitivity.", "Item",ExpressionUUID->"e258a260-6cab-ea44-ac72-122ba5c79019"],

Cell["These become useful in later AI and RHUFT extensions. ", "Text",ExpressionUUID->"a12ec51f-c9d3-5c40-966b-f1615785dc7d"],

