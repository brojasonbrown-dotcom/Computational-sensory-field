Cell[CellGroupData[{

Cell["17. What this notebook establishes", "Section",ExpressionUUID->"a175f100-fa28-6b4f-b33a-d3db957f66ba"],

Cell["\<\
This notebook establishes the neuron as an adaptive signaling system, not \
just a membrane.\
\>", "Text",ExpressionUUID->"2e255d0f-8df8-804d-ab61-456abf109a64"],

Cell["Its main achievements are:", "Text",ExpressionUUID->"5674265d-8aa1-7d40-a630-90ba90abafd8"],

Cell["\<\
1. formalizing synaptic currents as dynamical conductance processes,\
\>", "Text",ExpressionUUID->"d7b08cde-99b1-cd42-ab97-e7e83caad63b"],

Cell["2. distinguishing receptor classes and timing structure,", "Text",ExpressionUUID->"65b5dcb4-5a45-1b44-81aa-339299ddd68f"],

Cell["\<\
3. developing short-term and long-term plasticity mathematics,\
\>", "Text",ExpressionUUID->"0732f8b0-fad9-c24f-8d77-61a65d577462"],

Cell["4. introducing modulatory and structural adaptation,", "Text",ExpressionUUID->"8a42bdc5-04e6-b34a-8697-17512c1e8184"],

Cell["5. incorporating glia and tripartite synapse thinking,", "Text",ExpressionUUID->"43d4e662-32e3-f04b-ae5e-a2ed51f3a0a9"],

Cell["6. building the bridge to digital trainable approximations,", "Text",ExpressionUUID->"b015209d-9c1b-6a48-90c6-b9115e683fdc"],

Cell["\<\
7. identifying where RHUFT-style measurement and closure variables may later \
augment the theory.\
\>", "Text",ExpressionUUID->"ee13272c-5e28-354f-aae5-02937ec8f284"],

Cell["This is the correct next layer of rigor. ", "Text",ExpressionUUID->"388fc793-b01e-9844-965f-b318f46203b9"],

