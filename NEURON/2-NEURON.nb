   "5e74b184-00fb-4b4d-a655-7d2ea9d849eb"]
 }], "InlineItem",ExpressionUUID->"3052063b-7d7d-e549-8968-3d486ec3e47b"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
