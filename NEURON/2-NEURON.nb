 }], "InlineItem",ExpressionUUID->"9ccdcaf3-3912-6944-9e21-5dca668a2c2c"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
