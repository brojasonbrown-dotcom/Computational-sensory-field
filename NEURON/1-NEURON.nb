Cell[CellGroupData[{

Cell["12. Multiscale sensing and embodiment", "Section",ExpressionUUID->"23302c76-e7b5-3841-8227-161c0816710b"],

Cell["\<\
Your target architecture explicitly aims to bring neural nets closer to life \
by deep sensory and cross-scale measurement. \
\>", "Text",ExpressionUUID->"818a2ec8-b941-6841-a8c3-4f5ed4adf158"],

Cell[CellGroupData[{

Cell["12.1. Therefore the neuron cannot remain disembodied", "Subsection",ExpressionUUID->"9ffa98e1-f349-3941-8ae3-ff873ed68ce3"],

Cell["\<\
At least in the broader architecture, neurons must be connected to: \
\>", "Text",ExpressionUUID->"dd5173d6-62ce-5c4f-b650-a9b01e2ade56"],

Cell["sensory channels,", "Item",ExpressionUUID->"31fcb8b5-dbe5-7a47-9bd4-b71bb75603de"],

Cell["temporal context,", "Item",ExpressionUUID->"c872e9a1-c461-9d42-963d-842408f66849"],

Cell["environment state,", "Item",ExpressionUUID->"88e63af2-e530-c34a-a1e9-8912978d96b9"],

Cell["active feedback or action loops.", "Item",ExpressionUUID->"2806c877-a9ff-2949-8e35-2c8d80825c83"]
}, Open  ]],

Cell[CellGroupData[{

Cell["12.2. Implication for modeling", "Subsection",ExpressionUUID->"a85c1e49-391d-f24d-a5bc-934399c63575"],

Cell["The neuron series must eventually include: ", "Text",ExpressionUUID->"73446bda-2a19-c841-a41d-280411859e7e"],

Cell["multimodal input fusion,", "Item",ExpressionUUID->"dc83b1f4-5c16-4e47-921c-886604f6d7e1"],

Cell["asynchronous event handling,", "Item",ExpressionUUID->"afbfd7b8-b746-354d-95de-f824212782b3"],

Cell["hierarchical timescales,", "Item",ExpressionUUID->"02a3c578-a83d-e142-a79e-f2da7c1f302d"],

Cell["local memory and global context,", "Item",ExpressionUUID->"926d2d2f-6d3e-9840-acce-e60957756fd8"],

Cell["geometry-aware sensor placement.", "Item",ExpressionUUID->"d786e251-2d1f-2049-986a-3a0f0b530d9c"],

