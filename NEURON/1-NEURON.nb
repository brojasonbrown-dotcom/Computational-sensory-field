 Background->None,ExpressionUUID->"80830ebe-a843-064d-8b97-3569c0d41de9"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["7. Core mathematical object", "Section",ExpressionUUID->"89f5389e-78f0-f643-9a34-92ac28056176"],

Cell["\<\
The project requires a neuron state operator rather than a single static \
equation. \
\>", "Text",ExpressionUUID->"e400d7aa-6e38-ac4a-8fde-8b387dcaf970"],

Cell[CellGroupData[{

Cell["7.1. Discrete-time master form", "Subsection",ExpressionUUID->"280ddca5-cb37-1047-9471-6e3126abe482"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["x", "TI"], 
          RowBox[{
            StyleBox["t", "TI"], "+", "1"}]], "\[LongEqual]", 
         StyleBox["N", "TI"], 
         RowBox[{"(", 
           RowBox[{
             SubscriptBox[
              StyleBox["x", "TI"], 
              StyleBox["t", "TI"]], ",", 
             SubscriptBox[
              StyleBox["u", "TI"], 
              StyleBox["t", "TI"]], ",", 
             SubscriptBox[
              StyleBox["e", "TI"], 
              StyleBox["t", "TI"]], ",", 
             SubscriptBox["\[Theta]", 
              StyleBox["t", "TI"]], ",", 
             SubscriptBox["\[Mu]", 
              StyleBox["t", "TI"]]}], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "x_{t+1} = \\mathcal{N}(x_t, u_t, e_t, \\theta_t, \\mu_t)", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "cb642d44-ec2d-d84e-bc57-db2c49e19d25"],
 "where: "
}], "Text",ExpressionUUID->"a1bd9e03-dba3-9f4c-acf8-bb04da7dd8e5"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["x", "TI"], 
        StyleBox["t", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "x_t", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "b2e73a7b-2886-1145-9768-252a8568d010"],
 " = internal neuron state,"
}], "Item",ExpressionUUID->"50221df9-9be0-7641-9a83-75263222d77e"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["u", "TI"], 
        StyleBox["t", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "u_t", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "be8b0390-55c4-a047-affa-81ca40b2217b"],
 " = incoming signals,"
}], "Item",ExpressionUUID->"58116e46-0a20-f848-b22c-69da4adc61b1"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["e", "TI"], 
        StyleBox["t", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "e_t", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "2d58d713-35c2-4f40-85cc-08683d2afeac"],
 " = embodied or environmental context,"
}], "Item",ExpressionUUID->"1c590efa-1e02-1d49-a613-6548597f748c"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox["\[Theta]", 
        StyleBox["t", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "\\theta_t", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "2e905388-670a-c242-9fe7-9117a89a7015"],
 " = trainable or adaptive parameters,"
}], "Item",ExpressionUUID->"1c584b09-8e99-7e4b-9e3b-95d3c1526556"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox["\[Mu]", 
        StyleBox["t", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "\\mu_t", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "082e8394-b9c3-2a49-8aaf-68ca48d8bd52"],
 " = measurement-state variables."
}], "Item",ExpressionUUID->"3adf9e9e-c520-364e-a746-e5d849dcd9ef"]
}, Open  ]],

Cell[CellGroupData[{

Cell["7.2. Continuous-time master form", "Subsection",ExpressionUUID->"5b6b67b3-08e7-2d40-a960-1d61414d4cbb"],

Cell[TextData[Cell[BoxData[
 FormBox[
  TemplateBox[<|"boxes" -> FormBox[
      RowBox[{
        FractionBox[
         RowBox[{
           StyleBox["d", "TI"], 
           StyleBox["x", "TI"]}], 
         RowBox[{
           StyleBox["d", "TI"], 
           StyleBox["t", "TI"]}]], "\[LongEqual]", 
        StyleBox["F", "TI"], 
        RowBox[{"(", 
          RowBox[{
            StyleBox["x", "TI"], ",", 
            StyleBox["u", "TI"], ",", 
            StyleBox["e", "TI"], ",", "\[Theta]", ",", "\[Mu]"}], ")"}]}], 
      TraditionalForm], "errors" -> {}, "input" -> 
    "\\frac{dx}{dt} = F(x,u,e,\\theta,\\mu)", "state" -> "Boxes"|>,
   "TeXAssistantTemplate"], 
  TraditionalForm]],ExpressionUUID->"bf1e2f54-cc08-1a47-90d7-b9d2900aea73"]], \
"Text",ExpressionUUID->"7e9d85c7-5e04-7f47-a72b-1678a5222424"]
}, Open  ]],

Cell[CellGroupData[{

Cell["7.3. Measurement update", "Subsection",ExpressionUUID->"d589ce8f-54d3-6d49-89bb-ea4b01a7dba4"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[Mu]", 
          RowBox[{
            StyleBox["t", "TI"], "+", "1"}]], "\[LongEqual]", 
         StyleBox["M", "TI"], 
         RowBox[{"(", 
           RowBox[{
             SubscriptBox[
              StyleBox["x", "TI"], 
              StyleBox["t", "TI"]], ",", 
             SubscriptBox[
              StyleBox["u", "TI"], 
              StyleBox["t", "TI"]], ",", 
             SubscriptBox[
              StyleBox["e", "TI"], 
              StyleBox["t", "TI"]], ",", 
             SubscriptBox[
              StyleBox["h", "TI"], 
              StyleBox["t", "TI"]], ",", 
             SubscriptBox[
              StyleBox["g", "TI"], 
              StyleBox["t", "TI"]]}], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\mu_{t+1} = \\mathcal{M}(x_t,u_t,e_t,h_t,g_t)", "state" -> "Boxes"|>,
