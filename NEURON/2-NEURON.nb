                RowBox[{"[", "1", "]"}], "]"}], ",", 
               RowBox[{"yrange", "[", 
                RowBox[{"[", "2", "]"}], "]"}]}], "}"}], ",", 
             "\[IndentingNewLine]", "       ", 
             RowBox[{"PlotLabel", "->", "\"\<Scalar curl\>\""}]}], 
            "\[IndentingNewLine]", "     ", "]"}]}], "\[IndentingNewLine]", 
          "   ", "}"}], "}"}], "]"}]}]}], "\[IndentingNewLine]", "]"}]}], 
   ";"}]}], "Input",ExpressionUUID->"63668b0f-5360-8746-8717-61dc9d8e0427"],
 "\n14.5 PDE mode visualization\n",
 Cell[BoxData[{
  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", 
     RowBox[{"plotOneDModes", ",", "plotCircularModes"}], "]"}], ";"}], 
   "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"plotOneDModes", "[", 
      RowBox[{"n_Integer", ":", " ", "4"}], "]"}], ":=", 
     RowBox[{"Module", "[", "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"vals", ",", "funs"}], "}"}], ",", "\[IndentingNewLine]", 
       "  ", 
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{"vals", ",", "funs"}], "}"}], "=", 
         RowBox[{"oneDPDEEigensystem", "[", "n", "]"}]}], ";", 
        "\[IndentingNewLine]", "  ", 
        RowBox[{"Column", "[", "\[IndentingNewLine]", "    ", 
         RowBox[{"MapIndexed", "[", "\[IndentingNewLine]", "      ", 
          RowBox[{
           RowBox[{
            RowBox[{"Plot", "[", 
             RowBox[{
              RowBox[{"Evaluate", "[", 
               RowBox[{
                RowBox[{"funs", "[", 
                 RowBox[{"[", 
                  RowBox[{"First", "[", "#2", "]"}], "]"}], "]"}], "[", "x", 
                "]"}], "]"}], ",", 
              RowBox[{"{", 
               RowBox[{"x", ",", "0", ",", "1"}], "}"}], ",", 
              RowBox[{"Frame", "->", "True"}], ",", 
              RowBox[{"PlotLabel", "->", 
               RowBox[{"Row", "[", 
                RowBox[{"{", 
                 RowBox[{"\"\<Mode \>\"", ",", 
                  RowBox[{"First", "[", "#2", "]"}], 
                  ",", "\"\<, \[Lambda] = \>\"", ",", 
                  RowBox[{"vals", "[", 
                   RowBox[{"[", 
                    RowBox[{"First", "[", "#2", "]"}], "]"}], "]"}]}], "}"}], 
                "]"}]}]}], "]"}], " ", "&"}], ",", "\[IndentingNewLine]", 
           "      ", "funs"}], "\[IndentingNewLine]", "    ", "]"}], 
         "\[IndentingNewLine]", "  ", "]"}]}]}], "\[IndentingNewLine]", 
      "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"plotCircularModes", "[", 
     RowBox[{"n_Integer", ":", " ", "4"}], "]"}], ":=", 
    RowBox[{"Module", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"vals", ",", "funs"}], "}"}], ",", "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{"vals", ",", "funs"}], "}"}], "=", 
        RowBox[{"circularModes", "[", "n", "]"}]}], ";", 
       "\[IndentingNewLine]", "  ", 
       RowBox[{"Column", "[", "\[IndentingNewLine]", "    ", 
        RowBox[{"MapIndexed", "[", "\[IndentingNewLine]", "      ", 
         RowBox[{
          RowBox[{
           RowBox[{"DensityPlot", "[", "\[IndentingNewLine]", "        ", 
            RowBox[{
             RowBox[{"Evaluate", "[", 
              RowBox[{
               RowBox[{"funs", "[", 
                RowBox[{"[", 
                 RowBox[{"First", "[", "#2", "]"}], "]"}], "]"}], "[", 
               RowBox[{"x", ",", "y"}], "]"}], "]"}], ",", 
             "\[IndentingNewLine]", "        ", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"x", ",", "y"}], "}"}], " ", "\[Element]", " ", 
              "circularRegion"}], ",", "\[IndentingNewLine]", "        ", 
             RowBox[{"PlotPoints", "->", "50"}], ",", "\[IndentingNewLine]", 
             "        ", 
             RowBox[{"Frame", "->", "True"}], ",", "\[IndentingNewLine]", 
             "        ", 
             RowBox[{"PlotLabel", "->", 
              RowBox[{"Row", "[", 
               RowBox[{"{", 
                RowBox[{"\"\<Mode \>\"", ",", 
                 RowBox[{"First", "[", "#2", "]"}], 
                 ",", "\"\<, \[Lambda] = \>\"", ",", 
                 RowBox[{"vals", "[", 
                  RowBox[{"[", 
                   RowBox[{"First", "[", "#2", "]"}], "]"}], "]"}]}], "}"}], 
               "]"}]}]}], "\[IndentingNewLine]", "      ", "]"}], " ", "&"}], 
          ",", "\[IndentingNewLine]", "      ", "funs"}], 
         "\[IndentingNewLine]", "    ", "]"}], "\[IndentingNewLine]", "  ", 
        "]"}]}]}], "\[IndentingNewLine]", "]"}]}], ";"}]}], "Input",
  ExpressionUUID->"1064ddec-3a13-be4b-a6ba-eacb145cd322"],
