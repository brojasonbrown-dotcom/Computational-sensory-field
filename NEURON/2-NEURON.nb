 "\n15. Example workflow\n",
 Cell[BoxData[{
  RowBox[{
   RowBox[{"exampleMatrix", "=", 
    RowBox[{"dampedLaplacian1D", "[", 
     RowBox[{"12", ",", "0.4"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"exampleState", "=", 
    RowBox[{"Normalize", "[", 
     RowBox[{
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"1.", "/", 
         RowBox[{"Sqrt", "[", "i", "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "1", ",", "64"}], "}"}]}], "]"}], ",", "Norm"}], 
     "]"}]}], ";"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"exampleDensity", "=", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1.", ",", "0.8"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0.8", ",", "1."}], "}"}]}], "}"}], "/", "2"}]}], ";"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"examplePhases", "=", 
     RowBox[{"quasiPeriodicSchedule", "[", 
      RowBox[{"30", ",", "2"}], "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"exampleSources", "=", 
     RowBox[{"{", "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "1.5"}], ",", "0.0"}], "}"}], ",", "1.0", ",", 
         "1.2"}], "}"}], ",", "\[IndentingNewLine]", "  ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"1.0", ",", "0.8"}], "}"}], ",", "0.8", ",", "0.9"}], "}"}],
        ",", "\[IndentingNewLine]", "  ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0.5", ",", 
           RowBox[{"-", "1.2"}]}], "}"}], ",", "0.6", ",", "1.1"}], "}"}]}], 
      "\[IndentingNewLine]", "}"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"examplePotential", "=", 
    RowBox[{"sourceFieldPotential", "[", "exampleSources", "]"}]}], ";"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"exampleField", "=", 
     RowBox[{
      RowBox[{"effectiveForce2D", "[", 
       RowBox[{"examplePotential", ",", "0.35"}], "]"}], "[", 
      RowBox[{"x", ",", "y"}], "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"exampleReport", "=", 
     RowBox[{"multiscaleResonanceReport", "[", "\[IndentingNewLine]", "  ", 
      RowBox[{
      "exampleMatrix", ",", "\[IndentingNewLine]", "  ", "exampleState", ",", 
       "\[IndentingNewLine]", "  ", "exampleDensity", ",", 
       "\[IndentingNewLine]", "  ", "examplePhases", ",", 
       "\[IndentingNewLine]", "  ", "0.15", ",", "\[IndentingNewLine]", "  ", 
       "5", ",", "\[IndentingNewLine]", "  ", 
       RowBox[{"10", "^", 
        RowBox[{"-", "6"}]}]}], "\[IndentingNewLine]", "]"}]}], ";"}], 
   "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
  RowBox[{"exampleReport", "[", "\"\<Verdict\>\"", "]"}]}], "Input",
  ExpressionUUID->"d8a0615a-be56-b141-b79e-fb4fa98b6219"],
