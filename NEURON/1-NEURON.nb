 ShowStringCharacters->False,
 Background->None,ExpressionUUID->"4ed2cc0f-abbb-1c47-962a-6b1330a210b9"]
}, Open  ]],

Cell[CellGroupData[{

Cell["1. Executive objective", "Section",ExpressionUUID->"690c3273-ef84-7641-9bde-9fc04138518f"],

Cell["\<\
The project objective is not merely to write a better neuron equation.\
\>", "Text",ExpressionUUID->"71665c29-8c96-1442-acf5-10cd51cbe89d"],

Cell[TextData[{
 "It is to construct a ",
 StyleBox["full mathematical design stack",
  FontWeight->Bold],
 " for an advanced neuron model that can serve simultaneously as: "
}], "Text",ExpressionUUID->"7a6f0bf1-b599-8b4e-afeb-681554943ef1"],

Cell["a neuroscience-grounded formal object,", "Item",ExpressionUUID->"22af00f0-6161-3e46-834a-ec0df46cb3db"],

Cell["a digital computational primitive,", "Item",ExpressionUUID->"61bda3bd-8d53-d846-a537-3cb545534c87"],

Cell["a multiscale measurement unit,", "Item",ExpressionUUID->"0fbff2bd-d470-b649-a6a6-daac1bdac016"],

Cell["a possible substrate for richer AI architectures,", "Item",ExpressionUUID->"202c2153-7b98-7e40-bca6-2ca443d52051"],

Cell["\<\
a framework into which RHUFT-style closure and self-measurement ideas can be \
inserted in a disciplined way.\
\>", "Item",ExpressionUUID->"80ef039b-681d-9946-ac20-8f906decd695"],

Cell[TextData[{
 "A concise formal target is: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"Build ", 
         StyleBox["N", "TI"], " such that ", 
         StyleBox["N", "TI"], 
         " is biologically informed, computationally trainable, multiscale \
measurable, and structurally extensible."}], TraditionalForm], "errors" -> {},
      "input" -> 
     "\\text{Build } \\mathcal{N} \\text{ such that } \\mathcal{N} \\text{ is \
biologically informed, computationally trainable, multiscale measurable, and \
structurally extensible.}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "699a17b6-0727-7346-9f54-40f11a61a239"]
}], "Text",ExpressionUUID->"cfa19739-1a1d-b443-9128-07def2c26e88"],

