 Background->None,ExpressionUUID->"fafe25c4-a0bb-874f-869a-32c21a2fd5a3"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["9. Compartmental models", "Section",ExpressionUUID->"31ec892b-a33e-7742-91af-888aa09f3ac5"],

Cell[CellGroupData[{

Cell["9.1. Discretization of morphology", "Subsection",ExpressionUUID->"d57bfdff-403f-9441-9430-4c3451a344f0"],

Cell["\<\
A common practical strategy is to divide the neuron into compartments \
connected by axial conductances.\
\>", "Text",ExpressionUUID->"5a06fb9b-775e-b349-801d-65d67a7d2c79"],

Cell[TextData[{
 "For compartment ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["i", "TI"], TraditionalForm], "errors" -> {}, "input" -> "i", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "88adf389-cd30-f74c-9671-01b8b1eb1c47"],
 ": ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["C", "TI"], 
          StyleBox["i", "TI"]], 
         FractionBox[
          RowBox[{
            StyleBox["d", "TI"], 
            SubscriptBox[
             StyleBox["v", "TI"], 
             StyleBox["i", "TI"]]}], 
          RowBox[{
            StyleBox["d", "TI"], 
            StyleBox["t", "TI"]}]], "\[LongEqual]", "-", 
         SubscriptBox[
          StyleBox["I", "TI"], 
          RowBox[{"ion", ",", 
            StyleBox["i", "TI"]}]], "-", 
         UnderscriptBox["\[Sum]", 
          RowBox[{
            StyleBox["j", "TI"], "\[Element]", 
            StyleBox["N", "TI"], 
            RowBox[{"(", 
              StyleBox["i", "TI"], ")"}]}], LimitsPositioning -> True], 
         SubscriptBox[
          StyleBox["g", "TI"], 
          RowBox[{
            StyleBox["i", "TI"], 
            StyleBox["j", "TI"]}]], 
         RowBox[{"(", 
           RowBox[{
             SubscriptBox[
              StyleBox["v", "TI"], 
              StyleBox["i", "TI"]], "-", 
             SubscriptBox[
              StyleBox["v", "TI"], 
              StyleBox["j", "TI"]]}], ")"}], "+", 
         SubscriptBox[
          StyleBox["I", "TI"], 
          RowBox[{"syn", ",", 
            StyleBox["i", "TI"]}]], "+", 
         SubscriptBox[
          StyleBox["I", "TI"], 
          RowBox[{"ext", ",", 
            StyleBox["i", "TI"]}]]}], TraditionalForm], "errors" -> {}, 
     "input" -> 
     "C_i \\frac{dv_i}{dt}\n=\n- I_{\\text{ion},i}\n- \\sum_{j \\in \
\\mathcal{N}(i)} g_{ij}(v_i-v_j)\n+ I_{\\text{syn},i}\n+ I_{\\text{ext},i}", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "e0ad9f2d-3f66-b441-907a-e0eb41548da9"],
 "This reduces PDE cable models to coupled ODE systems. "
}], "Text",ExpressionUUID->"2fdb0d82-03d9-d64c-bcee-3e2f358ed44e"]
}, Open  ]],

Cell[CellGroupData[{

Cell["9.2. Why this matters for AI abstraction", "Subsection",ExpressionUUID->"887cc2d4-b0fb-224f-a6dc-582cd07c07c3"],

Cell["\<\
Co ... \:0bb5\:0bc7l, time_] := (alpha[voltage] (1 - #) - beta[voltage] #) & \
/@ gateState; \
\>", "Text",ExpressionUUID->"6adf7f53-f34e-834e-adab-79f88c126476"],

Cell["\<\
This is only a schematic starting point.

### 20.2. Compartmental coupling scaffold\
\>", "Program",ExpressionUUID->"7e3423b5-c2a1-e247-a2a9-43061aa9436e"],

Cell["wl", "Text",ExpressionUUID->"c0164d7d-5b85-f842-9288-db4d7994e9e0"],

Cell["ClearAll[compartmentStep];", "Text",ExpressionUUID->"e4d111b0-e0a7-9f48-9500-f3ef04b46a17"],

Cell[TextData[{
 "compartmentStep[voltages",
 StyleBox[", axialMatrix",
  FontSlant->Italic],
 ", ionicCurrents",
 StyleBox[", synapticCurrents",
  FontSlant->Italic],
 ", externalCurrents",
 StyleBox[", capacitances",
  FontSlant->Italic],
 "] :="
}], "Text",ExpressionUUID->"124c2673-9aa7-1a4e-8532-91017a13de75"],

Cell["  MapThread[", "Text",ExpressionUUID->"6d6b37f0-19f2-264f-b8cd-27bd21b21c44"],

Cell["    (#6^-1 (-#3 - #2 + #4 + #5)) &,", "Text",ExpressionUUID->"996c17bc-fc5c-8a47-af50-55f590aae231"],

Cell["    {", "Text",ExpressionUUID->"f52dd0e6-4e6d-b242-8b4d-e4fe3312918d"],

Cell["      voltages,", "Text",ExpressionUUID->"c827cddb-e84f-5348-b81e-b78e000da286"],

Cell["      axialMatrix . voltages,", "Text",ExpressionUUID->"392215c8-ed32-3942-a5af-a45cfe93fd26"],

Cell["      ionicCurrents,", "Text",ExpressionUUID->"c4621668-8e13-1b42-940b-ef0ac6550448"],

Cell["      synapticCurrents,", "Text",ExpressionUUID->"df2c9f35-7b37-3d48-aa4d-a33dc7e00e97"],

Cell["      externalCurrents,", "Text",ExpressionUUID->"3b4aa8bf-a7bc-5e4c-8f16-df63928b4ddd"],

Cell["      capacitances", "Text",ExpressionUUID->"5b3f015a-35a8-ad4c-93b1-679144a210d1"],

Cell["    }", "Text",ExpressionUUID->"f096bafe-7d77-2a4b-9d1a-0eb94d1cd684"],

Cell["  ]; ", "Text",ExpressionUUID->"777e1004-aaf9-6f48-8474-ae67228e5c01"],

Cell["### 20.3. Measurement-state scaffold", "Program",ExpressionUUID->"349d9730-f24b-264a-8158-815fddb28476"],

Cell["wl", "Text",ExpressionUUID->"6ffeb108-c5ce-5d43-8845-3ebc2deeed20"],

Cell["ClearAll[neuronMeasurementState];", "Text",ExpressionUUID->"6736df15-66e6-464d-83ef-d55a8d24028a"],

Cell[TextData[{
 "neuronMeasurementState[effectiveScale",
 StyleBox[", observability",
  FontSlant->Italic],
 ", phase",
 StyleBox[", history",
  FontSlant->Italic],
 ", closure_] := <|"
}], "Text",ExpressionUUID->"da113c30-42f5-c94d-b05f-ea32580a5a68"],

Cell["  \"EffectiveScale\" -> effectiveScale,", "Text",ExpressionUUID->"456a5498-395a-ac4d-8fea-ea04f810f43c"],

Cell["  \"ObservabilityProxy\" -> observability,", "Text",ExpressionUUID->"2d19143c-b20d-5443-a8e1-d09a637e4725"],

Cell["  \"PhaseProxy\" -> phase,", "Text",ExpressionUUID->"0ffcc9df-e877-7b42-9c28-7a95cda9d7ab"],

Cell["  \"HistoryTrace\" -> history,", "Text",ExpressionUUID->"62dabfc3-0361-8d4a-9d07-9bee137b486f"],

Cell["  \"ClosureProxy\" -> closure", "Text",ExpressionUUID->"f701afd4-db91-1b4e-822d-22821d5a5a7a"],

Cell["|>; ", "Text",ExpressionUUID->"a44d9bf5-f155-2a44-a193-34bf0024376b"],

Cell["\<\
---

## 21. What this notebook establishes

This notebook establishes the biophysical and state-space core of the neuron \
series.

Its main achievements are:

1. defining the neuron as a structured state-space system,
2. presenting the model ladder from reduced to rich forms,
3. introducing equivalent circuit, conductance, adaptation, cable, and \
compartment models,
4. distinguishing biological completeness from computational reduction,
5. opening a disciplined interface for measurement and RHUFT extensions.

It therefore provides the necessary mathematical substrate for all later \
neuron notebooks.

---

## 22. Next notebook

The next notebook should be:

**03_Synapses_Plasticity_And_Glia_Coupling**

It should develop:

- synaptic kinetics,
- receptor classes,
- stochastic transmission,
- short-term plasticity,
- long-term plasticity,
- tripartite synapse structure,
- glial modulation,
- network coupling laws.\
\>", "Program",ExpressionUUID->"f5dcbed6-4cfa-5143-b974-3e6b700df037"]
}, Open  ]]
}, Open  ]]
}, Open  ]]
},
