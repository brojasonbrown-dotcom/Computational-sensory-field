Out[4]= \n<|\"ActionDensity\" -> Log[\[Chi][x, y, z]]*\[Rho][x, y, z] + r[x, \
y, z]^2*\[Chi][x, y, z], \n \"EulerEquations\" -> {Log[\[Chi][x, y, z]] == 0, \
r[x, y, z]^2 + \[Rho][x, y, z]/\[Chi][x, y, z] == 0, \n   2*r[x, y, \
z]*\[Chi][x, y, z] == 0}, \"ClosedFormStationarySolutions\" -> \n  \
Reduce[{Log[\[Chi][x, y, z]] == 0, r[x, y, z]^2 + \[Rho][x, y, z]/\[Chi][x, \
y, z] == 0, \n    2*r[x, y, z]*\[Chi][x, y, z] == 0}, {\[Rho][x, y, z], \
\[Chi][x, y, z], r[x, y, z]}, \n   MaxExtraConditions -> All], \
\"MaintenanceEquation\" -> \n  \[CapitalGamma]*HoldForm[obs[t]] + \
Derivative[1][HoldForm][obs[t]]*Derivative[1][obs][t] == 0, \n \
\"PotentialStableFrequencyCondition\" -> \n  {{\[Omega] -> \
ConditionalExpression[((Complex[0, -1])*(-1 + (Complex[0, 2])*Pi*C[1]))/s, \n \
     Element[C[1], Integers] && s != 0]}}, \"MissingVariables\" -> {}, \n \
\"MeasurementKernel\" -> HoldForm[measurement[eigenbasis_] := \
