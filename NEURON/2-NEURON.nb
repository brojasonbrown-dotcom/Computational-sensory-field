Cell[CellGroupData[{

Cell["16. Wolfram Language scaffolding", "Section",ExpressionUUID->"5c49f1e4-f1d7-f143-b4dd-eb8efded05d3"],

Cell[CellGroupData[{

Cell["16.1. Basic state representation", "Subsection",ExpressionUUID->"638ff72d-781f-494b-ad8b-7f0bfe0bf6f0"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "biophysicalNeuronState", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"biophysicalNeuronState", "[", "\[IndentingNewLine]", "   ", 
    RowBox[{
    "voltage_", ",", "gateVector_", ",", "synapseVector_", ",", 
     "plasticityVector_", ",", "adaptation_", ",", "\[IndentingNewLine]", 
     "   ", "morphology_", ",", "output_"}], "]"}], ":=", 
   RowBox[{"<|", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"\"\<Voltage\>\"", "->", "voltage"}], ",", "\[IndentingNewLine]",
      "  ", 
     RowBox[{"\"\<GateVector\>\"", "->", "gateVector"}], ",", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"\"\<SynapseVector\>\"", "->", "synapseVector"}], ",", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"\"\<PlasticityVector\>\"", "->", "plasticityVector"}], ",", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"\"\<AdaptationState\>\"", "->", "adaptation"}], ",", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"\"\<MorphologyState\>\"", "->", "morphology"}], ",", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"\"\<OutputState\>\"", "->", "output"}]}], "\[IndentingNewLine]",
     "|>"}]}], ";"}]}], "Input",ExpressionUUID->"f230bdbd-dce4-b742-9e2c-\
d9c51741e87b"]
}, Open  ]],

Cell[CellGroupData[{

Cell["16.2. Passive membrane update skeleton", "Subsection",ExpressionUUID->"1742f817-b58e-8a40-882b-3c5f9ade7d50"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "passiveMembraneRhs", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"passiveMembraneRhs", "[", 
    RowBox[{
    "voltage_", ",", "inputCurrent_", ",", "capacitance_", ",", 
     "leakConductance_", ",", "leakReversal_"}], "]"}], ":=", 
   "\[IndentingNewLine]", "  ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"-", "leakConductance"}], " ", 
       RowBox[{"(", 
        RowBox[{"voltage", "-", "leakReversal"}], ")"}]}], "+", 
      "inputCurrent"}], ")"}], "/", "capacitance"}]}], ";"}]}], "Input",Expres\
sionUUID->"a7b51e39-3083-3046-a6d3-32b1ce3e43dc"]
}, Open  ]],

Cell[CellGroupData[{

Cell["16.3. Generic gate update", "Subsection",ExpressionUUID->"384921d7-13e5-4444-95af-4bd202466452"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "gateRhs", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"gateRhs", "[", 
    RowBox[{"q_", ",", "alpha_", ",", "beta_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"alpha", " ", 
     RowBox[{"(", 
      RowBox[{"1", "-", "q"}], ")"}]}], "-", 
    RowBox[{"beta", " ", "q"}]}]}], ";"}]}], "Input",ExpressionUUID->\
"88ba4318-2b67-744e-89aa-2f56b3fba095"]
}, Open  ]],

Cell[CellGroupData[{

Cell["16.4. HH-style current sum", "Subsection",ExpressionUUID->"e5f7d8b4-79d7-734a-9069-0a9e9a01fb42"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "ionicCurrent", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"ionicCurrent", "[", 
    RowBox[{
    "conductance_", ",", "activation_", ",", "voltage_", ",", "reversal_"}], 
    "]"}], ":=", "\[IndentingNewLine]", "  ", 
   RowBox[{"conductance", " ", "activation", " ", 
    RowBox[{"(", 
     RowBox[{"voltage", "-", "reversal"}], ")"}]}]}], ";"}]}], "Input",Express\
ionUUID->"28728e28-0ccc-1340-a9e2-f0c71d98e989"]
}, Open  ]],

Cell[CellGroupData[{

