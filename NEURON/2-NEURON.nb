}], "Text",ExpressionUUID->"f73c7080-99a5-1249-b532-ae9d6dce7e6c"],

Cell["It should develop: ", "Text",ExpressionUUID->"7c1defd9-443a-084c-95ee-0abf32aaa560"],

Cell["synaptic conductance models,", "Item",ExpressionUUID->"8a45787b-4324-0044-a275-18371f32c10a"],

Cell["receptor families,", "Item",ExpressionUUID->"448a1c5d-7bd5-e64b-b26b-02a6b5f63d37"],

Cell["short-term synaptic dynamics,", "Item",ExpressionUUID->"559e60b9-3bec-a44c-ba25-2f33f9d8a4a9"],

Cell["long-term plasticity,", "Item",ExpressionUUID->"8d7cda8e-1754-4a4c-b864-c0806e2c6456"],

Cell["STDP,", "Item",ExpressionUUID->"025a5164-48cd-d649-8be8-2f396471a77d"],

Cell["modulatory signaling,", "Item",ExpressionUUID->"16176d05-7019-f341-a746-34fd12445fd9"],

Cell["astrocyte/glia coupling,", "Item",ExpressionUUID->"f5da4f69-efdc-4b43-a19f-85eb2444e6e3"],

Cell["tripartite synapse mathematics,", "Item",ExpressionUUID->"b37fa89d-1d0d-b145-ba20-f344ad1e2ee3"],

