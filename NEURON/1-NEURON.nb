Cell[CellGroupData[{

Cell["15. On base-12 and geometric number systems", "Section",ExpressionUUID->"7663364b-9fa1-ec4c-8b73-c0a74bb4643a"],

Cell["\<\
The user suggested that geometric decimal spacings such as base-12-like \
schemes may help computation and multiscale stability. \
\>", "Text",ExpressionUUID->"bb4e0ba4-d4f0-c04c-abc5-c59cad660146"],

Cell[CellGroupData[{

Cell["15.1. Professional treatment", "Subsection",ExpressionUUID->"ee34ad91-e1d2-5e47-9807-970792b48249"],

Cell["\<\
This should not be inserted casually into the neuron equations. It should be \
treated as a separate research axis with rigorous questions: \
\>", "Text",ExpressionUUID->"ef1660bc-69d8-3d4c-8e12-c71140b8bf10"],

Cell["what computations are radix sensitive?", "Item",ExpressionUUID->"cfeea7a2-024b-e545-b09d-103312ee0d1e"],

Cell["what representations preserve symmetry better?", "Item",ExpressionUUID->"3d61c149-e5d9-0c49-8827-4adf81c0260e"],

Cell["do non-decimal encodings improve hierarchical partitioning?", "Item",ExpressionUUID->"a13bc851-0a18-e648-9e76-df22c1d73c91"],

Cell["\<\
does angular or factor-rich discretization improve routing or measurement?\
\>", "Item",ExpressionUUID->"a693ede1-91b4-b042-a16e-789b26a6b15d"]
}, Open  ]],

Cell[CellGroupData[{

Cell["15.2. Status", "Subsection",ExpressionUUID->"9aee9dee-4e90-414e-8e6b-fa7c76177f92"],

Cell["\<\
This is a valid research direction, but it should be isolated until \
formalized. It will likely deserve its own later notebook. \
\>", "Text",ExpressionUUID->"1de25593-c619-7447-aa2d-0e9d5a351eb2"],

