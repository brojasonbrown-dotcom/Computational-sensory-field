Cell[CellGroupData[{

Cell["9. Neuron function taxonomy", "Section",ExpressionUUID->"94ca4b7e-fdea-b64a-a60b-b11c5895d3ab"],

Cell["\<\
To design a truly broad neuron framework, function classes must be listed \
separately from morphological classes. \
\>", "Text",ExpressionUUID->"91bb903a-8b2f-814f-9930-79a484e12d1a"],

Cell[CellGroupData[{

Cell["9.1. Functional neuron classes", "Subsection",ExpressionUUID->"8df4c839-c1fe-5841-b5ac-f87ded710c37"],

Cell["Examples include: ", "Text",ExpressionUUID->"ac48b708-bc36-844c-9529-1c84447abe8b"],

Cell["integrator,", "Item",ExpressionUUID->"cb62b40e-ed83-a04c-aedf-fbfac1f2b4de"],

Cell["coincidence detector,", "Item",ExpressionUUID->"b5486795-42a9-b949-bd6f-3e5482ed87e8"],

Cell["oscillator,", "Item",ExpressionUUID->"18fe7672-365a-4e4c-9eca-4660a3b4f357"],

Cell["burst generator,", "Item",ExpressionUUID->"dd6c768a-1789-434f-a38c-bb09198d5043"],

Cell["relay neuron,", "Item",ExpressionUUID->"eeb3b9f2-f819-ce4b-acc8-9f8b0b3a2eda"],

Cell["gain controller,", "Item",ExpressionUUID->"df88a8de-c262-2e4e-ab25-54f49585680c"],

Cell["predictor,", "Item",ExpressionUUID->"0275f2e4-c2f9-0849-8519-4bec9e7230be"],

Cell["novelty detector,", "Item",ExpressionUUID->"ec39a13f-c015-194a-9b6d-acd8bcc34ac3"],

Cell["sparse coder,", "Item",ExpressionUUID->"0cd04398-0746-564d-9f9d-b09ffcc2b6d5"],

Cell["sequence memory cell,", "Item",ExpressionUUID->"65237a03-c12c-bd46-997e-4681bdc91314"],

Cell["modulatory controller.", "Item",ExpressionUUID->"9feb9e91-6583-7e43-a5ec-71940099ebf1"]
}, Open  ]],

Cell[CellGroupData[{

Cell["9.2. Biological cell classes to include later", "Subsection",ExpressionUUID->"969dd374-dfd4-8e4d-a449-18427b5c9f5f"],

Cell["Examples include: ", "Text",ExpressionUUID->"66860c64-ebc9-9942-935c-ce6a728040a8"],

Cell["pyramidal neurons,", "Item",ExpressionUUID->"334ab273-da98-b84e-aa0a-4c6cfdbd5295"],

Cell["Purkinje cells,", "Item",ExpressionUUID->"d953a74b-2cb0-e84e-8d50-6e4c7140e5d5"],

Cell["granule cells,", "Item",ExpressionUUID->"d3b99f2d-0fd6-1249-b3c9-047bede96818"],

Cell["motor neurons,", "Item",ExpressionUUID->"0aabb31b-ff47-f84a-a22d-0b3e1f3adacf"],

Cell["sensory neurons,", "Item",ExpressionUUID->"389152c6-8ecf-734a-8c65-760e9a4eb897"],

Cell["dopaminergic neurons,", "Item",ExpressionUUID->"0a8860ee-adc0-2b4e-8f0d-086ef788a88c"],

Cell["inhibitory interneurons,", "Item",ExpressionUUID->"29ea8bdb-ea71-a04f-90d0-715fa2c77769"],

Cell["thalamic relay neurons,", "Item",ExpressionUUID->"d0afa91f-2c50-0341-8bf8-a784d04747ca"],

Cell["hippocampal place-related cells,", "Item",ExpressionUUID->"1afd9be3-6125-3f4b-8723-30f94f91f9e9"],

Cell["cortical chandelier and basket cells.", "Item",ExpressionUUID->"9367cf06-9902-8949-99af-65b91d2ccf18"]
}, Open  ]],

Cell[CellGroupData[{

Cell["9.3. Project rule", "Subsection",ExpressionUUID->"2b610385-4bf8-dc43-a668-dc3945b1ce4c"],

Cell[TextData[{
 "The architecture should support a many-to-many mapping: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
        "biological type", "\[LeftRightArrow]", "functional role", 
         "\[LeftRightArrow]", "digital module design"}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\text{biological type} \\leftrightarrow \\text{functional role} \
\\leftrightarrow \\text{digital module design}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "1c111cdc-802e-f943-a954-2cc9485eda45"]
}], "Text",ExpressionUUID->"7ca5b2a3-0167-7f4c-892c-38f8e6c8ca5d"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{0},
      "Spacer1"]},
    {
     TemplateBox[{0},
      "Spacer1"]}
   },
   AutoDelete->False,
   FrameStyle->Directive[
     LightDarkSwitched[
      GrayLevel[0.8], 
      GrayLevel[0.4867756]], 
     AbsoluteThickness[1]],
   GridBoxDividers->{
    "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
   GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Text", "MarkdownDelimiter",
 ShowStringCharacters->False,
 Background->None,ExpressionUUID->"72cb7dde-d7c9-fd45-bc16-cca7657c87a4"]
}, Open  ]]
