           StyleBox["t", "TI"], ")"}], "\[LongEqual]", 
         RowBox[{"(", 
           RowBox[{
             StyleBox["v", "TI"], ",", 
             StyleBox["g", "TI"], ",", 
             StyleBox["s", "TI"], ",", 
             StyleBox["p", "TI"], ",", 
             StyleBox["m", "TI"], ",", 
             StyleBox["r", "TI"], ",", 
             StyleBox["y", "TI"], ",", "\[Mu]", ",", 
             StyleBox["c", "TI"]}], ")"}]}], TraditionalForm], "errors" -> {},
      "input" -> "x(t)=\\big(v, g, s, p, m, r, y, \\mu, c\\big)", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "8a0de9cc-3af8-cb44-a6a2-bac8cc635156"],
 "where: "
}], "Text",ExpressionUUID->"0ce5943e-1d34-564b-9626-dd9f74d2d766"],

