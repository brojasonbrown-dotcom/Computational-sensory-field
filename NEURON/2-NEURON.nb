   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         FractionBox[
          RowBox[{
            StyleBox["d", "TI"], 
            StyleBox["q", "TI"]}], 
          RowBox[{
            StyleBox["d", "TI"], 
            StyleBox["t", "TI"]}]], "\[LongEqual]", 
         SubscriptBox["\[Alpha]", 
          StyleBox["q", "TI"]], 
         RowBox[{"(", 
           StyleBox["V", "TI"], ")"}], 
         RowBox[{"(", 
           RowBox[{"1", "-", 
             StyleBox["q", "TI"]}], ")"}], "-", 
         SubscriptBox["\[Beta]", 
          StyleBox["q", "TI"]], 
         RowBox[{"(", 
           StyleBox["V", "TI"], ")"}], 
         StyleBox["q", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\frac{dq}{dt} = \\alpha_q(V)(1-q) - \\beta_q(V)q", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "bca89932-8dbc-174b-beb7-5a11364680a1"],
 "which may also be written as ",
