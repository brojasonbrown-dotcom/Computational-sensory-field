}, Open  ]],

Cell[CellGroupData[{

Cell["5.6. Measurement layer", "Subsection",ExpressionUUID->"728b4ff5-8189-2943-a176-89a5604faa11"],

Cell["\<\
This is one of the project\[CloseCurlyQuote]s distinguishing features. It \
represents: \
\>", "Text",ExpressionUUID->"ac31d26f-9af0-c044-b9f2-7dd64d91683d"],

Cell["what the neuron detects,", "Item",ExpressionUUID->"e0a9c28d-3282-bc46-b8f3-26f6ad77963e"],

Cell["how it filters,", "Item",ExpressionUUID->"1ec480d3-c8ba-4a4f-9940-cda909bfeff0"],

Cell["how it distinguishes across scales,", "Item",ExpressionUUID->"31b1fb3f-869f-0448-8829-14231f73b157"],

Cell["what part of its state remains observable,", "Item",ExpressionUUID->"711eda3a-79d7-7d4a-bd70-7717a4572533"],

Cell["the geometry of its sensory interface.", "Item",ExpressionUUID->"89bede14-cc85-e84e-906a-b447e7a2ebea"]
}, Open  ]],

Cell[CellGroupData[{

Cell["5.7. Closure layer", "Subsection",ExpressionUUID->"e97c2380-7c62-3549-a333-2646d382af54"],

Cell["Represents: ", "Text",ExpressionUUID->"dafc8489-75ed-0b4f-9b8a-79d4ed883a0d"],

Cell["recurrence,", "Item",ExpressionUUID->"f8a03b2c-aec3-8d41-9b0d-93046dc85835"],

Cell["persistence,", "Item",ExpressionUUID->"a8f5c221-3c58-3a4d-b6a2-c12782ff3efd"],

Cell["self-return,", "Item",ExpressionUUID->"651b6d8e-8f45-b44b-b57f-f91dcdd03ea8"],

Cell["attractor maintenance,", "Item",ExpressionUUID->"ee4bfbc0-f42a-7d4f-bf83-b0214d076428"],

Cell["state identity through update.", "Item",ExpressionUUID->"9821d632-9374-ac46-84e6-9a259e60de1b"]
}, Open  ]],

Cell[CellGroupData[{

Cell["5.8. Embodiment layer", "Subsection",ExpressionUUID->"b32c637d-3bd5-3f41-8234-086fdde359c0"],

Cell["Represents: ", "Text",ExpressionUUID->"a9380413-4b3e-654f-a2a1-7119abf0ef93"],

Cell["sensor coupling,", "Item",ExpressionUUID->"b0515ef1-cd4a-e342-9424-be4ffe1c1270"],

Cell["environment interaction,", "Item",ExpressionUUID->"3d80e740-e697-9249-bf87-772cda96cbd7"],

Cell["action loops,", "Item",ExpressionUUID->"abebcbc0-3b9d-f641-bdbd-12650f08b6e8"],

Cell["adaptive constraints,", "Item",ExpressionUUID->"37450718-30bc-6b4f-b05c-8207b4589445"],

Cell["temporal embedding in a task domain.", "Item",ExpressionUUID->"612aefc5-5447-094e-905c-5c2cec8c0656"]
}, Open  ]],

Cell[CellGroupData[{

Cell["5.9. AI translation layer", "Subsection",ExpressionUUID->"ef9fe516-c35f-d844-af41-cee7172f2b83"],

Cell["Represents: ", "Text",ExpressionUUID->"3413cf87-27bf-e948-8239-713b1b35e23f"],

