Cell[CellGroupData[{

Cell["5. Conductance-based dynamics", "Section",ExpressionUUID->"21504056-e55b-a648-9004-09fb68439cf0"],

Cell[CellGroupData[{

Cell["5.1. Why conductance models matter", "Subsection",ExpressionUUID->"5ba81da3-8a55-e944-a521-c30d772ee790"],

Cell["\<\
Current-based neurons treat input as directly additive. But real neurons \
change conductance, which alters effective time constants and voltage \
sensitivity. \
\>", "Text",ExpressionUUID->"00601bab-eedf-4e4f-8238-9fd8f96f6dd5"]
}, Open  ]],

Cell[CellGroupData[{

Cell["5.2. General conductance model", "Subsection",ExpressionUUID->"9950cb7b-41bd-a940-91a1-829d1ddbc0e9"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["C", "TI"], 
          StyleBox["m", "TI"]], 
         FractionBox[
          RowBox[{
            StyleBox["d", "TI"], 
            StyleBox["V", "TI"]}], 
          RowBox[{
            StyleBox["d", "TI"], 
            StyleBox["t", "TI"]}]], "\[LongEqual]", "-", 
         UnderscriptBox["\[Sum]", 
          StyleBox["k", "TI"], LimitsPositioning -> True], 
         SubscriptBox[
          OverscriptBox[
           StyleBox["g", "TI"], "_"], 
          StyleBox["k", "TI"]], 
         SubscriptBox[
          StyleBox["a", "TI"], 
          StyleBox["k", "TI"]], 
         RowBox[{"(", 
           RowBox[{
             StyleBox["V", "TI"], ",", 
             StyleBox["t", "TI"]}], ")"}], 
         RowBox[{"(", 
           RowBox[{
             StyleBox["V", "TI"], "-", 
             SubscriptBox[
              StyleBox["E", "TI"], 
              StyleBox["k", "TI"]]}], ")"}], "+", 
         SubscriptBox[
          StyleBox["I", "TI"], 
          StyleBox["ext", FontSlant -> "Plain"]], 
         RowBox[{"(", 
           StyleBox["t", "TI"], ")"}]}], TraditionalForm], "errors" -> {}, 
     "input" -> 
     "C_m \\frac{dV}{dt}\n=\n-\\sum_k \\bar{g}_k a_k(V,t)(V-E_k)\n+ \
I_{\\mathrm{ext}}(t)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "63272dd2-f139-f546-a35a-719d7a8b3258"],
 "where ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["a", "TI"], 
        StyleBox["k", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "a_k", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "0af7e087-8a0e-3b4b-87ec-89dbaf035099"],
 " may be products of gating variables such as ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox[
          StyleBox["m", "TI"], 
          StyleBox["p", "TI"]], 
         SuperscriptBox[
          StyleBox["h", "TI"], 
          StyleBox["q", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "m^p h^q", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "242dc7a5-0dd5-c941-9744-e500c4a12f1a"],
 ". "
