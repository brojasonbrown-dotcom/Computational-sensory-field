Cell[CellGroupData[{

Cell["14. Benchmarking strategy", "Section",ExpressionUUID->"1041a22e-3385-cf48-80c0-e83a1a408dc8"],

Cell["No advanced neuron proposal is serious without benchmarks. ", "Text",ExpressionUUID->"f7a3ac4c-6cff-b942-a091-af3582938351"],

Cell[CellGroupData[{

Cell["14.1. Core evaluation axes", "Subsection",ExpressionUUID->"b2b4a76c-9f67-d84d-b719-d5edaa886472"],

Cell["The neuron architecture should be compared on: ", "Text",ExpressionUUID->"75cf6e81-a738-9f43-bdbb-05481161ceee"],

Cell["sequence learning,", "Item",ExpressionUUID->"fb838a3f-0cfe-7a40-be46-3f7b09646edb"],

Cell["multiscale sensory integration,", "Item",ExpressionUUID->"e0102e9c-274f-2641-b95c-e89fb10c7d70"],

Cell["robustness to noise,", "Item",ExpressionUUID->"35286a3b-9ee4-474e-a43c-82c3648b3e37"],

Cell["robustness to distribution shift,", "Item",ExpressionUUID->"5350d57f-5c1c-d94a-aed0-558fd99d4c25"],

Cell["energy/compute cost,", "Item",ExpressionUUID->"d2a4d034-2026-7b43-a6fa-5ecd121020a5"],

Cell["memory retention,", "Item",ExpressionUUID->"2e630456-c02a-1342-a9b8-d638df0797be"],

Cell["interpretability,", "Item",ExpressionUUID->"a05b55b7-7d31-3d45-9f17-a88bcca5694a"],

Cell["calibration quality,", "Item",ExpressionUUID->"7240a51d-add7-3642-889b-f970f77a2c84"],

Cell["continual learning,", "Item",ExpressionUUID->"b9c2f37c-1f1d-2540-b861-6a269ff1d1ab"],

Cell["failure under perturbation.", "Item",ExpressionUUID->"8d2e319f-0c56-4746-b262-620e571fdbc7"]
}, Open  ]],

Cell[CellGroupData[{

Cell["14.2. Scientific evaluation axes", "Subsection",ExpressionUUID->"cd668674-2013-214e-94d6-d2b2012ab296"],

Cell["If RHUFT-style variables are added, also compare: ", "Text",ExpressionUUID->"07b1c543-c931-6d40-b795-51a26328464e"],

Cell["whether closure metrics predict performance,", "Item",ExpressionUUID->"443a6be3-f8b9-d347-bab6-1c0b8345e8a4"],

Cell["whether measurement-state logging improves diagnosis,", "Item",ExpressionUUID->"404044ec-fc97-f343-a573-a518f9e62f03"],

Cell["whether geometry-aware layouts improve observability,", "Item",ExpressionUUID->"68e8053b-96ac-0e41-8d29-11f67271398d"],

Cell["whether multiscale operators outperform flat ones.", "Item",ExpressionUUID->"e223adcf-1b8e-bf41-913c-aa24266ffb53"],

