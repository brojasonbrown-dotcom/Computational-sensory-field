Cell["Mathematical candidates: ", "Text",ExpressionUUID->"e02df9f9-840f-be4a-826c-7b9ff4abb6c6"],

Cell["ODEs,", "Item",ExpressionUUID->"7823d7ee-be2b-e54a-950f-17aead2a11aa"],

Cell["PDEs,", "Item",ExpressionUUID->"07404843-a20c-384c-bcc8-9fb3c28577ab"],

Cell["stochastic differential equations,", "Item",ExpressionUUID->"3f839f6a-2f0d-4a43-a068-4ef525ce0b29"],

Cell["compartmental systems.", "Item",ExpressionUUID->"241352d2-556e-a540-94d1-cfcc4f3a5bae"]
}, Open  ]],

Cell[CellGroupData[{

Cell["5.3. Synaptic layer", "Subsection",ExpressionUUID->"65a2fe30-d57c-0546-b24a-f92702d2e9ad"],

Cell["Represents: ", "Text",ExpressionUUID->"59164546-f3aa-7b4a-9fd7-3c88ceac22ce"],

