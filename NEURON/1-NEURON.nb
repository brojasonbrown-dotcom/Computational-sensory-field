Cell[CellGroupData[{

Cell["2. Scope and epistemic discipline", "Section",ExpressionUUID->"86fc2229-2455-a54a-8167-4be8a79d19d3"],

Cell[CellGroupData[{

Cell["2.1. Four epistemic layers", "Subsection",ExpressionUUID->"6f1b2864-c4a0-ed4c-bd0c-ff2e57721596"],

Cell["\<\
To keep the program rigorous, every statement in the series must be assigned \
to one of four layers. \
\>", "Text",ExpressionUUID->"b03b3ad1-c6c3-df4a-b00a-ec576c053fde"],

Cell[CellGroupData[{

Cell["Layer A \[LongDash] Established neuroscience", "Subsubsection",ExpressionUUID->"cc046f95-1892-7044-a940-9510b1a51bc3"],

Cell["This includes: ", "Text",ExpressionUUID->"2f199279-bf71-9442-a012-6cfa42abd753"],

Cell["membrane dynamics,", "Item",ExpressionUUID->"21487fce-0185-d149-973c-dc870168f54b"],

Cell["ion channel kinetics,", "Item",ExpressionUUID->"8386efcf-c9a5-634f-9406-7fd037157ecf"],

Cell["cable theory,", "Item",ExpressionUUID->"20ee9db0-beeb-d64b-a3bc-7e44c55ff487"],

Cell["synaptic transmission,", "Item",ExpressionUUID->"6036e94c-13db-a146-8af1-26e1d4a66dfb"],

Cell["plasticity,", "Item",ExpressionUUID->"572d66e4-f5b3-7249-92f1-850f638280de"],

Cell["network motifs,", "Item",ExpressionUUID->"700cb42d-25b8-a64a-a21a-07a0aa515dd7"],

Cell["glial interaction where established.", "Item",ExpressionUUID->"c0601da7-8bcd-4245-8f09-85f9af76f099"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Layer B \[LongDash] Engineering abstraction", "Subsubsection",ExpressionUUID->"5f3c8567-190b-274c-a92d-9d3bb79626a6"],

Cell["This includes: ", "Text",ExpressionUUID->"5a7660e8-aefe-064a-8165-431b7206bad8"],

Cell["digital neuron approximations,", "Item",ExpressionUUID->"96918b52-ce55-0247-ad5c-6b63083559f3"],

Cell["trainable recurrent units,", "Item",ExpressionUUID->"4cef2b83-295a-2142-a257-881110afad83"],

Cell["graph-based morphology abstractions,", "Item",ExpressionUUID->"6013b06a-b58c-0a4c-a24a-13340d8ff12b"],

Cell["differentiable surrogate dynamics,", "Item",ExpressionUUID->"3bd839a7-95ba-f343-a1a9-6815a0ead719"],

Cell["efficient approximations for deployment.", "Item",ExpressionUUID->"7a86c184-675a-4e44-a276-abee283c4e8b"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Layer C \[LongDash] Measurement-centric extension", "Subsubsection",ExpressionUUID->"4785188d-8575-3045-9ba7-2a87ce15719c"],

Cell["This includes: ", "Text",ExpressionUUID->"cf215f2c-7c00-fc49-9b3b-d0189bb93394"],

Cell["explicit measurement-state variables,", "Item",ExpressionUUID->"4242b26b-28a9-f845-b1cb-cc376f6c2565"],

Cell["observability maps,", "Item",ExpressionUUID->"3cd82ef8-f732-1849-b304-df67cfed03e4"],

Cell["multiscale sensing,", "Item",ExpressionUUID->"4e3b328e-8958-164c-b627-fcee4c1b95ea"],

Cell["interface geometry,", "Item",ExpressionUUID->"07815eee-0160-4d43-aa8b-7285264336c5"],

Cell["history dependence and hysteresis descriptors.", "Item",ExpressionUUID->"e9a70a3b-a1db-be45-8946-12e98557f129"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Layer D \[LongDash] RHUFT-style speculative extension", "Subsubsection",ExpressionUUID->"4e3dc171-0d90-4b4a-b6cc-240481a5cdf9"],

Cell["This includes: ", "Text",ExpressionUUID->"9fc78668-dc46-5946-99ba-34296ccb218b"],

Cell["closure functionals,", "Item",ExpressionUUID->"54f9845a-4878-1947-a59b-4b6506a71eff"],

Cell["recursive self-measurement as a primitive principle,", "Item",ExpressionUUID->"7d5556b5-f54d-db49-a100-9e43927aea37"],

Cell["golden/silver spacing hypotheses,", "Item",ExpressionUUID->"9ec1ceb4-ed6e-4e45-9d0e-3dd1443cf38f"],

Cell["geometry-sensitive invariant claims,", "Item",ExpressionUUID->"14456466-56e4-da4a-9ae4-60e211a81c22"],

Cell["broader ontological interpretations.", "Item",ExpressionUUID->"160f1261-57dd-3c45-9b39-458b9673f9b0"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["2.2. Why this separation matters", "Subsection",ExpressionUUID->"d2319b3a-5f47-3c42-b713-075d79c6a5ee"],

Cell["\<\
Without it, the project becomes impossible to validate. With it, the project \
can grow in a controlled way from biology to mathematics to AI to ontology. \
\>", "Text",ExpressionUUID->"2ae19b1a-b509-5c4f-96a7-7a4ab2336135"],

