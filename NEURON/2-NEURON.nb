 "\n14.4 Effective potential and circulation panels\n",
 Cell[BoxData[{
  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", 
     RowBox[{"effectivePotentialPlot", ",", "fieldCirculationPlot"}], "]"}], 
    ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"effectivePotentialPlot", "[", 
      RowBox[{"pot_", ",", 
       RowBox[{"\[CapitalOmega]_", "?", "NumericQ"}], ",", "xrange_", ",", 
       "yrange_"}], "]"}], ":=", "\[IndentingNewLine]", "  ", 
     RowBox[{"Plot3D", "[", "\[IndentingNewLine]", "    ", 
      RowBox[{
       RowBox[{"Evaluate", "[", 
        RowBox[{
         RowBox[{"effectivePotential2D", "[", 
          RowBox[{"pot", ",", "\[CapitalOmega]"}], "]"}], "[", 
         RowBox[{"x", ",", "y"}], "]"}], "]"}], ",", "\[IndentingNewLine]", 
       "    ", 
       RowBox[{"{", 
        RowBox[{"x", ",", 
         RowBox[{"xrange", "[", 
          RowBox[{"[", "1", "]"}], "]"}], ",", 
         RowBox[{"xrange", "[", 
          RowBox[{"[", "2", "]"}], "]"}]}], "}"}], ",", "\[IndentingNewLine]",
        "    ", 
       RowBox[{"{", 
        RowBox[{"y", ",", 
         RowBox[{"yrange", "[", 
          RowBox[{"[", "1", "]"}], "]"}], ",", 
         RowBox[{"yrange", "[", 
          RowBox[{"[", "2", "]"}], "]"}]}], "}"}], ",", "\[IndentingNewLine]",
        "    ", 
       RowBox[{"PlotRange", "->", "All"}], ",", "\[IndentingNewLine]", "    ", 
       RowBox[{"Mesh", "->", "None"}], ",", "\[IndentingNewLine]", "    ", 
       RowBox[{"PlotLabel", "->", "\"\<Effective potential landscape\>\""}], ",",
        "\[IndentingNewLine]", "    ", 
       RowBox[{"AxesLabel", "->", 
        RowBox[{"{", 
         RowBox[{"\"\<x\>\"", ",", "\"\<y\>\"", ",", "\"\<Veff\>\""}], 
         "}"}]}]}], "\[IndentingNewLine]", "  ", "]"}]}], ";"}], 
   "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"fieldCirculationPlot", "[", 
     RowBox[{"field_", ",", "xrange_", ",", "yrange_"}], "]"}], ":=", 
    RowBox[{"Module", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"{", "curlExpr", "}"}], ",", "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"curlExpr", "=", 
        RowBox[{
         RowBox[{"curl2D", "[", "field", "]"}], "[", 
         RowBox[{"x", ",", "y"}], "]"}]}], ";", "\[IndentingNewLine]", "  ", 
       RowBox[{"GraphicsGrid", "[", 
        RowBox[{"{", 
         RowBox[{"{", "\[IndentingNewLine]", "     ", 
          RowBox[{
           RowBox[{"VectorPlot", "[", "\[IndentingNewLine]", "       ", 
            RowBox[{
             RowBox[{"Evaluate", "[", "field", "]"}], ",", 
             "\[IndentingNewLine]", "       ", 
             RowBox[{"{", 
              RowBox[{"x", ",", 
               RowBox[{"xrange", "[", 
                RowBox[{"[", "1", "]"}], "]"}], ",", 
               RowBox[{"xrange", "[", 
                RowBox[{"[", "2", "]"}], "]"}]}], "}"}], ",", 
             "\[IndentingNewLine]", "       ", 
             RowBox[{"{", 
              RowBox[{"y", ",", 
               RowBox[{"yrange", "[", 
                RowBox[{"[", "1", "]"}], "]"}], ",", 
               RowBox[{"yrange", "[", 
                RowBox[{"[", "2", "]"}], "]"}]}], "}"}], ",", 
             "\[IndentingNewLine]", "       ", 
             RowBox[{"PlotLabel", "->", "\"\<Field flow\>\""}]}], 
            "\[IndentingNewLine]", "     ", "]"}], ",", "\[IndentingNewLine]",
            "     ", 
           RowBox[{"DensityPlot", "[", "\[IndentingNewLine]", "       ", 
            RowBox[{
             RowBox[{"Evaluate", "[", "curlExpr", "]"}], ",", 
             "\[IndentingNewLine]", "       ", 
             RowBox[{"{", 
              RowBox[{"x", ",", 
               RowBox[{"xrange", "[", 
                RowBox[{"[", "1", "]"}], "]"}], ",", 
               RowBox[{"xrange", "[", 
                RowBox[{"[", "2", "]"}], "]"}]}], "}"}], ",", 
             "\[IndentingNewLine]", "       ", 
             RowBox[{"{", 
