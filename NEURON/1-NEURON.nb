Cell[CellGroupData[{

Cell["4. Critique of the current text file", "Section",ExpressionUUID->"59020110-e933-8042-a09f-3fb91c76585d"],

Cell[TextData[{
 "The file ",
 Cell[BoxData[Cell["MATHEMATICAL NEURON.txt",
   Background->None,ExpressionUUID->"c9fa9667-d62f-cc4b-85fe-9fa43435e1a2"]], 
  "InlineCode",ExpressionUUID->"d0ace6bc-1c5c-5b47-8cfc-bef598cec30a"],
 " contains useful vision, but it is not yet a full neuron mathematics. It is \
best interpreted as a ",
 StyleBox["programmatic sketch",
  FontWeight->Bold],
 ". "
}], "Text",ExpressionUUID->"666d8446-5754-414d-9c86-da12e0686128"],

Cell[CellGroupData[{

Cell["4.1. Strengths of the text", "Subsection",ExpressionUUID->"478a60d9-3860-6342-b665-c4dd7feb4898"],

Cell["It contains several productive themes: ", "Text",ExpressionUUID->"d506d889-7d34-f14d-9fee-3603e403cb55"],

Cell["persistence as closure,", "Item",ExpressionUUID->"ffa94633-7f3a-3a41-a060-d86e301a1410"],

Cell["operator-based thinking,", "Item",ExpressionUUID->"d73ef614-e67e-0346-a775-6677bb508cf4"],

Cell["fixed-point and resonance language,", "Item",ExpressionUUID->"07929afd-6e1a-a241-9146-1bb24dec5a02"],

Cell["architecture-level rather than single-equation thinking,", "Item",ExpressionUUID->"7166e390-030e-4841-b2b0-4eb301fe2bf0"],

Cell["recognition that measurement matters,", "Item",ExpressionUUID->"232b09dd-01b9-6d4c-80de-17b920825a9d"],

Cell["\<\
recognition that AI should not remain a static feedforward abstraction.\
\>", "Item",ExpressionUUID->"baeb998d-e34b-414d-9633-e94bcca67926"]
}, Open  ]],

Cell[CellGroupData[{

Cell["4.2. Main deficiencies", "Subsection",ExpressionUUID->"899837d7-c51d-4046-a8f4-14c682d85698"],

Cell["To become mathematically complete, the sketch still lacks:", "Text",ExpressionUUID->"63399823-d7ee-5642-bb92-cf08afb4559a"],

Cell["1. a precise neuron state space,", "Text",ExpressionUUID->"0ae1a42c-87c1-7e46-a9b0-4dde030020aa"],

Cell["2. a hierarchy of neuron model classes,", "Text",ExpressionUUID->"e374b50d-fbad-f34f-a1f3-013333d10b7e"],

Cell["3. explicit membrane and channel equations,", "Text",ExpressionUUID->"c2715fc1-8128-3d4a-b835-d26af9207fa4"],

Cell["4. spatial cable formalisms,", "Text",ExpressionUUID->"41403f0d-53bf-3b43-9d45-4b48acc11dff"],

Cell["5. synapse and receptor kinetics,", "Text",ExpressionUUID->"78a2c0c2-d700-cc4b-a9cd-c6f8278ce3c0"],

Cell["6. plasticity rules,", "Text",ExpressionUUID->"2710765f-3f54-9647-9e92-92b698488189"],

Cell["7. glia-neuron coupling equations,", "Text",ExpressionUUID->"8fd3539b-22bc-0f49-b7f2-d181c8366de9"],

Cell["8. network embedding formalism,", "Text",ExpressionUUID->"1d94cdaa-442f-2042-a901-384470f93140"],

Cell["9. operational definitions for closure variables,", "Text",ExpressionUUID->"32b56de6-7270-5e48-94e5-5239b91c997b"],

Cell["10. a training strategy for digital realization,", "Text",ExpressionUUID->"c65ddf1c-591a-8747-80bc-e3159b29213c"],

Cell["11. benchmark criteria,", "Text",ExpressionUUID->"9c504d14-3c34-5448-9c0c-097e8de489c7"],

Cell["\<\
12. clear separation between established and speculative claims. \
\>", "Text",ExpressionUUID->"c2a36a29-f030-a04f-98c1-884e601e0f62"]
}, Open  ]],

Cell[CellGroupData[{

Cell["4.3. Corrective principle", "Subsection",ExpressionUUID->"1d3d8163-5f48-df42-aab2-c069fbeb8044"],

Cell[TextData[{
 "The right way to improve the text is not to discard it, but to ",
 StyleBox["factorize it",
  FontWeight->Bold],
 ": "
}], "Text",ExpressionUUID->"0c412ce9-a018-584e-b7fd-b8288021380a"],

Cell["keep its strong conceptual operators,", "Item",ExpressionUUID->"627c8749-e4c0-ab4d-93be-e86db7714c09"],

Cell["replace vague claims with state variables and equations,", "Item",ExpressionUUID->"e1b832ba-649c-dc4c-8382-3fc1019d3db0"],

Cell["\<\
move unproven ratio claims into explicit hypothesis sections,\
\>", "Item",ExpressionUUID->"bb5e60e8-6582-5d4d-afa8-00f98ce53121"],

Cell["create executable model ladders.", "Item",ExpressionUUID->"c905caac-6ec6-e245-8d7b-a3abad4eff93"],

