Cell[CellGroupData[{

Cell["13. Digital implementation requirements", "Section",ExpressionUUID->"fc3f288f-7c75-a941-84c2-d090e316f928"],

Cell["\<\
To be useful in AI, the full neuron concept must be convertible into \
practical computational objects. \
\>", "Text",ExpressionUUID->"3e6064e9-7a7b-0043-bd14-cd9c84747ccf"],

Cell[CellGroupData[{

Cell["13.1. Required implementation modes", "Subsection",ExpressionUUID->"594b50f0-4b45-b04a-a989-905e9c60c627"],

Cell["The architecture should admit: ", "Text",ExpressionUUID->"458049aa-402e-4544-b7d6-74cc89e5ac98"],

Cell["full simulation mode,", "Item",ExpressionUUID->"5e0682cb-eca3-e343-ad78-1bca4c65fc5c"],

Cell["reduced differentiable training mode,", "Item",ExpressionUUID->"1eaae74c-1d8a-3848-b039-52c473f3ac7e"],

Cell["efficient inference mode,", "Item",ExpressionUUID->"a36199e3-2c51-0243-a98d-173342847ea7"],

Cell["ablation mode,", "Item",ExpressionUUID->"49073152-e20a-594b-b2a0-6455505c1465"],

Cell["interpretable diagnostic mode.", "Item",ExpressionUUID->"785ca6dd-ea2b-3d47-99e4-90cfc3e95e7c"]
}, Open  ]],

Cell[CellGroupData[{

Cell["13.2. Design rule", "Subsection",ExpressionUUID->"ee2d10b0-667c-c14a-ae8b-6bfc84d2f36a"],

Cell["\<\
Every biologically rich mechanism added to the neuron should be accompanied \
by at least one simplified surrogate suitable for digital training. \
\>", "Text",ExpressionUUID->"3624c6af-2fde-6a43-9896-c4e0cc0cc70f"],

