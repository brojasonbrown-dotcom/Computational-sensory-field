 ShowStringCharacters->False,
 Background->None,ExpressionUUID->"31926dce-0cbb-d74f-aa85-a1f376923468"]
}, Open  ]],

Cell[CellGroupData[{

Cell["1. Epistemic layers for this notebook", "Section",ExpressionUUID->"22a60d77-5251-0342-a691-21bb642f6687"],

Cell["\<\
To maintain rigor, every section belongs primarily to one of the following: \
\>", "Text",ExpressionUUID->"88d3fa42-0619-4248-a322-37f90fef3e9e"],

Cell[CellGroupData[{

Cell["Layer A \[LongDash] Established neuron biophysics", "Subsection",ExpressionUUID->"62c084e2-f809-d84f-adfd-bfdae28b9416"],

Cell["Includes: ", "Text",ExpressionUUID->"5dc831ca-e1fd-8d4c-9785-ddaefdd879d1"],

Cell["membrane voltage dynamics,", "Item",ExpressionUUID->"56bb33aa-1ba2-3e44-b707-217965670ea4"],

Cell["equivalent circuit models,", "Item",ExpressionUUID->"db0ebdc9-b309-bb4a-8547-3753446f2fe6"],

Cell["conductance-based currents,", "Item",ExpressionUUID->"f4b42188-053b-224a-8a90-93495285def2"],

Cell["ion channel kinetics,", "Item",ExpressionUUID->"0aac247f-99f6-134e-947f-1e1c6cb420ec"],

Cell["cable and compartment models.", "Item",ExpressionUUID->"a0c28f6b-f326-8d4e-8ce4-3fa1c4f7df2c"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Layer B \[LongDash] Computational reduction", "Subsection",ExpressionUUID->"f06a149c-7079-8f49-9b25-66010a9b7e98"],

Cell["Includes: ", "Text",ExpressionUUID->"ed0852b7-fae0-7a4f-811a-754e7f3cfc2b"],

Cell["integrate-and-fire reductions,", "Item",ExpressionUUID->"9b8c2e3b-aaf6-5049-aff0-6a71d2bd684c"],

Cell["adaptive neuron models,", "Item",ExpressionUUID->"e737c7d9-3f90-4c48-8906-a2da2a16965f"],

Cell["low-dimensional surrogates,", "Item",ExpressionUUID->"a6a308ce-8824-a243-94b2-94c49ffe3838"],

Cell["trainable digital approximations.", "Item",ExpressionUUID->"5e32c6e1-1b54-5741-8138-f6b949fcef2b"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Layer C \[LongDash] Measurement-aware extension", "Subsection",ExpressionUUID->"5ce590ac-17b6-b84d-8680-776d7c98c480"],

Cell["Includes: ", "Text",ExpressionUUID->"285d2dfa-697e-ad45-8b0e-6afa3c0d73dd"],

Cell["explicit observation operators,", "Item",ExpressionUUID->"b366c4aa-d53f-5643-bbad-9b71ced256ec"],

Cell["internal state accessibility,", "Item",ExpressionUUID->"eb8e4f8a-4c4a-ce4d-8db7-a9ba6d8d5ff5"],

Cell["multiscale sensing variables,", "Item",ExpressionUUID->"53bb7e8d-28e7-f946-8cfc-727d48a4d3b4"],

Cell["geometry-sensitive transduction concepts.", "Item",ExpressionUUID->"4eadb775-9aac-fd4d-b108-896295b4da62"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Layer D \[LongDash] RHUFT extension channel", "Subsection",ExpressionUUID->"f9cb218c-e8a0-3d4b-abaa-6ccec0be93c3"],

Cell["Includes: ", "Text",ExpressionUUID->"e83455aa-4292-c240-8cc3-8ed5229eeb7f"],

Cell["distinguishability density variables,", "Item",ExpressionUUID->"3e657635-fc51-fd4f-a4d8-c27c351707e0"],

