        Module[{$CellContext`orbit, $CellContext`residuals}, \
$CellContext`orbit = $CellContext`rgOrbit[$CellContext`dyadicCoarseGrain, \
$CellContext`state, $CellContext`steps]; $CellContext`residuals = \
$CellContext`scaleResiduals[$CellContext`state, $CellContext`steps]; 
          GraphicsGrid[{{
              
              ListLinePlot[$CellContext`state, Frame -> True, PlotLabel -> 
               "Initial state"], 
              
              ListLinePlot[$CellContext`residuals, Frame -> True, PlotLabel -> 
               "Scale residuals"]}, {
              Column[
               MapIndexed[
               ListLinePlot[#, Frame -> True, PlotRange -> All, PlotLabel -> 
                 Row[{"Scale ", First[#2] - 1, " length ", 
                    Length[#]}]]& , $CellContext`orbit]], 
              Graphics[{}]}}]], $CellContext`pointerPanel[
          PatternTest[
           Pattern[$CellContext`initialState, 
            Blank[]], MatrixQ], 
          Pattern[$CellContext`phaseSchedule, 
           Blank[List]], 
          PatternTest[
           Pattern[$CellContext`p, 
            Blank[]], NumericQ]] := 
        Module[{$CellContext`data, $CellContext`pops}, $CellContext`data = \
$CellContext`pointerModeData[$CellContext`initialState, \
$CellContext`phaseSchedule, $CellContext`p]; $CellContext`pops = Map[Diagonal, 
             $CellContext`data["Orbit"]]; GraphicsGrid[{{
              ListLinePlot[
               $CellContext`data["CoherenceNorms"], Frame -> True, PlotLabel -> 
               "Off-diagonal coherence"], 
              ListLinePlot[
               Transpose[$CellContext`pops], Frame -> True, PlotLabel -> 
               "Pointer populations", PlotLegends -> 
               Automatic]}}]], $CellContext`effectivePotentialPlot[
          Pattern[$CellContext`pot, 
           Blank[]], 
          PatternTest[
           Pattern[$CellContext`\[CapitalOmega], 
            Blank[]], NumericQ], 
          Pattern[$CellContext`xrange, 
           Blank[]], 
          Pattern[$CellContext`yrange, 
           Blank[]]] := Plot3D[
          Evaluate[
           $CellContext`effectivePotential2D[$CellContext`pot, $CellContext`\
\[CapitalOmega]][$CellContext`x, $CellContext`y]], {$CellContext`x, 
           Part[$CellContext`xrange, 1], 
           Part[$CellContext`xrange, 2]}, {$CellContext`y, 
           Part[$CellContext`yrange, 1], 
           Part[$CellContext`yrange, 2]}, PlotRange -> All, Mesh -> None, 
          PlotLabel -> "Effective potential landscape", 
          AxesLabel -> {"x", "y", "Veff"}], $CellContext`fieldCirculationPlot[
          Pattern[$CellContext`field, 
           Blank[]], 
          Pattern[$CellContext`xrange, 
           Blank[]], 
          Pattern[$CellContext`yrange, 
           Blank[]]] := 
        Module[{$CellContext`curlExpr}, $CellContext`curlExpr = \
$CellContext`curl2D[$CellContext`field][$CellContext`x, $CellContext`y]; 
          GraphicsGrid[{{
              VectorPlot[
               Evaluate[$CellContext`field], {$CellContext`x, 
                Part[$CellContext`xrange, 1], 
                Part[$CellContext`xrange, 2]}, {$CellContext`y, 
                Part[$CellContext`yrange, 1], 
                Part[$CellContext`yrange, 2]}, PlotLabel -> "Field flow"], 
              DensityPlot[
               Evaluate[$CellContext`curlExpr], {$CellContext`x, 
                Part[$CellContext`xrange, 1], 
                Part[$CellContext`xrange, 2]}, {$CellContext`y, 
                Part[$CellContext`yrange, 1], 
                Part[$CellContext`yrange, 2]}, PlotLabel -> 
               "Scalar curl"]}}]], $CellContext`curl2D[
          Pattern[$CellContext`field, 
           Blank[]]][
          Pattern[$CellContext`x, 
           Blank[]], 
          Pattern[$CellContext`y, 
           Blank[]]] := D[
           Part[$CellContext`field, 2], $CellContext`x] - D[
          Part[$CellContext`field, 1], $CellContext`y]}; 
      Typeset`initDone$$ = True),
     SynchronousInitialization->True,
     UndoTrackedVariables:>{Typeset`show$$, Typeset`bookmarkMode$$},
     UnsavedVariables:>{Typeset`initDone$$},
     UntrackedVariables:>{Typeset`size$$}], "Manipulate",
    Deployed->True,
    StripOnInput->False],
   Manipulate`InterpretManipulate[1]]], "Output",
  CellChangeTimes->{4.000965492269066*^9},ExpressionUUID->
  "3c05b720-3bdd-da42-929b-26aa85b84b84"],
 "\n",
 Cell[BoxData[
  TagBox[GridBox[{
     {
      TemplateBox[{0},
       "Spacer1"]},
     {
      TemplateBox[{0},
       "Spacer1"]}
    },
    AutoDelete->False,
    FrameStyle->Directive[
      LightDarkSwitched[
       GrayLevel[0.8], 
       GrayLevel[0.4867756]], 
      AbsoluteThickness[1]],
    GridBoxDividers->{
     "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
    GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
   "Grid"]], "Text", "MarkdownDelimiter",
  ShowStringCharacters->False,
  Background->None,ExpressionUUID->"8f62f427-a3bf-2e42-a13f-07d1b59bbb23"],
 "\n17. Falsification conditions\nA serious framework must specify failure \
cases.\nThis framework is under pressure if:\n1. spectral stability and scale \
robustness systematically disagree,\n2. selection stability never correlates \
with spectral persistence,\n3. visually appealing \
\[OpenCurlyDoubleQuote]pockets\[CloseCurlyDoubleQuote] are not stationary or \
metastable under quantitative tests,\n4. apparent vortex-like structure has \
no nontrivial curl, winding, or topological signature,\n5. conclusions drift \
strongly with truncation or discretization refinement. \n",
 Cell[BoxData[
  TagBox[GridBox[{
     {
      TemplateBox[{0},
       "Spacer1"]},
     {
      TemplateBox[{0},
       "Spacer1"]}
    },
    AutoDelete->False,
    FrameStyle->Directive[
      LightDarkSwitched[
       GrayLevel[0.8], 
       GrayLevel[0.4867756]], 
      AbsoluteThickness[1]],
    GridBoxDividers->{
     "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
    GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
   "Grid"]], "Text", "MarkdownDelimiter",
  ShowStringCharacters->False,
  Background->None,ExpressionUUID->"6748d32e-18da-734e-89e3-82ec2f0bda19"],
 "\n18. Final summary\nThis notebook provides a rigorous scaffold for \
testing: \nspectral persistence,\nPDE mode structure,\nscale robustness,\n\
selection stability,\nequilibrium pocket formation,\nfield circulation and \
winding,\ncross-scale transfer,\nstructured order diagnostics.\nIt is a ",
 StyleBox["test harness",
  FontWeight->Bold],
 ", not a proof of metaphysical ontology.\nThat distinction is essential."
}], "ChatInput",
 TaggingRules-><|
  "ChatNotebookSettings" -> <|
    "Model" -> <|"Service" -> "LLMKit", "Name" -> Automatic|>, "LLMEvaluator" -> 
     "WolframAIAssistant", "ServiceCaller" -> "Chatbar"|>|>,
 CellChangeTimes->{{4.0009807480720367`*^9, 4.0009807492070312`*^9}},
 CellLabel->"In[2]:=",ExpressionUUID->"cd5a9a54-0fca-e640-9af9-b7f0bcf55b65"],

Cell[TextData[{
 "Yes \[LongDash] and the notebook is actually doing something much more \
careful than claiming \[OpenCurlyDoubleQuote]the sensory field is proven.\
\[CloseCurlyDoubleQuote] It builds a ",
 StyleBox["mathematical scaffold",
  FontWeight->Bold],
 " for talking about something like a sensory field without collapsing \
geometry, resonance, stability, topology, and interpretation into one vague \
term. \n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"Short version\"\>", "Section",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->22],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"ea9f7696-31c5-2d49-b742-c1e52a72a86d"],
 "\nIn the logic of this notebook, the ",
 StyleBox["sensory field",
  FontWeight->Bold],
 " is best understood as: \n",
 Cell[BoxData[GridBox[{
    {
     PaneBox[Cell[TextData[{
       "a ",
       StyleBox["structured relational field of interactions",
        FontWeight->Bold],
       " in which stable patterns can form, persist across scale, survive \
repeated coupling, and organize into topology-bearing flow structures."
      }],
       Background->None,ExpressionUUID->
       "8b5fa35f-5d78-8b4d-a34f-b8477b0c6059"],
      BaseStyle->{"Text", FontColor -> LightDarkSwitched[
          GrayLevel[0.35], 
          GrayLevel[0.8602474]]},
      ImageMargins->5,
      ImageSize->{Full, Automatic}]}
   },
   AutoDelete->False,
   GridBoxBackground->{"Columns" -> {{
        LightDarkSwitched[
         GrayLevel[1], 
         GrayLevel[0.278317]]}}},
   GridBoxDividers->{"ColumnsIndexed" -> {1 -> Directive[
         LightDarkSwitched[
          RGBColor[0.87, 0.94, 1], 
          RGBColor[0.2491127, 0.3295188, 0.4231198]], 
         AbsoluteThickness[4]]}, "Rows" -> {{False}}},
   GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}]], 
  "BlockQuote",
  Background->None,ExpressionUUID->"8141b7da-d6a3-f449-ae15-740c28bc64b0"],
 "\nSo it is ",
 StyleBox["not",
  FontWeight->Bold],
 " merely \[OpenCurlyDoubleQuote]a field of sensations,\
\[CloseCurlyDoubleQuote] and it is ",
 StyleBox["not yet",
  FontWeight->Bold],
 " a rigorously derived metaphysical absolute. In the notebook\
\[CloseCurlyQuote]s own epistemic policy, most of the strongest claims about \
\[OpenCurlyDoubleQuote]hyperdimensional information becoming deterministic \
structure\[CloseCurlyDoubleQuote] are still ",
 StyleBox["model hypothesis",
  FontWeight->Bold],
 " or ",
 StyleBox["speculation",
  FontWeight->Bold],
 " unless tied to explicit diagnostics.\n\nWhat the notebook ",
 StyleBox["does",
  FontSlant->Italic],
 " support is this:\n\n1. ",
 StyleBox["Geometry constrains admissible patterns",
  FontWeight->Bold],
 "\n2. ",
 StyleBox["Operators define resonant modes",
  FontWeight->Bold],
 "\n3. ",
 StyleBox["Resonant modes define persistent structures",
  FontWeight->Bold],
 "\n4. ",
 StyleBox["Scale robustness tests whether those structures survive \
coarse-graining",
  FontWeight->Bold],
 "\n5. ",
 StyleBox["Selection stability tests whether repeated interaction picks \
preferred states",
  FontWeight->Bold],
 "\n6. ",
 StyleBox["Field topology tests whether organization has circulation, \
pockets, winding, and metastable basins",
  FontWeight->Bold],
 "\n7. ",
 StyleBox["Cross-scale synthesis checks whether these mechanisms align",
  FontWeight->Bold],
 "\n\nThat is the real \[OpenCurlyDoubleQuote]vision.\[CloseCurlyDoubleQuote] \
\n",
 Cell[BoxData[
  TagBox[GridBox[{
     {
      TemplateBox[{0},
       "Spacer1"]},
     {
      TemplateBox[{0},
       "Spacer1"]}
    },
    AutoDelete->False,
    FrameStyle->Directive[
      LightDarkSwitched[
       GrayLevel[0.8], 
       GrayLevel[0.4867756]], 
      AbsoluteThickness[1]],
    GridBoxDividers->{
     "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
    GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
   "Grid"]], "MarkdownDelimiter",
  ShowStringCharacters->False,
  Background->None,ExpressionUUID->"2f9ea8b7-c2c9-384f-a4a6-4a207c574e7c"],
 "\n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"1. What the sensory field means here\"\>", "Title",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->26],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"c68247db-f0fd-8a40-84c7-3bd8a281a938"],
 "\nUsing the notebook\[CloseCurlyQuote]s corrected terminology, the phrase \
\[OpenCurlyDoubleQuote]sensory field\[CloseCurlyDoubleQuote] should be \
translated into something like: \n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  StyleBox[
  "ambient low-gradient background + local source density + coupled \
multiscale field network + recurrent state selection",
   FontWeight->Bold]
 }], "InlineItem",ExpressionUUID->"e7697a6b-60ea-3848-b10d-64445307e9f0"],
 "\nIn plain language: \n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "there is a background substrate,"
 }], "InlineItem",ExpressionUUID->"e3626e05-4ebc-9341-ada6-92b894783d41"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "disturbances or sources shape it,"
 }], "InlineItem",ExpressionUUID->"9842c8c1-fa0e-e94b-aaaa-54537d011899"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "the resulting field supports certain patterns more than others,"
 }], "InlineItem",ExpressionUUID->"8ea1615f-f9e4-e145-a452-4aa5c01810d7"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "repeated interaction selects persistent configurations."
 }], "InlineItem",ExpressionUUID->"641c4dfd-7fdb-c848-a8a9-867b52a3d829"],
 "\nSo the sensory field is not a mystical fog. It is more like a ",
 StyleBox["constraint-bearing medium of relational detectability",
  FontWeight->Bold],
 ".\n\nIf you want the strongest rigorous phrasing: \n",
 Cell[BoxData[GridBox[{
    {
     PaneBox["\<\"The sensory field is the total structured domain in which a \
state can be distinguished, stabilized, and related to other states through \
geometry, dynamics, scale transfer, and interaction history.\"\>",
      BaseStyle->{"Text", FontColor -> LightDarkSwitched[
          GrayLevel[0.35], 
          GrayLevel[0.8602474]]},
      ImageMargins->5,
      ImageSize->{Full, Automatic}]}
   },
   AutoDelete->False,
   GridBoxBackground->{"Columns" -> {{
        LightDarkSwitched[
         GrayLevel[1], 
         GrayLevel[0.278317]]}}},
   GridBoxDividers->{"ColumnsIndexed" -> {1 -> Directive[
         LightDarkSwitched[
          RGBColor[0.87, 0.94, 1], 
          RGBColor[0.2491127, 0.3295188, 0.4231198]], 
         AbsoluteThickness[4]]}, "Rows" -> {{False}}},
   GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}]], 
  "BlockQuote",
  Background->None,ExpressionUUID->"35d1aecc-54df-a14d-a55a-d22c5bbe8e37"],
 "\nThat is why the notebook separates the framework into six sectors. It is \
trying to prevent \[OpenCurlyDoubleQuote]field,\[CloseCurlyDoubleQuote] \
\[OpenCurlyDoubleQuote]resonance,\[CloseCurlyDoubleQuote] \
\[OpenCurlyDoubleQuote]measurement,\[CloseCurlyDoubleQuote] and \
\[OpenCurlyDoubleQuote]vortex\[CloseCurlyDoubleQuote] from all being used as \
synonyms. \n",
 Cell[BoxData[
  TagBox[GridBox[{
     {
      TemplateBox[{0},
       "Spacer1"]},
     {
      TemplateBox[{0},
       "Spacer1"]}
    },
    AutoDelete->False,
    FrameStyle->Directive[
      LightDarkSwitched[
       GrayLevel[0.8], 
       GrayLevel[0.4867756]], 
      AbsoluteThickness[1]],
    GridBoxDividers->{
     "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
    GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
   "Grid"]], "MarkdownDelimiter",
  ShowStringCharacters->False,
  Background->None,ExpressionUUID->"86ef2f43-b9a7-8c4b-b8a2-b2b19b1b94e4"],
 "\n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"2. How deterministic structures emerge in this \
framework\"\>", "Title",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->26],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"a1f516b5-e58c-4a4c-a0f8-61998cfe7f76"],
 "\nYour phrase \[OpenCurlyDoubleQuote]deterministic structures of \
hyperdimensional information\[CloseCurlyDoubleQuote] can be interpreted in a \
way that matches the notebook.\n\nThe notebook does ",
 StyleBox["not",
  FontWeight->Bold],
 " directly prove infinite-dimensional consciousness-like structure. But it \
does give a pathway for how high-dimensional structured information can \
become ",
 StyleBox["deterministically organized",
  FontWeight->Bold],
 ".\n\nThat pathway is: \n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"A. Geometry defines the allowed relational arena\"\>", 
    "Section",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->22],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"31e0071d-c10f-4949-9392-0424a0afc16b"],
 "\nThe geometry layer introduces sphere, torus, lattice/graph possibilities.\
\n\nThis means: \n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "a ",
  StyleBox["sphere",
   FontWeight->Bold],
  " models closed isotropic enclosure,"
 }], "InlineItem",ExpressionUUID->"9a520a2f-b8a7-3e40-b1da-a7a1f1ea2e7c"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "a ",
  StyleBox["torus",
   FontWeight->Bold],
  " models recirculating or doubly periodic organization,"
 }], "InlineItem",ExpressionUUID->"34c0f1c9-c268-2a4b-b2f5-ec82ab985d0f"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "discrete networks model coupled systems with finite local connectivity."
 }], "InlineItem",ExpressionUUID->"41d838e7-06d8-764b-92c1-71a011b32dac"],
 "\nWhy this matters:\n\nA field cannot form arbitrary patterns independent \
of its domain. The domain restricts what stable organization is possible.\n\n\
So the first source of determinism is: \n",
 Cell[BoxData[GridBox[{
    {
     PaneBox[Cell[TextData[StyleBox[
      "boundary and topology constrain possibility space",
       FontWeight->Bold]],
       Background->None,ExpressionUUID->
       "6d86a547-c6f4-f340-94fd-2ad0680b407b"],
      BaseStyle->{"Text", FontColor -> LightDarkSwitched[
          GrayLevel[0.35], 
          GrayLevel[0.8602474]]},
      ImageMargins->5,
      ImageSize->{Full, Automatic}]}
   },
   AutoDelete->False,
   GridBoxBackground->{"Columns" -> {{
        LightDarkSwitched[
         GrayLevel[1], 
         GrayLevel[0.278317]]}}},
   GridBoxDividers->{"ColumnsIndexed" -> {1 -> Directive[
         LightDarkSwitched[
          RGBColor[0.87, 0.94, 1], 
          RGBColor[0.2491127, 0.3295188, 0.4231198]], 
         AbsoluteThickness[4]]}, "Rows" -> {{False}}},
   GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}]], 
  "BlockQuote",
  Background->None,ExpressionUUID->"d765d8f8-0fff-a64d-ad47-8c8227169574"],
 "\nThis is already enough to rule out the idea that all information \
structures are equally available. \n",
 Cell[BoxData[
  TagBox[GridBox[{
     {
      TemplateBox[{0},
       "Spacer1"]},
     {
      TemplateBox[{0},
       "Spacer1"]}
    },
    AutoDelete->False,
    FrameStyle->Directive[
      LightDarkSwitched[
       GrayLevel[0.8], 
       GrayLevel[0.4867756]], 
      AbsoluteThickness[1]],
    GridBoxDividers->{
     "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
    GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
   "Grid"]], "MarkdownDelimiter",
  ShowStringCharacters->False,
  Background->None,ExpressionUUID->"521f3ab9-862b-6a4c-a2bb-c9015959bec2"],
 "\n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"B. The operator filters which patterns persist\"\>", 
    "Section",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->22],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"6151838c-aa80-6f4d-9617-52837457232a"],
 "\nThe notebook\[CloseCurlyQuote]s central dynamical form is \n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubsuperscriptBox["\[PartialD]", 
          StyleBox["t", "TI"], "2"], 
         StyleBox["u", "TI"], "+", "2", "\[Gamma]", 
         SubscriptBox["\[PartialD]", 
          StyleBox["t", "TI"]], 
         StyleBox["u", "TI"], "+", 
         StyleBox["L", "TI"], 
         StyleBox["u", "TI"], "+", 
         StyleBox["N", "TI"], 
         RowBox[{"(", 
           StyleBox["u", "TI"], ")"}], "\[LongEqual]", 
         StyleBox["f", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\partial_t^2 u + 2\\gamma \\partial_t u + \\mathcal{L}u + \
\\mathcal{N}(u) = f", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "306c90f9-406d-0b4f-a6ef-f7ad4ded2d49"],
 "\nThis is the real engine.\n\nHere: \n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  Cell[BoxData[
   FormBox[
    TemplateBox[<|"boxes" -> FormBox[
        StyleBox["u", "TI"], TraditionalForm], "errors" -> {}, "input" -> "u",
       "state" -> "Boxes"|>,
     "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
   "9ade116a-f5bb-7a48-a429-1150123cd4e7"],
  " is the field state,"
 }], "InlineItem",ExpressionUUID->"77ec1e57-1a56-144a-b0e2-a398a1fd4b71"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  Cell[BoxData[
   FormBox[
    TemplateBox[<|"boxes" -> FormBox[
        StyleBox["L", "TI"], TraditionalForm], "errors" -> {}, "input" -> 
      "\\mathcal{L}", "state" -> "Boxes"|>,
     "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
   "715e8417-8188-ee4e-907f-5c2b64311b76"],
  " gives the linear structure,"
 }], "InlineItem",ExpressionUUID->"f778f600-9ef8-3748-b98f-735ff9284c68"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  Cell[BoxData[
   FormBox[
    TemplateBox[<|"boxes" -> FormBox[
        RowBox[{
          StyleBox["N", "TI"], "(", 
          StyleBox["u", "TI"], ")"}], TraditionalForm], "errors" -> {}, 
      "input" -> "\\mathcal{N}(u)", "state" -> "Boxes"|>,
     "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
   "27910785-abb5-614d-8d85-84649b047489"],
  " gives nonlinear coupling,"
 }], "InlineItem",ExpressionUUID->"189138e9-1e62-e24a-8d01-c377c379452b"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  Cell[BoxData[
   FormBox[
    TemplateBox[<|"boxes" -> FormBox[
        StyleBox["f", "TI"], TraditionalForm], "errors" -> {}, "input" -> "f",
       "state" -> "Boxes"|>,
     "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
   "d0542e79-cf2f-3949-ac25-78f531704d01"],
  " injects forcing,"
 }], "InlineItem",ExpressionUUID->"9ab121e6-2c37-dd4c-b3ab-55442437f537"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  Cell[BoxData[
   FormBox[
    TemplateBox[<|
     "boxes" -> FormBox["\[Gamma]", TraditionalForm], "errors" -> {}, "input" -> 
      "\\gamma", "state" -> "Boxes"|>,
     "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
   "a609e151-02a7-034f-bb96-38a48695de0f"],
  " damps unstable persistence."
 }], "InlineItem",ExpressionUUID->"214c500a-7952-0a4c-88de-fd973eae27f7"],
 "\nThe important thing is that the field does ",
 StyleBox["not",
  FontWeight->Bold],
 " keep all patterns. It performs a kind of filtering.\n\nThrough the \
eigenstructure of ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["L", "TI"], TraditionalForm], "errors" -> {}, "input" -> 
     "\\mathcal{L}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "48c0fef6-4d52-c043-a550-98d0d20fd5f5"],
 ": \n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "some modes decay,"
 }], "InlineItem",ExpressionUUID->"49b3c74b-e049-1548-9bed-c5f4ce35d9ec"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "some modes oscillate,"
 }], "InlineItem",ExpressionUUID->"b1614036-a8ed-414e-82d0-3aec7d9f641e"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "some modes dominate,"
 }], "InlineItem",ExpressionUUID->"0120345f-e2ff-9441-bf67-18b3f9ab48e3"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "some disappear."
 }], "InlineItem",ExpressionUUID->"4b1c47d0-8b54-9140-918e-4e5a55fdce2d"],
 "\nThat is the second source of determinism: \n",
 Cell[BoxData[GridBox[{
    {
     PaneBox[Cell[TextData[StyleBox[
      "spectral selection reduces high-dimensional possibility into a \
restricted persistent mode set",
       FontWeight->Bold]],
       Background->None,ExpressionUUID->
       "5f631121-0f6c-704c-89ae-1488ded3c35e"],
      BaseStyle->{"Text", FontColor -> LightDarkSwitched[
          GrayLevel[0.35], 
          GrayLevel[0.8602474]]},
      ImageMargins->5,
      ImageSize->{Full, Automatic}]}
   },
   AutoDelete->False,
   GridBoxBackground->{"Columns" -> {{
        LightDarkSwitched[
         GrayLevel[1], 
         GrayLevel[0.278317]]}}},
   GridBoxDividers->{"ColumnsIndexed" -> {1 -> Directive[
         LightDarkSwitched[
          RGBColor[0.87, 0.94, 1], 
          RGBColor[0.2491127, 0.3295188, 0.4231198]], 
         AbsoluteThickness[4]]}, "Rows" -> {{False}}},
   GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}]], 
  "BlockQuote",
  Background->None,ExpressionUUID->"7f416406-d460-b74b-b512-e899168681ef"],
 "\nSo if you call the original state space \
\[OpenCurlyDoubleQuote]hyperdimensional information,\[CloseCurlyDoubleQuote] \
the actual observed structures are the subset that survive the spectral \
filter. \n",
 Cell[BoxData[
  TagBox[GridBox[{
     {
      TemplateBox[{0},
       "Spacer1"]},
     {
      TemplateBox[{0},
       "Spacer1"]}
    },
    AutoDelete->False,
    FrameStyle->Directive[
      LightDarkSwitched[
       GrayLevel[0.8], 
       GrayLevel[0.4867756]], 
      AbsoluteThickness[1]],
    GridBoxDividers->{
     "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
    GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
   "Grid"]], "MarkdownDelimiter",
  ShowStringCharacters->False,
  Background->None,ExpressionUUID->"dad65a15-dd99-1549-8a9c-f3cb8ae9c71e"],
 "\n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"C. Stability turns possibility into repeatable \
structure\"\>", "Section",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->22],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"7a82a2a0-3440-3140-815c-46443259bd9c"],
 "\nThe notebook computes eigenvalues and checks continuous/discrete \
stability.\n\nThis matters because deterministic structure is not just \
\[OpenCurlyDoubleQuote]a pattern exists once.\[CloseCurlyDoubleQuote] It \
means: \n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "the pattern is reproducible,"
 }], "InlineItem",ExpressionUUID->"34325686-cd10-e547-80ce-931a8b8714b7"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "it resists perturbation,"
 }], "InlineItem",ExpressionUUID->"4007b307-8201-2a47-9da2-d04650bd7c84"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "it does not drift arbitrarily under truncation,"
 }], "InlineItem",ExpressionUUID->"141f92a3-fa43-0842-9757-f6d730c5ad08"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "it persists under the system\[CloseCurlyQuote]s own update law."
 }], "InlineItem",ExpressionUUID->"2d2deb04-f60f-f946-a027-2e38bc4af454"],
 "\nThat is why the spectral convergence report is crucial. It asks whether \
stability conclusions are robust as the truncation changes.\n\nThis is one of \
the strongest parts of the notebook: \n",
 Cell[BoxData[GridBox[{
    {
     PaneBox["\<\"it refuses to call something real if it is just a \
discretization artifact.\"\>",
      BaseStyle->{"Text", FontColor -> LightDarkSwitched[
          GrayLevel[0.35], 
          GrayLevel[0.8602474]]},
      ImageMargins->5,
      ImageSize->{Full, Automatic}]}
   },
   AutoDelete->False,
   GridBoxBackground->{"Columns" -> {{
        LightDarkSwitched[
         GrayLevel[1], 
         GrayLevel[0.278317]]}}},
   GridBoxDividers->{"ColumnsIndexed" -> {1 -> Directive[
         LightDarkSwitched[
          RGBColor[0.87, 0.94, 1], 
          RGBColor[0.2491127, 0.3295188, 0.4231198]], 
         AbsoluteThickness[4]]}, "Rows" -> {{False}}},
   GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}]], 
  "BlockQuote",
  Background->None,ExpressionUUID->"a33b19bb-1e67-1049-b16e-3b007065dfd0"],
 "\nSo deterministic structure here means not merely symbolic elegance, but: \
\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  StyleBox["spectrally admissible",
   FontWeight->Bold]
 }], "InlineItem",ExpressionUUID->"3ae92ced-5095-0f4a-b535-4ce4fd615c31"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  StyleBox["numerically stable",
   FontWeight->Bold]
 }], "InlineItem",ExpressionUUID->"58774f51-e723-b046-99b3-ff2e31ff19c5"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  StyleBox["truncation robust",
   FontWeight->Bold]
 }], "InlineItem",ExpressionUUID->"d98fc729-fe71-374a-9894-cd76700b868e"],
 "\n",
 Cell[BoxData[
  TagBox[GridBox[{
     {
      TemplateBox[{0},
       "Spacer1"]},
     {
      TemplateBox[{0},
       "Spacer1"]}
    },
    AutoDelete->False,
    FrameStyle->Directive[
      LightDarkSwitched[
       GrayLevel[0.8], 
       GrayLevel[0.4867756]], 
      AbsoluteThickness[1]],
    GridBoxDividers->{
     "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
    GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
   "Grid"]], "MarkdownDelimiter",
  ShowStringCharacters->False,
  Background->None,ExpressionUUID->"90a3e307-74f6-204f-827a-84215283c074"],
 "\n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"D. Scale robustness gives multiscale identity\"\>", "Section",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->22],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"59de2599-a7b9-e245-af06-94366e830b22"],
 "\nThis is where the notebook becomes especially relevant to your phrase \
\[OpenCurlyDoubleQuote]multiscale dynamics.\[CloseCurlyDoubleQuote]\n\nThe \
dyadic coarse-graining section asks: \n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "if I compress the state across scale,"
 }], "InlineItem",ExpressionUUID->"43630d7e-14b1-8d4e-b9fa-dc5a2cf21cb9"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "does the essential pattern survive,"
 }], "InlineItem",ExpressionUUID->"7cddc553-4c8e-6547-a5b8-d317dd7fc042"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "or was it only a fine-grained accident?"
 }], "InlineItem",ExpressionUUID->"0b13dba1-16dc-a04e-b697-f8fb4f7f37e4"],
 "\nThe functions like ",
 Cell[BoxData[
  TemplateBox[{
    Cell["dyadicCoarseGrain", Background -> None]},
   "ChatCodeInlineTemplate"]], "ChatCodeActive",ExpressionUUID->
  "28d8e1ec-aa76-ca41-8dfe-5d37fc9550e0"],
 ", ",
 Cell[BoxData[
  TemplateBox[{
    Cell["rgOrbit", Background -> None]},
   "ChatCodeInlineTemplate"]], "ChatCodeActive",ExpressionUUID->
  "2e184a45-9d35-fc4e-ac05-cba09876eab8"],
 ", ",
 Cell[BoxData[
  TemplateBox[{
    Cell["scaleResiduals", Background -> None]},
   "ChatCodeInlineTemplate"]], "ChatCodeActive",ExpressionUUID->
  "1c32875c-9b92-8c4d-9317-d1463dec6df2"],
 ", and ",
 Cell[BoxData[
  TemplateBox[{
    Cell["fixedScaleResidual", Background -> None]},
   "ChatCodeInlineTemplate"]], "ChatCodeActive",ExpressionUUID->
  "192193ee-64f8-5d4e-bc3a-96f6204be5ee"],
 " are really a simple renormalization-style test.\n\nSo a structure becomes \
\[OpenCurlyDoubleQuote]multiscale deterministic\[CloseCurlyDoubleQuote] when:\
\n\n1. it exists at one resolution,\n2. it maps into comparable form at \
another resolution,\n3. the residual between scales remains small.\n\nThis is \
extremely important conceptually.\n\nBecause now the field is not just \
storing local data. It is producing ",
 StyleBox["scale-coherent organization",
  FontWeight->Bold],
 ".\n\nSo the sensory field, under this interpretation, creates deterministic \
structure by enforcing: \n",
 Cell[BoxData[GridBox[{
    {
     PaneBox[Cell[TextData[StyleBox[
      "cross-scale self-similarity or at least cross-scale persistence of \
organizational signature",
       FontWeight->Bold]],
       Background->None,ExpressionUUID->
       "3550db20-4259-7d41-bd44-a90ee3d331a1"],
      BaseStyle->{"Text", FontColor -> LightDarkSwitched[
          GrayLevel[0.35], 
          GrayLevel[0.8602474]]},
      ImageMargins->5,
      ImageSize->{Full, Automatic}]}
   },
   AutoDelete->False,
   GridBoxBackground->{"Columns" -> {{
        LightDarkSwitched[
         GrayLevel[1], 
         GrayLevel[0.278317]]}}},
   GridBoxDividers->{"ColumnsIndexed" -> {1 -> Directive[
         LightDarkSwitched[
          RGBColor[0.87, 0.94, 1], 
          RGBColor[0.2491127, 0.3295188, 0.4231198]], 
         AbsoluteThickness[4]]}, "Rows" -> {{False}}},
   GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}]], 
  "BlockQuote",
  Background->None,ExpressionUUID->"36d78165-fcf3-2247-9caa-77077d5d2032"],
 "\nThat is the closest rigorous version of \
\[OpenCurlyDoubleQuote]hyperdimensional information collapses into structure.\
\[CloseCurlyDoubleQuote] \n",
 Cell[BoxData[
  TagBox[GridBox[{
     {
      TemplateBox[{0},
       "Spacer1"]},
     {
      TemplateBox[{0},
       "Spacer1"]}
    },
    AutoDelete->False,
    FrameStyle->Directive[
      LightDarkSwitched[
       GrayLevel[0.8], 
       GrayLevel[0.4867756]], 
      AbsoluteThickness[1]],
    GridBoxDividers->{
     "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
    GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
   "Grid"]], "MarkdownDelimiter",
  ShowStringCharacters->False,
  Background->None,ExpressionUUID->"083f316a-0ecf-734e-9c75-10ab9f22fd5f"],
 "\n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"E. Repeated interaction selects pointer-like states\"\>", 
    "Section",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->22],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"6041574b-2b12-0a43-8069-9a35a5995d2d"],
 "\nThe selection-stability sector is basically the \
notebook\[CloseCurlyQuote]s version of recurrent measurement or repeated \
coupling.\n\nThe terminology correction tells you exactly how to read it: \n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "not \[OpenCurlyDoubleQuote]measured into existence\[CloseCurlyDoubleQuote]"
 }], "InlineItem",ExpressionUUID->"495c7e88-c57c-c74d-a339-57f8c319618c"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "but ",
  StyleBox["persistence under interaction / channel-stable realization",
   FontWeight->Bold]
 }], "InlineItem",ExpressionUUID->"080433ba-faa9-f242-a5e5-35381e3651b4"],
 "\nThis is one of the most important conceptual moves in the whole notebook.\
\n\nA sensory field is not just geometry plus waves. It is also ",
 StyleBox["selection under recurrence",
  FontWeight->Bold],
 ".\n\nThat means: \n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "many candidate states can exist,"
 }], "InlineItem",ExpressionUUID->"317b54b0-4811-ec47-b330-ce235055f526"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "repeated interaction suppresses some,"
 }], "InlineItem",ExpressionUUID->"fff488a5-1ab4-a84f-a139-8685d07f6c94"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "preferred states remain."
 }], "InlineItem",ExpressionUUID->"59b4fda6-de31-5143-881c-93928917a077"],
 "\nThis is very close to a general concept of pointer-state selection, even \
if the notebook remains abstract.\n\nSo deterministic structures emerge not \
only because they are resonant, but because they are: \n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  StyleBox["interaction-compatible",
   FontWeight->Bold]
 }], "InlineItem",ExpressionUUID->"78d22362-e192-b548-9ab5-0ad10068b5af"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  StyleBox["recurrently recoverable",
   FontWeight->Bold]
 }], "InlineItem",ExpressionUUID->"bb0fbc3d-ee8e-d344-92c3-bf669a710bc7"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  StyleBox["less fragile under phase disturbance",
   FontWeight->Bold]
 }], "InlineItem",ExpressionUUID->"49eb1859-9e87-254d-891f-4fe1ef6405f8"],
 "\nThis is what the notebook means by selection stability. \n",
 Cell[BoxData[
  TagBox[GridBox[{
     {
      TemplateBox[{0},
       "Spacer1"]},
     {
      TemplateBox[{0},
       "Spacer1"]}
    },
    AutoDelete->False,
    FrameStyle->Directive[
      LightDarkSwitched[
       GrayLevel[0.8], 
       GrayLevel[0.4867756]], 
      AbsoluteThickness[1]],
    GridBoxDividers->{
     "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
    GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
   "Grid"]], "MarkdownDelimiter",
  ShowStringCharacters->False,
  Background->None,ExpressionUUID->"f2819045-2183-2c49-b774-004104d3ad69"],
 "\n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"3. So what is \[OpenCurlyDoubleQuote]hyperdimensional \
information\[CloseCurlyDoubleQuote] here?\"\>", "Title",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->26],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"8435b2f3-a9c5-6d4b-bbe1-c9f66352ac6d"],
 "\nIf we stay faithful to the notebook, \
\[OpenCurlyDoubleQuote]hyperdimensional information\[CloseCurlyDoubleQuote] \
should not be treated as a proven literal extra spatial dimension.\n\nA more \
rigorous reading is: \n",
 Cell[BoxData[GridBox[{
    {
     PaneBox["\<\"a high-dimensional state space of possible relational \
configurations, modal amplitudes, phases, couplings, and cross-scale \
encodings.\"\>",
      BaseStyle->{"Text", FontColor -> LightDarkSwitched[
          GrayLevel[0.35], 
          GrayLevel[0.8602474]]},
      ImageMargins->5,
      ImageSize->{Full, Automatic}]}
   },
   AutoDelete->False,
   GridBoxBackground->{"Columns" -> {{
        LightDarkSwitched[
         GrayLevel[1], 
         GrayLevel[0.278317]]}}},
   GridBoxDividers->{"ColumnsIndexed" -> {1 -> Directive[
         LightDarkSwitched[
          RGBColor[0.87, 0.94, 1], 
          RGBColor[0.2491127, 0.3295188, 0.4231198]], 
         AbsoluteThickness[4]]}, "Rows" -> {{False}}},
   GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}]], 
  "BlockQuote",
  Background->None,ExpressionUUID->"c0a694ce-dffe-2543-a4b4-9e93272b791d"],
 "\nSo \[OpenCurlyDoubleQuote]hyperdimensional\[CloseCurlyDoubleQuote] here \
can mean: \n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "many modes,"
 }], "InlineItem",ExpressionUUID->"80eec5bd-1268-a84c-a494-e2d25ab505af"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "many coupled variables,"
 }], "InlineItem",ExpressionUUID->"cc5ba708-1510-2747-a05e-ced3fb895264"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "many scales,"
 }], "InlineItem",ExpressionUUID->"71dfb3b5-82c0-2547-8180-a25382b516ec"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "many phase relations,"
 }], "InlineItem",ExpressionUUID->"ef1062eb-d377-ae4c-acbe-490479d68317"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "many topological configurations."
 }], "InlineItem",ExpressionUUID->"db013775-a6e2-bf4c-84c6-461b7233b53d"],
 "\nThe field is \[OpenCurlyDoubleQuote]hyperdimensional\
\[CloseCurlyDoubleQuote] not necessarily because it lives in 11D physical \
space, but because its ",
 StyleBox["state description",
  FontWeight->Bold],
 " is high-dimensional.\n\nThen deterministic structures are: \n",
 Cell[BoxData[GridBox[{
    {
     PaneBox["\<\"low-dimensional attractively persistent organizations \
carved out of that high-dimensional possibility space.\"\>",
      BaseStyle->{"Text", FontColor -> LightDarkSwitched[
          GrayLevel[0.35], 
          GrayLevel[0.8602474]]},
      ImageMargins->5,
      ImageSize->{Full, Automatic}]}
   },
   AutoDelete->False,
   GridBoxBackground->{"Columns" -> {{
        LightDarkSwitched[
         GrayLevel[1], 
         GrayLevel[0.278317]]}}},
   GridBoxDividers->{"ColumnsIndexed" -> {1 -> Directive[
         LightDarkSwitched[
          RGBColor[0.87, 0.94, 1], 
          RGBColor[0.2491127, 0.3295188, 0.4231198]], 
         AbsoluteThickness[4]]}, "Rows" -> {{False}}},
   GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}]], 
  "BlockQuote",
  Background->None,ExpressionUUID->"8a2826eb-5a07-4a4d-9803-0f24a30e36a4"],
 "\nThat is a mathematically respectable interpretation. \n",
 Cell[BoxData[
  TagBox[GridBox[{
     {
      TemplateBox[{0},
       "Spacer1"]},
     {
      TemplateBox[{0},
       "Spacer1"]}
    },
    AutoDelete->False,
    FrameStyle->Directive[
      LightDarkSwitched[
       GrayLevel[0.8], 
       GrayLevel[0.4867756]], 
      AbsoluteThickness[1]],
    GridBoxDividers->{
     "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
    GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
   "Grid"]], "MarkdownDelimiter",
  ShowStringCharacters->False,
  Background->None,ExpressionUUID->"d24cdb31-3243-0b4c-8bcb-ccfceb5455b9"],
 "\n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"4. How the notebook\[CloseCurlyQuote]s \
\[OpenCurlyDoubleQuote]sensory field\[CloseCurlyDoubleQuote] actually \
functions\"\>", "Title",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->26],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"3232e1fe-4822-4f42-a1f5-b5dac03a05b5"],
 "\nLet me phrase its functionality in layers. \n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"Layer 1: receptivity\"\>", "Section",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->22],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"c6312eba-09b2-4f4c-8bab-c817dc473920"],
 "\nThe field is a ",
 StyleBox["receptive medium",
  FontWeight->Bold],
 " because it can host perturbations, sources, and distributed states.\n\nIn \
the notebook this appears through: \n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "source fields,"
 }], "InlineItem",ExpressionUUID->"ad6c0e73-9b94-2d4f-b5f2-2b8febb0c35b"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "effective potentials,"
 }], "InlineItem",ExpressionUUID->"5664280c-6162-f04f-ad1c-696c58ac652b"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "PDE states,"
 }], "InlineItem",ExpressionUUID->"5076c998-b7d8-4a4c-b3be-b1ef7cb9b21b"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "matrix surrogates,"
 }], "InlineItem",ExpressionUUID->"e882d916-954f-7847-81bd-a3fcd3268f34"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "density-like state descriptions."
 }], "InlineItem",ExpressionUUID->"2cc80c2e-6879-374a-9e3c-ed027648fa0d"],
 "\nSo the field \[OpenCurlyDoubleQuote]senses\[CloseCurlyDoubleQuote] \
because it is responsive to structured input. \n",
 Cell[BoxData[
  TagBox[GridBox[{
     {
      TemplateBox[{0},
       "Spacer1"]},
     {
      TemplateBox[{0},
       "Spacer1"]}
    },
    AutoDelete->False,
    FrameStyle->Directive[
      LightDarkSwitched[
       GrayLevel[0.8], 
       GrayLevel[0.4867756]], 
      AbsoluteThickness[1]],
    GridBoxDividers->{
     "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
    GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
   "Grid"]], "MarkdownDelimiter",
  ShowStringCharacters->False,
  Background->None,ExpressionUUID->"cd6989a4-f296-f240-8033-4af9ad97b72a"],
 "\n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"Layer 2: discrimination\"\>", "Section",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->22],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"4460ca45-8fe1-eb48-a55f-0a8a5f8e9eb8"],
 "\nNot all perturbations are equivalent.\n\nThe operator structure and \
geometry discriminate among them via: \n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "eigenmodes,"
 }], "InlineItem",ExpressionUUID->"947032a6-1d7f-6246-958d-03044b92ba47"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "damping rates,"
 }], "InlineItem",ExpressionUUID->"470bdccf-3d08-c147-9375-40d3a008e140"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "resonance,"
 }], "InlineItem",ExpressionUUID->"74ddbde2-1ee6-9745-8757-5505a9a1a89d"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "curvature/topology constraints,"
 }], "InlineItem",ExpressionUUID->"af836e49-9f1e-3d47-9fe5-3ddcfbcdcae3"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "coarse-graining behavior."
 }], "InlineItem",ExpressionUUID->"1b4b061e-6735-264c-9764-ebdf3d603e51"],
 "\nSo the field \[OpenCurlyDoubleQuote]detects\[CloseCurlyDoubleQuote] by ",
 StyleBox["responding differently to different relational patterns",
  FontWeight->Bold],
 ". \n",
 Cell[BoxData[
  TagBox[GridBox[{
     {
      TemplateBox[{0},
       "Spacer1"]},
     {
      TemplateBox[{0},
       "Spacer1"]}
    },
    AutoDelete->False,
    FrameStyle->Directive[
      LightDarkSwitched[
       GrayLevel[0.8], 
       GrayLevel[0.4867756]], 
      AbsoluteThickness[1]],
    GridBoxDividers->{
     "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
    GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
   "Grid"]], "MarkdownDelimiter",
  ShowStringCharacters->False,
  Background->None,ExpressionUUID->"30b4dd8d-35d9-454b-b6cd-6d56e45901d8"],
 "\n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"Layer 3: memory-like persistence\"\>", "Section",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->22],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"a91ffbdc-a61a-6046-be98-b686d3e0eb8d"],
 "\nIf a perturbation excites a persistent mode, the field retains structured \
influence longer than transient noise.\n\nThis is captured by: \n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "spectral persistence,"
 }], "InlineItem",ExpressionUUID->"0577ba35-ed7c-e640-b474-4c7dea3a0466"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "high ",
  Cell[BoxData[
   TemplateBox[{
     Cell["qFactor", Background -> None]},
    "ChatCodeInlineTemplate"]], "ChatCodeActive",ExpressionUUID->
   "725cd35e-095e-9545-bcd5-4cbd6fc0259e"],
  ","
 }], "InlineItem",ExpressionUUID->"f12e5fd9-508d-9247-bea7-19efb7c9fc10"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "metastable basins,"
 }], "InlineItem",ExpressionUUID->"30ed1303-e848-0347-a206-81b5cbb6370a"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "equilibrium pockets."
 }], "InlineItem",ExpressionUUID->"5152fd4a-f3f3-3844-aaa4-98cfdf3f9f57"],
 "\nSo the field \[OpenCurlyDoubleQuote]remembers\[CloseCurlyDoubleQuote] not \
symbolically, but dynamically. \n",
 Cell[BoxData[
  TagBox[GridBox[{
     {
      TemplateBox[{0},
       "Spacer1"]},
     {
      TemplateBox[{0},
       "Spacer1"]}
    },
    AutoDelete->False,
    FrameStyle->Directive[
      LightDarkSwitched[
       GrayLevel[0.8], 
       GrayLevel[0.4867756]], 
      AbsoluteThickness[1]],
    GridBoxDividers->{
     "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
    GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
   "Grid"]], "MarkdownDelimiter",
  ShowStringCharacters->False,
  Background->None,ExpressionUUID->"5f22f192-508d-6f4e-a7c2-288af520d44c"],
 "\n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"Layer 4: self-selection\"\>", "Section",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->22],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"f95d084b-31dd-d94b-8d8c-ccece5b92218"],
 "\nRepeated interaction modifies which states remain coherent.\n\nThat is \
the role of: \n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "phase schedules,"
 }], "InlineItem",ExpressionUUID->"d913b977-5e80-f745-b621-44d5e9427023"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "dephasing,"
 }], "InlineItem",ExpressionUUID->"6ddc31af-7c1e-884d-8d2f-12567bd03297"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "pointer weights,"
 }], "InlineItem",ExpressionUUID->"b794f709-2e10-754d-a02e-f64539a518c5"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "coherence decay diagnostics."
 }], "InlineItem",ExpressionUUID->"51bf2f29-58dc-0e4f-b8fc-166dc2c64503"],
 "\nSo the field \[OpenCurlyDoubleQuote]measures\[CloseCurlyDoubleQuote] \
internally by favoring self-consistent channels. \n",
 Cell[BoxData[
  TagBox[GridBox[{
     {
      TemplateBox[{0},
       "Spacer1"]},
     {
      TemplateBox[{0},
       "Spacer1"]}
    },
    AutoDelete->False,
    FrameStyle->Directive[
      LightDarkSwitched[
       GrayLevel[0.8], 
       GrayLevel[0.4867756]], 
      AbsoluteThickness[1]],
    GridBoxDividers->{
     "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
    GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
   "Grid"]], "MarkdownDelimiter",
  ShowStringCharacters->False,
  Background->None,ExpressionUUID->"1b02b422-f94a-7740-8562-2b2f06dd9cd4"],
 "\n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"Layer 5: topological organization\"\>", "Section",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->22],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"27dcb227-c077-0949-bd3f-e88dc1a30777"],
 "\nOnce you add effective potentials and circulation, the field is no longer \
just a passive container.\n\nIt develops: \n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "flow channels,"
 }], "InlineItem",ExpressionUUID->"7622ae3d-8f1c-8e43-a5d0-5c7723f0202b"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "pockets,"
 }], "InlineItem",ExpressionUUID->"4369b846-cd91-9f44-8aed-75415ad52f27"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "circulation zones,"
 }], "InlineItem",ExpressionUUID->"2b14a504-cd60-9f4f-966e-b00dadaa503c"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "winding structures,"
 }], "InlineItem",ExpressionUUID->"e8efd69d-f2fb-ff4a-b2a4-82ecb28326d4"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "basin architecture."
 }], "InlineItem",ExpressionUUID->"22a6e85a-8d6f-0747-8874-425abe2f90e1"],
 "\nSo the sensory field becomes a ",
 StyleBox["structured topology of possible trajectories and dwell regions",
  FontWeight->Bold],
 ".\n\nThis is probably closest to the notebook\[CloseCurlyQuote]s mature \
notion of a sensory field:\nnot a raw sensorium, but a ",
 StyleBox["topological dynamical organization of detectability and \
persistence",
  FontWeight->Bold],
 ". \n",
 Cell[BoxData[
  TagBox[GridBox[{
     {
      TemplateBox[{0},
       "Spacer1"]},
     {
      TemplateBox[{0},
       "Spacer1"]}
    },
    AutoDelete->False,
    FrameStyle->Directive[
      LightDarkSwitched[
       GrayLevel[0.8], 
       GrayLevel[0.4867756]], 
      AbsoluteThickness[1]],
    GridBoxDividers->{
     "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
    GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
   "Grid"]], "MarkdownDelimiter",
  ShowStringCharacters->False,
  Background->None,ExpressionUUID->"63dc9b91-a177-d44d-862e-17a3b160fe12"],
 "\n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"Layer 6: synthesis\"\>", "Section",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->22],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"bcd1bea3-b525-4646-a369-83a71158d6b3"],
 "\nFinally the notebook checks whether the different notions of structure \
agree.\n\nThat is what ",
 Cell[BoxData[
  TemplateBox[{
    Cell["multiscaleResonanceReport", Background -> None]},
   "ChatCodeInlineTemplate"]], "ChatCodeActive",ExpressionUUID->
  "59f4edba-0a09-654d-bab4-46c3418e00ef"],
 " does.\n\nIt asks whether a candidate pattern is simultaneously: \n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "spectrally stable,"
 }], "InlineItem",ExpressionUUID->"47962ebd-e811-fd4a-a051-97d14d3db2b2"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "scale robust,"
 }], "InlineItem",ExpressionUUID->"d02be03c-9e55-8342-9cfa-d27c9821f742"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "selection stable."
 }], "InlineItem",ExpressionUUID->"46895c01-2391-1b4f-81c9-6e590c3616c9"],
 "\nThis is a very important design choice.\n\nIt means the field does not \
\[OpenCurlyDoubleQuote]declare reality\[CloseCurlyDoubleQuote] from one \
diagnostic alone.\n\nInstead, it tries to identify structures that survive ",
 StyleBox["multiple independent tests",
  FontWeight->Bold],
 ".\n\nThat is the deepest functional claim in the notebook. \n",
 Cell[BoxData[
  TagBox[GridBox[{
     {
      TemplateBox[{0},
       "Spacer1"]},
     {
      TemplateBox[{0},
       "Spacer1"]}
    },
    AutoDelete->False,
    FrameStyle->Directive[
      LightDarkSwitched[
       GrayLevel[0.8], 
       GrayLevel[0.4867756]], 
      AbsoluteThickness[1]],
    GridBoxDividers->{
     "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
    GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
   "Grid"]], "MarkdownDelimiter",
  ShowStringCharacters->False,
  Background->None,ExpressionUUID->"8d5ca9a2-228f-7542-b721-2e411aacf650"],
 "\n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"5. Why this can be described as creating deterministic \
structures\"\>", "Title",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->26],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"eaf74e1e-80ad-a747-9066-ddc4c675dbed"],
 "\nNow I\[CloseCurlyQuote]ll answer your wording directly.\n\nThe sensory \
field \[OpenCurlyDoubleQuote]creates deterministic structures\
\[CloseCurlyDoubleQuote] in this framework because it acts as a ",
 StyleBox["constraint-and-selection system",
  FontWeight->Bold],
 ".\n\nA raw high-dimensional possibility space is too unconstrained to yield \
meaningful persistent organization. The field imposes structure through:\n\n\
1. ",
 StyleBox["geometric constraints",
  FontWeight->Bold],
 "\n2. ",
 StyleBox["spectral filtering",
  FontWeight->Bold],
 "\n3. ",
 StyleBox["damping-based persistence selection",
  FontWeight->Bold],
 "\n4. ",
 StyleBox["multiscale robustness constraints",
  FontWeight->Bold],
 "\n5. ",
 StyleBox["interaction-based state selection",
  FontWeight->Bold],
 "\n6. ",
 StyleBox["topological flow organization",
  FontWeight->Bold],
 "\n\nTogether these convert open possibility into repeatable stable \
patterns.\n\nSo determinism here does ",
 StyleBox["not",
  FontWeight->Bold],
 " mean naive clockwork certainty.\nIt means: \n",
 Cell[BoxData[GridBox[{
    {
     PaneBox["\<\"given the geometry, operator, damping, forcing, and \
interaction law, the surviving structured organizations are not \
arbitrary.\"\>",
      BaseStyle->{"Text", FontColor -> LightDarkSwitched[
          GrayLevel[0.35], 
          GrayLevel[0.8602474]]},
      ImageMargins->5,
      ImageSize->{Full, Automatic}]}
   },
   AutoDelete->False,
   GridBoxBackground->{"Columns" -> {{
        LightDarkSwitched[
         GrayLevel[1], 
         GrayLevel[0.278317]]}}},
   GridBoxDividers->{"ColumnsIndexed" -> {1 -> Directive[
         LightDarkSwitched[
          RGBColor[0.87, 0.94, 1], 
          RGBColor[0.2491127, 0.3295188, 0.4231198]], 
         AbsoluteThickness[4]]}, "Rows" -> {{False}}},
   GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}]], 
  "BlockQuote",
  Background->None,ExpressionUUID->"13b8ce9a-690a-c243-a589-a65bb9ffcf5d"],
 "\nThat is a good rigorous statement. \n",
 Cell[BoxData[
  TagBox[GridBox[{
     {
      TemplateBox[{0},
       "Spacer1"]},
     {
      TemplateBox[{0},
       "Spacer1"]}
    },
    AutoDelete->False,
    FrameStyle->Directive[
      LightDarkSwitched[
       GrayLevel[0.8], 
       GrayLevel[0.4867756]], 
      AbsoluteThickness[1]],
    GridBoxDividers->{
     "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
    GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
   "Grid"]], "MarkdownDelimiter",
  ShowStringCharacters->False,
  Background->None,ExpressionUUID->"dcbe1ddd-8bed-9648-9555-a4608a10bdc0"],
 "\n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"6. What \[OpenCurlyDoubleQuote]equilibrium pockets\
\[CloseCurlyDoubleQuote] and \[OpenCurlyDoubleQuote]vortex-like structures\
\[CloseCurlyDoubleQuote] mean in the full vision\"\>", "Title",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->26],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"8a8f1832-8000-fe40-b602-a92f3d341332"],
 "\nThe notebook is careful about this.\n\nIt replaces mystical words with \
testable ones. \n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"Equilibrium pockets\"\>", "Section",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->22],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"9ca062c5-6a10-0249-93dc-dbbc08f706bc"],
 "\nThese are local minima or metastable basins in an effective potential \
landscape.\n\nMeaning: \n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "trajectories are drawn toward them,"
 }], "InlineItem",ExpressionUUID->"37ef48cf-6520-9a4c-9730-3e9203d3fbec"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "perturbations around them may stay bounded,"
 }], "InlineItem",ExpressionUUID->"fea3cf96-7472-e54f-8936-1c6115ff85a9"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "they act as temporary pattern-retention zones."
 }], "InlineItem",ExpressionUUID->"b517c75a-be9a-794f-9663-c2da0cf99e37"],
 "\nIn sensory-field language, these are where information can become ",
 StyleBox["locally stabilized",
  FontWeight->Bold],
 ".\n\nNot because \[OpenCurlyDoubleQuote]the universe likes that form,\
\[CloseCurlyDoubleQuote] but because the force landscape and damping make it \
dynamically favorable. \n",
 Cell[BoxData[
  TagBox[GridBox[{
     {
      TemplateBox[{0},
       "Spacer1"]},
     {
      TemplateBox[{0},
       "Spacer1"]}
    },
    AutoDelete->False,
    FrameStyle->Directive[
      LightDarkSwitched[
       GrayLevel[0.8], 
       GrayLevel[0.4867756]], 
      AbsoluteThickness[1]],
    GridBoxDividers->{
     "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
    GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
   "Grid"]], "MarkdownDelimiter",
  ShowStringCharacters->False,
  Background->None,ExpressionUUID->"2a8adb57-d406-3e4e-9375-5a4d51175eaf"],
 "\n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"Vortex / circulation structures\"\>", "Section",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->22],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"032c7bd4-518d-fe48-9efa-e7e5ba0ea19f"],
 "\nThe notebook says these should mean: \n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "nontrivial curl,"
 }], "InlineItem",ExpressionUUID->"e397749c-a7a6-9e4a-8510-fac8a6db891a"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "phase winding,"
 }], "InlineItem",ExpressionUUID->"ab67e92f-a979-b044-b138-00dad7de17de"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "rotating mode structure,"
 }], "InlineItem",ExpressionUUID->"4fae13d6-f4ad-4840-9d42-e6c5186bf6f0"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "helical pattern."
 }], "InlineItem",ExpressionUUID->"c61d0465-f2d4-6643-8dcd-93d3152d4640"],
 "\nThis matters because apparent swirling in a plot is not enough.\n\nA true \
circulation structure means the field has ",
 StyleBox["organized rotational relational flow",
  FontWeight->Bold],
 ", which can trap, guide, or recode trajectories.\n\nIn the broader vision, \
these structures can serve as: \n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "routing mechanisms,"
 }], "InlineItem",ExpressionUUID->"fd09c9cb-3955-7843-85ac-1e47cc66ae82"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "binding mechanisms,"
 }], "InlineItem",ExpressionUUID->"e14bfd86-ad20-6347-907e-232644304398"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "memory circulation loops,"
 }], "InlineItem",ExpressionUUID->"7c7bc8cd-74a9-de45-97be-3195f50a25df"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "topological separators between dynamical regions."
 }], "InlineItem",ExpressionUUID->"6383ae19-1f34-9b4e-a2c6-df306681ebbe"],
 "\nThat is likely part of what you mean by \[OpenCurlyDoubleQuote]sensory \
field functionality.\[CloseCurlyDoubleQuote] \n",
 Cell[BoxData[
  TagBox[GridBox[{
     {
      TemplateBox[{0},
       "Spacer1"]},
     {
      TemplateBox[{0},
       "Spacer1"]}
    },
    AutoDelete->False,
    FrameStyle->Directive[
      LightDarkSwitched[
       GrayLevel[0.8], 
       GrayLevel[0.4867756]], 
      AbsoluteThickness[1]],
    GridBoxDividers->{
     "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
    GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
   "Grid"]], "MarkdownDelimiter",
  ShowStringCharacters->False,
  Background->None,ExpressionUUID->"44d6b223-542a-de40-9828-e41e8f96ed3c"],
 "\n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"7. The strongest conceptual interpretation of the notebook\"\
\>", "Title",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->26],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"e6b535dc-747a-6b49-a91d-522bb2cafff7"],
 "\nIf I synthesize the whole framework into one vision, it is this: \n",
 Cell[BoxData[GridBox[{
    {
     PaneBox["\<\"Reality-like structure emerges when a high-dimensional \
coupled field admits modes that are simultaneously resonant, stable, \
cross-scale robust, interaction-selected, and topologically organized.\"\>",
      BaseStyle->{"Text", FontColor -> LightDarkSwitched[
          GrayLevel[0.35], 
          GrayLevel[0.8602474]]},
      ImageMargins->5,
      ImageSize->{Full, Automatic}]}
   },
   AutoDelete->False,
   GridBoxBackground->{"Columns" -> {{
        LightDarkSwitched[
         GrayLevel[1], 
         GrayLevel[0.278317]]}}},
   GridBoxDividers->{"ColumnsIndexed" -> {1 -> Directive[
         LightDarkSwitched[
          RGBColor[0.87, 0.94, 1], 
          RGBColor[0.2491127, 0.3295188, 0.4231198]], 
         AbsoluteThickness[4]]}, "Rows" -> {{False}}},
   GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}]], 
  "BlockQuote",
  Background->None,ExpressionUUID->"895c233a-7608-8c4c-a8ec-e921292d0ab0"],
 "\nThat\[CloseCurlyQuote]s the big picture.\n\nThe \
\[OpenCurlyDoubleQuote]sensory field\[CloseCurlyDoubleQuote] is then the \
total relational medium that supports this emergence.\n\nIt is \
\[OpenCurlyDoubleQuote]sensory\[CloseCurlyDoubleQuote] because it is \
sensitive to perturbation, contrast, phase relation, recurrence, and \
topology.\nIt is a \[OpenCurlyDoubleQuote]field\[CloseCurlyDoubleQuote] \
because these are distributed, not pointwise, properties.\nIt yields \
\[OpenCurlyDoubleQuote]deterministic structures\[CloseCurlyDoubleQuote] \
because only certain configurations survive all the filters. \n",
 Cell[BoxData[
  TagBox[GridBox[{
     {
      TemplateBox[{0},
       "Spacer1"]},
     {
      TemplateBox[{0},
       "Spacer1"]}
    },
    AutoDelete->False,
    FrameStyle->Directive[
      LightDarkSwitched[
       GrayLevel[0.8], 
       GrayLevel[0.4867756]], 
      AbsoluteThickness[1]],
    GridBoxDividers->{
     "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
    GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
   "Grid"]], "MarkdownDelimiter",
  ShowStringCharacters->False,
  Background->None,ExpressionUUID->"9fa2e947-d78f-c94f-ba47-a1ba6d69911a"],
 "\n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"8. Where your OPF-style language could map onto this \
notebook\"\>", "Title",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->26],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"8b8834a0-929e-404c-b2c7-bc379e095cec"],
 "\nGiven your framing, there is actually a natural translation. \n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"L0: substrate / background symmetry field\"\>", "Section",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->22],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"b5577fa9-ab61-384c-9cd9-4310a73d2206"],
 "\nThis corresponds loosely to: \n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "ambient low-gradient background"
 }], "InlineItem",ExpressionUUID->"180ae6d6-2890-0842-add7-92d5a1d5f123"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "chosen geometry/topology"
 }], "InlineItem",ExpressionUUID->"191b305f-888e-ec42-85bf-d5d29e2168f8"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "domain of possible structured excitation"
 }], "InlineItem",ExpressionUUID->"2d5ada01-de02-3b42-aedc-84d4e5796d9d"],
 "\n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"L1: hyperdimensional information field\"\>", "Section",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->22],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"21a20eab-f948-b145-9ef2-0d424a2fcdf5"],
 "\nThis corresponds to: \n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "PDE state field ",
  Cell[BoxData[
   FormBox[
    TemplateBox[<|"boxes" -> FormBox[
        StyleBox["u", "TI"], TraditionalForm], "errors" -> {}, "input" -> "u",
       "state" -> "Boxes"|>,
