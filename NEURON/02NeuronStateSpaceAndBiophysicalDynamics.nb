Cell[CellGroupData[{

Cell["3. Equivalent circuit formulation", "Section",ExpressionUUID->"6bb247bb-8043-5240-bc38-37626def1bb5"],

Cell[CellGroupData[{

Cell["3.1. Why the circuit model matters", "Subsection",ExpressionUUID->"e320a029-ea8f-c34a-b716-5940d922bcb8"],

Cell["\<\
The classical neuron model begins with the membrane as a capacitor with \
current pathways across the membrane.\
\>", "Text",ExpressionUUID->"c75ef171-1a41-c341-a4a9-8aa0195b044b"],

Cell[TextData[{
 "The fundamental current balance law is: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["C", "TI"], 
          StyleBox["m", "TI"]], 
         FractionBox[
          RowBox[{
            StyleBox["d", "TI"], 
            StyleBox["v", "TI"]}], 
          RowBox[{
            StyleBox["d", "TI"], 
            StyleBox["t", "TI"]}]], "\[LongEqual]", "-", 
         SubscriptBox[
          StyleBox["I", "TI"], "ion"], 
         RowBox[{"(", 
           RowBox[{
             StyleBox["v", "TI"], ",", 
             StyleBox["g", "TI"], ",", 
             StyleBox["t", "TI"]}], ")"}], "+", 
         SubscriptBox[
          StyleBox["I", "TI"], "ext"], 
         RowBox[{"(", 
           StyleBox["t", "TI"], ")"}]}], TraditionalForm], "errors" -> {}, 
     "input" -> 
     "C_m \\frac{dv}{dt} = - I_{\\text{ion}}(v,g,t) + I_{\\text{ext}}(t)", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "6e2a5e55-27d8-e641-8a56-6cafb04048e0"],
 "where: "
}], "Text",ExpressionUUID->"76ba481f-973f-9e4b-8b4e-b94abad036d6"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["C", "TI"], 
        StyleBox["m", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "C_m", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "cff7e8fe-ccdb-9c4f-a014-54783abbc1f8"],
 " = membrane capacitance,"
}], "Item",ExpressionUUID->"098c211e-cc32-1e49-9fdc-8e5a3621f6af"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["v", "TI"], "(", 
         StyleBox["t", "TI"], ")"}], TraditionalForm], "errors" -> {}, 
     "input" -> "v(t)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "0e87249f-e5fe-a643-8509-027fe968466e"],
 " = membrane potential,"
}], "Item",ExpressionUUID->"7a461044-5513-3c4f-b480-7d084e8b4ed7"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["I", "TI"], "ion"], TraditionalForm], "errors" -> {}, 
     "input" -> "I_{\\text{ion}}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "abd6e7cc-0f9d-2d43-95e7-1c5d807fe012"],
 " = total ionic current,"
}], "Item",ExpressionUUID->"c2d7e11a-e6b9-9d4f-bca9-215b44d5cb89"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["I", "TI"], "ext"], TraditionalForm], "errors" -> {}, 
     "input" -> "I_{\\text{ext}}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "d77815e6-1fc4-514e-b838-09093221ac74"],
 " = injected or synaptic input current."
}], "Item",ExpressionUUID->"bf4d5177-8754-1a41-837d-418c484217a0"]
}, Open  ]],

Cell[CellGroupData[{

Cell["3.2. Ionic current decomposition", "Subsection",ExpressionUUID->"519631ca-3fb6-2247-bb01-cf6df9a9c6b6"],

Cell[TextData[{
 "The ionic current is typically represented as: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["I", "TI"], "ion"], "\[LongEqual]", 
         UnderoverscriptBox["\[Sum]", 
          RowBox[{
            StyleBox["k", "TI"], "\[LongEqual]", "1"}], 
          StyleBox["K", "TI"], LimitsPositioning -> True], 
         SubscriptBox[
          StyleBox["I", "TI"], 
          StyleBox["k", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "I_{\\text{ion}} = \\sum_{k=1}^{K} I_k", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "3dafb8c9-ef93-2847-b37c-7095bfcd097e"],
 "with each current of the form: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["I", "TI"], 
          StyleBox["k", "TI"]], "\[LongEqual]", 
         SubscriptBox[
          OverscriptBox[
           StyleBox["g", "TI"], "_"], 
          StyleBox["k", "TI"]], " ", 
         SubscriptBox["\[Gamma]", 
          StyleBox["k", "TI"]], 
         RowBox[{"(", 
           RowBox[{
             StyleBox["g", "TI"], ",", 
             StyleBox["v", "TI"], ",", 
             StyleBox["t", "TI"]}], ")"}], " ", 
         RowBox[{"(", 
           RowBox[{
             StyleBox["v", "TI"], "-", 
             SubscriptBox[
              StyleBox["E", "TI"], 
              StyleBox["k", "TI"]]}], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "I_k = \\bar{g}_k \\, \\gamma_k(g,v,t)\\,(v-E_k)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "6c0d7a85-70cd-3b47-9f08-ff4aea74e89e"],
 "where: "
}], "Text",ExpressionUUID->"499f1bd6-239d-5746-bf93-f38316e8f43e"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        OverscriptBox[
         StyleBox["g", "TI"], "_"], 
        StyleBox["k", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "\\bar{g}_k", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "e034df7e-a55c-4c47-afc8-1415cf9cf98f"],
 " = maximal conductance,"
}], "Item",ExpressionUUID->"bdb61a36-5f3d-ac4a-aae2-1edf9fe93e09"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox["\[Gamma]", 
        StyleBox["k", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "\\gamma_k", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "70fdf149-d070-9d4f-a93f-cc0aa91829ab"],
 " = gating-dependent activation factor,"
}], "Item",ExpressionUUID->"8e4f058c-7a1f-4647-b99c-b74090e80f12"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["E", "TI"], 
        StyleBox["k", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "E_k", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f0877224-8bd6-f244-9b3e-85586b347220"],
 " = reversal potential."
}], "Item",ExpressionUUID->"854be4da-ba47-9349-b5ec-ae3e4620fdb6"],

Cell["\<\
This conductance-based form is the foundation of biophysical neuron models. \
\>", "Text",ExpressionUUID->"c40953e9-4c1d-3848-a179-7664418f1c53"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{0},
      "Spacer1"]},
    {
     TemplateBox[{0},
      "Spacer1"]}
   },
   AutoDelete->False,
   FrameStyle->Directive[
     LightDarkSwitched[
      GrayLevel[0.8], 
      GrayLevel[0.4867756]], 
     AbsoluteThickness[1]],
   GridBoxDividers->{
    "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
   GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Text", "MarkdownDelimiter",
 ShowStringCharacters->False,
 Background->None,ExpressionUUID->"acf1fa91-0473-c143-84c5-d4332d659f8c"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["4. The leaky integrate-and-fire model", "Section",ExpressionUUID->"71055a90-c844-8944-8c73-853d2a671ce2"],

Cell[CellGroupData[{

Cell["4.1. Minimal dynamic reduction", "Subsection",ExpressionUUID->"7b198433-b847-5b47-a2d4-3121ab86e561"],

Cell[TextData[{
 "The leaky integrate-and-fire model is a reduced model that abstracts away \
detailed channel kinetics: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["C", "TI"], 
          StyleBox["m", "TI"]], 
         FractionBox[
          RowBox[{
            StyleBox["d", "TI"], 
            StyleBox["v", "TI"]}], 
          RowBox[{
            StyleBox["d", "TI"], 
            StyleBox["t", "TI"]}]], "\[LongEqual]", "-", 
         SubscriptBox[
          StyleBox["g", "TI"], 
          StyleBox["L", "TI"]], 
         RowBox[{"(", 
           RowBox[{
             StyleBox["v", "TI"], "-", 
             SubscriptBox[
              StyleBox["E", "TI"], 
              StyleBox["L", "TI"]]}], ")"}], "+", 
         SubscriptBox[
          StyleBox["I", "TI"], "ext"], 
         RowBox[{"(", 
           StyleBox["t", "TI"], ")"}]}], TraditionalForm], "errors" -> {}, 
     "input" -> "C_m \\frac{dv}{dt} = -g_L(v-E_L) + I_{\\text{ext}}(t)", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "0d7ce605-3291-1b40-ba4d-f14628d2864b"],
 "with spike generation rule: "
}], "Text",ExpressionUUID->"3cf974ab-87a4-1943-b9e6-063596c59c0a"],

Cell[TextData[{
 "if ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["v", "TI"], 
         RowBox[{"(", 
           StyleBox["t", "TI"], ")"}], "\[GreaterEqual]", 
         SubscriptBox[
          StyleBox["v", "TI"], "th"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "v(t) \\ge v_{\\text{th}}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "5deeb4ff-5a0e-5b43-ad4b-3a14e9f89bdb"],
 ", emit spike,"
}], "Item",ExpressionUUID->"d3af8039-a9b9-d147-bc67-f1af1bce35d1"],

Cell[TextData[{
 "then reset ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["v", "TI"], "\[Rule]", 
         SubscriptBox[
          StyleBox["v", "TI"], "reset"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "v \\to v_{\\text{reset}}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "592f6f6b-bbc9-7648-bd7c-21a2600de29e"],
 ","
}], "Item",ExpressionUUID->"6eaaf499-ed8b-ad41-8e8a-af1e76148c4f"],

Cell[TextData[{
 "optionally hold refractory state for a duration ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox["\[Tau]", "ref"], TraditionalForm], "errors" -> {}, 
     "input" -> "\\tau_{\\text{ref}}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "9e1757d2-4fd9-fe40-835f-bfc49eaa7189"],
 "."
}], "Item",ExpressionUUID->"1c364fd1-e86d-5d48-b2af-eeb3945ba09b"]
}, Open  ]],

Cell[CellGroupData[{

Cell["4.2. Why it is useful", "Subsection",ExpressionUUID->"c2de41f1-3337-6541-9723-f3f4eb0543c2"],

Cell["This model is: ", "Text",ExpressionUUID->"273aa336-ab9b-f74e-bba6-5dccf576312d"],

Cell["computationally efficient,", "Item",ExpressionUUID->"5bf98cf1-f14f-4448-8d38-7bf379f4f8b1"],

Cell["analytically tractable,", "Item",ExpressionUUID->"4ce0aab7-5d10-004d-81cb-92cba838f0b7"],

Cell["useful for large-scale simulations,", "Item",ExpressionUUID->"47136e09-6328-6b46-97dc-3baaf8442cc1"],

Cell["often sufficient for network-level timing studies.", "Item",ExpressionUUID->"31e7291e-20cb-5b46-972d-29c999fd65ab"]
}, Open  ]],

Cell[CellGroupData[{

Cell["4.3. Why it is incomplete", "Subsection",ExpressionUUID->"80f572dd-97e6-004b-951f-46feefda6efa"],

Cell["It does not capture: ", "Text",ExpressionUUID->"9e19c9d7-2394-134c-bd07-9e57303325d0"],

Cell["channel-specific nonlinearities,", "Item",ExpressionUUID->"17ee6b33-5f73-f04c-8fb7-271585c58f5d"],

Cell["adaptation,", "Item",ExpressionUUID->"93b37c6a-5acf-2d47-aba5-04779258dfca"],

Cell["dendritic computation,", "Item",ExpressionUUID->"315e54b2-dc14-d746-822a-ef806c1f819f"],

Cell["conductance fluctuations,", "Item",ExpressionUUID->"85aa2cc9-5491-7f46-93b2-c47ab0856fbc"],

Cell["biologically realistic spike shape.", "Item",ExpressionUUID->"15d9d954-4868-514b-89e3-63ceaf773622"],

Cell["So it is a valuable reduction, not a complete neuron. ", "Text",ExpressionUUID->"cafa3ab5-110d-5d40-8917-9fd95e6eac42"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{0},
      "Spacer1"]},
    {
     TemplateBox[{0},
      "Spacer1"]}
   },
   AutoDelete->False,
   FrameStyle->Directive[
     LightDarkSwitched[
      GrayLevel[0.8], 
      GrayLevel[0.4867756]], 
     AbsoluteThickness[1]],
   GridBoxDividers->{
    "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
   GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Text", "MarkdownDelimiter",
 ShowStringCharacters->False,
 Background->None,ExpressionUUID->"289ab049-b934-bd49-bf25-197664fbe045"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["5. Conductance-based neuron models", "Section",ExpressionUUID->"8c17e6d5-7c75-004c-a396-ba571cdc449a"],

Cell[CellGroupData[{

Cell["5.1. The Hodgkin-Huxley structure", "Subsection",ExpressionUUID->"922b8dd2-d7c1-8540-81a4-4e35b1713e3f"],

Cell[TextData[{
 "The Hodgkin-Huxley class models membrane voltage and channel gates \
explicitly: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["C", "TI"], 
          StyleBox["m", "TI"]], 
         FractionBox[
          RowBox[{
            StyleBox["d", "TI"], 
            StyleBox["v", "TI"]}], 
          RowBox[{
            StyleBox["d", "TI"], 
            StyleBox["t", "TI"]}]], "\[LongEqual]", "-", 
         SubscriptBox[
          OverscriptBox[
           StyleBox["g", "TI"], "_"], "Na"], 
         SuperscriptBox[
          StyleBox["m", "TI"], "3"], 
         StyleBox["h", "TI"], 
         RowBox[{"(", 
           RowBox[{
             StyleBox["v", "TI"], "-", 
             SubscriptBox[
              StyleBox["E", "TI"], "Na"]}], ")"}], "-", 
         SubscriptBox[
          OverscriptBox[
           StyleBox["g", "TI"], "_"], "K"], 
         SuperscriptBox[
          StyleBox["n", "TI"], "4"], 
         RowBox[{"(", 
           RowBox[{
             StyleBox["v", "TI"], "-", 
             SubscriptBox[
              StyleBox["E", "TI"], "K"]}], ")"}], "-", 
         SubscriptBox[
          StyleBox["g", "TI"], 
          StyleBox["L", "TI"]], 
         RowBox[{"(", 
           RowBox[{
             StyleBox["v", "TI"], "-", 
             SubscriptBox[
              StyleBox["E", "TI"], 
              StyleBox["L", "TI"]]}], ")"}], "+", 
         SubscriptBox[
          StyleBox["I", "TI"], "ext"], 
         RowBox[{"(", 
           StyleBox["t", "TI"], ")"}]}], TraditionalForm], "errors" -> {}, 
     "input" -> 
     "C_m \\frac{dv}{dt}\n=\n- \\bar{g}_{\\text{Na}} m^3 h (v-E_{\\text{Na}})\
\n- \\bar{g}_{\\text{K}} n^4 (v-E_{\\text{K}})\n- g_L (v-E_L)\n+ \
I_{\\text{ext}}(t)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "c9402067-b291-af45-b625-dbbdae2e4bc5"],
 "with gate equations of the form: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         FractionBox[
          RowBox[{
            StyleBox["d", "TI"], 
            StyleBox["q", "TI"]}], 
          RowBox[{
            StyleBox["d", "TI"], 
            StyleBox["t", "TI"]}]], "\[LongEqual]", 
         SubscriptBox["\[Alpha]", 
          StyleBox["q", "TI"]], 
         RowBox[{"(", 
           StyleBox["v", "TI"], ")"}], 
         RowBox[{"(", 
           RowBox[{"1", "-", 
             StyleBox["q", "TI"]}], ")"}], "-", 
         SubscriptBox["\[Beta]", 
          StyleBox["q", "TI"]], 
         RowBox[{"(", 
           StyleBox["v", "TI"], ")"}], 
         StyleBox["q", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\frac{dq}{dt} = \\alpha_q(v)(1-q) - \\beta_q(v)q", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "29096d32-059a-8a4a-baca-ecca4adeba34"],
 "for gate variables ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["q", "TI"], "\[Element]", 
         RowBox[{"{", 
           RowBox[{
             StyleBox["m", "TI"], ",", 
             StyleBox["h", "TI"], ",", 
             StyleBox["n", "TI"]}], "}"}]}], TraditionalForm], "errors" -> {},
      "input" -> "q \\in \\{m,h,n\\}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "4c177f35-52c7-b246-9c4e-5390a93d4fd2"],
 ". "
}], "Text",ExpressionUUID->"2461f49e-d03d-4f4a-a3cc-16f861aa0403"]
}, Open  ]],

Cell[CellGroupData[{

Cell["5.2. Interpretation", "Subsection",ExpressionUUID->"0e913e92-63e3-7e49-bc67-cdddb8e2a487"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["m", "TI"], TraditionalForm], "errors" -> {}, "input" -> "m", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "02b09798-fd87-aa4d-a01a-eaa6b222e2ea"],
 " often models sodium activation,"
}], "Item",ExpressionUUID->"55f78884-b37a-5743-a85a-5c1552fa82cd"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["h", "TI"], TraditionalForm], "errors" -> {}, "input" -> "h", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "d1b2ada5-a88f-4c4b-99b7-ef821d97ab31"],
 " sodium inactivation,"
}], "Item",ExpressionUUID->"a74311ed-8277-8a46-9d26-b081fcf4224d"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["n", "TI"], TraditionalForm], "errors" -> {}, "input" -> "n", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "98d8eac3-6e96-634e-8a88-1706c72dcb80"],
 " potassium activation."
}], "Item",ExpressionUUID->"760d9017-1249-4d48-be67-806aa59a7a5f"]
}, Open  ]],

Cell[CellGroupData[{

Cell["5.3. Importance", "Subsection",ExpressionUUID->"73f2ee4e-f25e-9d48-96e7-84ba5f13805b"],

Cell["\<\
This model is the canonical starting point for mechanistic spike generation.\
\>", "Text",ExpressionUUID->"eb799a4c-e3cf-8749-9973-ee8691ff2736"],

Cell["\<\
It demonstrates that spikes are emergent nonlinear events of gating dynamics, \
not ad hoc thresholds. \
\>", "Text",ExpressionUUID->"0dc320a9-cddd-7e4a-b645-e2663b177ea8"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{0},
      "Spacer1"]},
    {
     TemplateBox[{0},
      "Spacer1"]}
   },
   AutoDelete->False,
   FrameStyle->Directive[
     LightDarkSwitched[
      GrayLevel[0.8], 
      GrayLevel[0.4867756]], 
     AbsoluteThickness[1]],
   GridBoxDividers->{
    "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
   GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Text", "MarkdownDelimiter",
 ShowStringCharacters->False,
 Background->None,ExpressionUUID->"982c6303-b4ce-fb4f-bc4f-7f9253374127"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["6. General conductance framework", "Section",ExpressionUUID->"5029dea2-8f60-5049-80dd-8dbc02082552"],

Cell[CellGroupData[{

Cell["6.1. Unified current family", "Subsection",ExpressionUUID->"5c1bda69-a801-d14d-9497-77c83b2e7029"],

Cell["A broader neuron model may include currents: ", "Text",ExpressionUUID->"1409f8a9-6ef4-0b4b-845f-88dfb080821b"],

Cell["sodium,", "Item",ExpressionUUID->"ad9e1415-c4f1-4941-a3a4-228fb25b431c"],

Cell["potassium,", "Item",ExpressionUUID->"98b67df1-b8d6-cc4c-a0a0-4c38179ea7ab"],

Cell["calcium,", "Item",ExpressionUUID->"d3f7506f-2219-e04d-a66a-a96d5f9ac994"],

Cell["h-current,", "Item",ExpressionUUID->"ac47789f-4dd6-b64d-9bfc-b2fc3edfaec1"],

Cell["M-current,", "Item",ExpressionUUID->"730c6ea1-32cf-e541-b22d-50a064eb9f28"],

Cell["A-current,", "Item",ExpressionUUID->"7ff412c4-ed08-2f4f-92a5-e61911af7e78"],

Cell["leak,", "Item",ExpressionUUID->"ce15c68b-333a-ba41-b94f-dfe5eb9e952e"],

Cell["synaptic conductances,", "Item",ExpressionUUID->"b948cb7f-59fd-514b-aa69-4e5b2930203a"],

Cell["modulatory currents.", "Item",ExpressionUUID->"21198e7e-8cf8-6448-8499-b77d5f8e16b6"],

Cell[TextData[{
 "A unified form is: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["C", "TI"], 
          StyleBox["m", "TI"]], 
         FractionBox[
          RowBox[{
            StyleBox["d", "TI"], 
            StyleBox["v", "TI"]}], 
          RowBox[{
            StyleBox["d", "TI"], 
            StyleBox["t", "TI"]}]], "\[LongEqual]", "-", 
         UnderoverscriptBox["\[Sum]", 
          RowBox[{
            StyleBox["k", "TI"], "\[LongEqual]", "1"}], 
          StyleBox["K", "TI"], LimitsPositioning -> True], 
         SubscriptBox[
          OverscriptBox[
           StyleBox["g", "TI"], "_"], 
          StyleBox["k", "TI"]], 
         UnderoverscriptBox["\[Product]", 
          RowBox[{
            StyleBox["j", "TI"], "\[LongEqual]", "1"}], 
          SubscriptBox[
           StyleBox["J", "TI"], 
           StyleBox["k", "TI"]], LimitsPositioning -> True], 
         SubsuperscriptBox[
          StyleBox["q", "TI"], 
          RowBox[{
            StyleBox["k", "TI"], 
            StyleBox["j", "TI"]}], 
          SubscriptBox[
           StyleBox["a", "TI"], 
           RowBox[{
             StyleBox["k", "TI"], 
             StyleBox["j", "TI"]}]]], 
         RowBox[{"(", 
           RowBox[{
             StyleBox["v", "TI"], "-", 
             SubscriptBox[
              StyleBox["E", "TI"], 
              StyleBox["k", "TI"]]}], ")"}], "+", 
         SubscriptBox[
          StyleBox["I", "TI"], "syn"], "+", 
         SubscriptBox[
          StyleBox["I", "TI"], "ext"]}], TraditionalForm], "errors" -> {}, 
     "input" -> 
     "C_m \\frac{dv}{dt}\n=\n- \\sum_{k=1}^{K}\n\\bar{g}_k\n\
\\prod_{j=1}^{J_k} q_{kj}^{a_{kj}}\n(v-E_k)\n+ I_{\\text{syn}} + \
I_{\\text{ext}}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "0dacff5a-7d8b-e249-b671-6bd1a3307d7e"],
 "with gate variables obeying first-order or higher-order kinetics. "
}], "Text",ExpressionUUID->"5e88a9c5-7fb9-2849-8781-8fbbcb431cba"]
}, Open  ]],

Cell[CellGroupData[{

Cell["6.2. Gate-state evolution", "Subsection",ExpressionUUID->"e160d62a-ae0a-1f41-91b0-196e4c50ea01"],

Cell[TextData[{
 "A common alternative parameterization is: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         FractionBox[
          RowBox[{
            StyleBox["d", "TI"], 
            StyleBox["q", "TI"]}], 
          RowBox[{
            StyleBox["d", "TI"], 
            StyleBox["t", "TI"]}]], "\[LongEqual]", 
         FractionBox[
          RowBox[{
            SubscriptBox[
             StyleBox["q", "TI"], "\[Infinity]"], 
            RowBox[{"(", 
              StyleBox["v", "TI"], ")"}], "-", 
            StyleBox["q", "TI"]}], 
          RowBox[{
            SubscriptBox["\[Tau]", 
             StyleBox["q", "TI"]], "(", 
            StyleBox["v", "TI"], ")"}]]}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\frac{dq}{dt} = \\frac{q_\\infty(v)-q}{\\tau_q(v)}", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "bd3e5983-4d21-f946-8256-415c07861030"],
 "This form is numerically convenient and biologically interpretable. "
}], "Text",ExpressionUUID->"fb95ffb1-f366-1b45-afa2-27b639ad767b"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{0},
      "Spacer1"]},
    {
     TemplateBox[{0},
      "Spacer1"]}
   },
   AutoDelete->False,
   FrameStyle->Directive[
     LightDarkSwitched[
      GrayLevel[0.8], 
      GrayLevel[0.4867756]], 
