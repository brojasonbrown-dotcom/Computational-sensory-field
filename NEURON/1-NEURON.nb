Cell[CellGroupData[{

Cell["19. What this notebook establishes", "Section",ExpressionUUID->"1f17cba1-58ea-4245-b509-5dd3d7b59c14"],

Cell["This notebook establishes the program, not the final neuron.", "Text",ExpressionUUID->"fe77e487-7c14-e443-92ec-092a4811dd2c"],

Cell["\<\
Its main achievement is to convert a visionary but incomplete neuron sketch \
into a rigorous research agenda with: \
\>", "Text",ExpressionUUID->"b88ec705-a72d-9040-84dd-146f1fd0cc27"],

Cell["epistemic discipline,", "Item",ExpressionUUID->"6854acad-737a-8343-89f7-5867553a9df9"],

Cell["mathematical layering,", "Item",ExpressionUUID->"cbe4e671-e192-ea4e-adde-c3d2df535d2f"],

Cell["formal state variables,", "Item",ExpressionUUID->"19620085-545d-0846-a155-b4fad17db5d4"],

Cell["gap mapping,", "Item",ExpressionUUID->"e7e0eb6a-60d2-4942-b40a-6892bfbfea03"],

Cell["series structure,", "Item",ExpressionUUID->"27639acf-092c-7449-89b8-c898ee00b5a5"],

Cell["implementation direction.", "Item",ExpressionUUID->"80870247-3853-5a4b-b136-d509ee8b0558"],

Cell["That is the necessary foundation for all later notebooks. ", "Text",ExpressionUUID->"a689fd60-ed16-434a-ad9b-304cdd8da2ee"],

