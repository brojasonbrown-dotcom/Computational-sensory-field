   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[Theta]", 
          RowBox[{
            StyleBox["t", "TI"], "+", "1"}]], "\[LongEqual]", 
         SubscriptBox["\[Theta]", 
          StyleBox["t", "TI"]], "+", "\[Eta] ", 
