  " ",
  "modal decomposition"
 }], "InlineItem",ExpressionUUID->"d1267d7f-0cd7-9743-bfaf-9e2b13bdd5ac"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "spectral structure"
 }], "InlineItem",ExpressionUUID->"d19f30c7-d47c-b247-b3b8-8dec0dbd0735"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
