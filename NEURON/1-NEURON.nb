Cell["operationalize,", "Item",ExpressionUUID->"341d1600-b518-4243-9ac8-7d56ce44ae3a"],

Cell["evaluate.", "Item",ExpressionUUID->"a692f247-da13-b24a-a575-dc72de7b6334"],

