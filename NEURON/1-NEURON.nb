Cell["trainable modules,", "Item",ExpressionUUID->"e7aeb0ab-26d1-f74c-afa8-9b7c32792575"],

Cell["morphology-aware compute blocks,", "Item",ExpressionUUID->"9b90e49c-c662-0c40-ab6c-0f7bdc3572ff"],

Cell["memory and routing gates,", "Item",ExpressionUUID->"00906d46-b1c1-2f49-9161-5a9def64ec83"],

Cell["deployment-efficient surrogates.", "Item",ExpressionUUID->"b258cde4-4f0e-4540-9e9d-d2d5b55567ae"]
}, Open  ]],

Cell[CellGroupData[{

Cell["5.10. Evaluation layer", "Subsection",ExpressionUUID->"0cb3cce1-ab84-fc44-a3dd-26ad4a893dab"],

Cell["Represents: ", "Text",ExpressionUUID->"57b81b44-9289-1840-a3e2-de02a3b69725"],

Cell["task performance,", "Item",ExpressionUUID->"8926c62b-0c8e-2c47-85bf-fb5d69d58ecb"],

Cell["robustness,", "Item",ExpressionUUID->"5ebadd9e-aa07-fa4d-8da7-42b65a2a75a9"],

Cell["sample efficiency,", "Item",ExpressionUUID->"7036cc22-0a22-4d41-a999-d3d7f1325b0b"],

Cell["interpretability,", "Item",ExpressionUUID->"f9ed43c5-a319-2647-9c8b-c8510391810c"],

Cell["stability,", "Item",ExpressionUUID->"5090d380-2dd3-3d46-a6c9-e1a76f805d2c"],

