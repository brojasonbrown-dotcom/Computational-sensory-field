Cell[CellGroupData[{

Cell["16.2. Why this order works", "Subsection",ExpressionUUID->"74cfa636-81fd-444f-8921-ddc5a6e820bf"],

Cell["It enforces a disciplined dependency chain: ", "Text",ExpressionUUID->"8441b4de-01e3-ed47-a4be-0d264eef8497"],

