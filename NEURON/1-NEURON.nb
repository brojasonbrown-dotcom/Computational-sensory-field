Cell["20. Next notebook", "Section",ExpressionUUID->"e7aee3da-dfa7-ec4b-b57e-f95f098a487a"],

Cell["The next notebook should be:", "Text",ExpressionUUID->"df73bb48-ce45-7a4f-b696-db5f63498459"],

Cell[TextData[{
 "02",
 StyleBox["Neuron",
  FontSlant->Italic],
 "State",
 StyleBox["Space",
  FontSlant->Italic],
 "And",
 StyleBox["Biophysical",
  FontSlant->Italic],
 "Dynamics"
}], "Text",ExpressionUUID->"e7c52745-97f2-004e-ab28-77eef76c163f"],

Cell["It should derive and organize: ", "Text",ExpressionUUID->"2f0a274a-d7d7-a047-952e-77657cc6b76e"],

Cell["the neuron state vector in full detail,", "Item",ExpressionUUID->"4e9c0f2e-240b-a04b-a042-8c901803bdd4"],

Cell["membrane equations,", "Item",ExpressionUUID->"e5fa2b6f-237c-5544-b4cc-5e97782e9c00"],

Cell["conductance-based dynamics,", "Item",ExpressionUUID->"929394f2-3d78-6e43-8d5e-4325e5ae8537"],

Cell["cable and compartment models,", "Item",ExpressionUUID->"e42ddb76-0ce3-db4a-8957-a1e70ff5ebe7"],

Cell["reduction ladders from HH to digital approximations,", "Item",ExpressionUUID->"f671cd31-7aad-f24e-9dc5-2b25295f06d1"],

Cell["executable Wolfram Language model scaffolds.", "Item",ExpressionUUID->"0ff5f025-0948-044e-9465-4b18915c7c62"]
}, Open  ]]
