Cell[CellGroupData[{

Cell["16. Wolfram Language scaffolding", "Section",ExpressionUUID->"463147ad-add6-5745-8581-4daa96c0d495"],

Cell[CellGroupData[{

Cell["16.1. Synaptic state representation", "Subsection",ExpressionUUID->"365f06b3-d9cc-8b4a-9c1e-cc23334c2403"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "synapseState", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"synapseState", "[", 
    RowBox[{
    "conductance_", ",", "weight_", ",", "resource_", ",", "utilization_", ",",
      "delay_", ",", "receptor_", ",", "modulation_"}], "]"}], ":=", 
   RowBox[{"<|", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"\"\<Conductance\>\"", "->", "conductance"}], ",", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"\"\<Weight\>\"", "->", "weight"}], ",", "\[IndentingNewLine]", 
     "  ", 
     RowBox[{"\"\<Resource\>\"", "->", "resource"}], ",", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"\"\<Utilization\>\"", "->", "utilization"}], ",", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"\"\<Delay\>\"", "->", "delay"}], ",", "\[IndentingNewLine]", 
     "  ", 
     RowBox[{"\"\<ReceptorType\>\"", "->", "receptor"}], ",", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"\"\<ModulationState\>\"", "->", "modulation"}]}], 
    "\[IndentingNewLine]", "|>"}]}], ";"}]}], "Input",ExpressionUUID->\
"529d833b-f547-4043-ada5-9ebaacc369f7"]
}, Open  ]],

Cell[CellGroupData[{

Cell["16.2. Exponential conductance update skeleton", "Subsection",ExpressionUUID->"b9efbc74-7104-2d4c-a8bd-0c18dbb8b4f4"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "synapticConductanceRhs", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"synapticConductanceRhs", "[", 
    RowBox[{"conductance_", ",", "decayTime_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"-", "conductance"}], "/", "decayTime"}]}], ";"}]}], "Input",Expre\
ssionUUID->"ebdb3172-7987-b747-af02-b565f592070b"]
}, Open  ]],

Cell[CellGroupData[{

Cell["16.3. STDP update function", "Subsection",ExpressionUUID->"301f86aa-da3c-b74c-823a-b883db211614"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "stdpUpdate", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"stdpUpdate", "[", 
    RowBox[{
    "deltaT_", ",", "aPlus_", ",", "aMinus_", ",", "tauPlus_", ",", 
     "tauMinus_"}], "]"}], ":=", "\[IndentingNewLine]", "  ", 
   RowBox[{"Piecewise", "[", "\[IndentingNewLine]", "    ", 
    RowBox[{
     RowBox[{"{", "\[IndentingNewLine]", "      ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"aPlus", " ", 
          RowBox[{"Exp", "[", 
           RowBox[{
            RowBox[{"-", "deltaT"}], "/", "tauPlus"}], "]"}]}], ",", 
         RowBox[{"deltaT", ">", "0"}]}], "}"}], ",", "\[IndentingNewLine]", 
       "      ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"-", "aMinus"}], " ", 
          RowBox[{"Exp", "[", 
           RowBox[{"deltaT", "/", "tauMinus"}], "]"}]}], ",", 
         RowBox[{"deltaT", "<", "0"}]}], "}"}]}], "\[IndentingNewLine]", 
      "    ", "}"}], ",", "\[IndentingNewLine]", "    ", "0"}], 
    "\[IndentingNewLine]", "  ", "]"}]}], ";"}]}], "Input",ExpressionUUID->\
"152a8024-ee1e-c74a-9804-ce43554b290b"]
}, Open  ]],

Cell[CellGroupData[{

Cell["16.4. Short-term plasticity skeleton", "Subsection",ExpressionUUID->"04ac13ea-bc1a-8444-8008-c282c1fdc8cd"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "shortTermPlasticityStep", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"shortTermPlasticityStep", "[", 
    RowBox[{
    "resource_", ",", "utilization_", ",", "u0_", ",", "recoveryTime_", ",", 
     "facilitationTime_", ",", "spikeQ_"}], "]"}], ":=", 
   RowBox[{"<|", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"\"\<ResourceNext\>\"", "->", 
      RowBox[{"resource", "+", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", "-", "resource"}], ")"}], "/", "recoveryTime"}], "-", 
       RowBox[{"spikeQ", " ", "utilization", " ", "resource"}]}]}], ",", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"\"\<UtilizationNext\>\"", "->", 
      RowBox[{"utilization", "+", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"u0", "-", "utilization"}], ")"}], "/", "facilitationTime"}],
        "+", 
       RowBox[{"spikeQ", " ", "u0", " ", 
        RowBox[{"(", 
         RowBox[{"1", "-", "utilization"}], ")"}]}]}]}]}], 
    "\[IndentingNewLine]", "|>"}]}], ";"}]}], "Input",ExpressionUUID->\
"379e30a9-c1e1-ae47-a077-65bc13899901"]
}, Open  ]],

Cell[CellGroupData[{

Cell["16.5. Glia state representation", "Subsection",ExpressionUUID->"2016b6a0-6ca6-5941-8b95-ca6148cf8c17"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "gliaState", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"gliaState", "[", 
    RowBox[{
    "calcium_", ",", "transmitter_", ",", "modulation_", ",", "metabolic_"}], 
    "]"}], ":=", 
   RowBox[{"<|", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"\"\<Calcium\>\"", "->", "calcium"}], ",", "\[IndentingNewLine]",
      "  ", 
     RowBox[{"\"\<Gliotransmitter\>\"", "->", "transmitter"}], ",", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"\"\<Modulation\>\"", "->", "modulation"}], ",", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"\"\<MetabolicSupport\>\"", "->", "metabolic"}]}], 
    "\[IndentingNewLine]", "|>"}]}], ";"}]}], "Input",ExpressionUUID->\
"8f1294c9-c7a1-564f-9991-f0e742b3c77e"],

