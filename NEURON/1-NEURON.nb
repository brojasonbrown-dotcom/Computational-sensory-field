Cell[CellGroupData[{

Cell["17. Wolfram Language program scaffold", "Section",ExpressionUUID->"17d43960-d365-c04f-bffe-1996d7c67d22"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{
    "neuronState", ",", "measurementState", ",", "closureState", ",", 
     "neuronStep"}], "]"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"neuronState", "[", "\[IndentingNewLine]", "   ", 
     RowBox[{
     "membrane_", ",", "gateVector_", ",", "synapseVector_", ",", 
      "plasticityVector_", ",", "memory_", ",", "\[IndentingNewLine]", "   ", 
      "morphology_", ",", "output_", ",", "measurement_", ",", "closure_"}], 
     "]"}], ":=", 
    RowBox[{"<|", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"\"\<MembraneState\>\"", "->", "membrane"}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"\"\<GateVector\>\"", "->", "gateVector"}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"\"\<SynapseVector\>\"", "->", "synapseVector"}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"\"\<PlasticityVector\>\"", "->", "plasticityVector"}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"\"\<MemoryState\>\"", "->", "memory"}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"\"\<MorphologyState\>\"", "->", "morphology"}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"\"\<OutputState\>\"", "->", "output"}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"\"\<MeasurementState\>\"", "->", "measurement"}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"\"\<ClosureState\>\"", "->", "closure"}]}], 
     "\[IndentingNewLine]", "|>"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"measurementState", "[", 
     RowBox[{
     "scale_", ",", "phase_", ",", "coherence_", ",", "history_", ",", 
      "geometry_"}], "]"}], ":=", 
    RowBox[{"<|", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"\"\<ScaleBand\>\"", "->", "scale"}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"\"\<PhaseProxy\>\"", "->", "phase"}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"\"\<CoherenceProxy\>\"", "->", "coherence"}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"\"\<HistoryTrace\>\"", "->", "history"}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"\"\<GeometryDescriptor\>\"", "->", "geometry"}]}], 
     "\[IndentingNewLine]", "|>"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"closureState", "[", 
     RowBox[{"recurrence_", ",", "attractorDistance_", ",", "persistence_"}], 
     "]"}], ":=", 
    RowBox[{"<|", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"\"\<RecurrenceScore\>\"", "->", "recurrence"}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"\"\<AttractorDistance\>\"", "->", "attractorDistance"}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"\"\<PersistenceScore\>\"", "->", "persistence"}]}], 
     "\[IndentingNewLine]", "|>"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"neuronStep", "[", 
    RowBox[{
    "state_Association", ",", "input_", ",", "context_", ",", "params_"}], 
    "]"}], ":=", 
   RowBox[{"Module", "[", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"newState", "=", "state"}], "}"}], ",", "\[IndentingNewLine]", 
     "  ", "newState"}], "\[IndentingNewLine]", "]"}]}], ";"}]}], "Input",Expr\
essionUUID->"c4701c13-9279-264a-aa76-9383a5c9e403"],

Cell["\<\
This scaffold is intentionally minimal. Later notebooks will define each \
update law properly. \
\>", "Text",ExpressionUUID->"fda9783a-a600-8f4c-a5fb-010d1883b81d"],

