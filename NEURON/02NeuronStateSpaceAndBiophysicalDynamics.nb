Cell[CellGroupData[{

Cell["2. The neuron as a state-space system", "Section",ExpressionUUID->"66df7f40-004e-1649-bdb5-9b420191101b"],

Cell["\<\
A neuron is best treated as a structured dynamical system with internal \
state, external inputs, environmental context, and adaptive parameters. \
\>", "Text",ExpressionUUID->"86290a35-fe60-4648-8e4b-bc72e70b5e5e"],

Cell[CellGroupData[{

Cell["2.1. General state representation", "Subsection",ExpressionUUID->"dcbaa3cd-76ee-8f40-80e9-3ab8f4ad07bd"],

Cell[TextData[{
 "Let the neuron state at time ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["t", "TI"], TraditionalForm], "errors" -> {}, "input" -> "t", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f3a19a41-c788-e047-8000-4876712d08a4"],
 " be: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["x", "TI"], 
         RowBox[{"(", 
           StyleBox["t", "TI"], ")"}], "\[LongEqual]", 
         RowBox[{"(", 
           RowBox[{
             StyleBox["v", "TI"], 
             RowBox[{"(", 
               StyleBox["t", "TI"], ")"}], ",", 
             StyleBox["g", "TI"], 
             RowBox[{"(", 
               StyleBox["t", "TI"], ")"}], ",", 
             StyleBox["s", "TI"], 
             RowBox[{"(", 
               StyleBox["t", "TI"], ")"}], ",", 
             StyleBox["p", "TI"], 
             RowBox[{"(", 
               StyleBox["t", "TI"], ")"}], ",", 
             StyleBox["m", "TI"], 
             RowBox[{"(", 
               StyleBox["t", "TI"], ")"}], ",", 
             StyleBox["r", "TI"], 
             RowBox[{"(", 
               StyleBox["t", "TI"], ")"}], ",", 
             StyleBox["o", "TI"], 
             RowBox[{"(", 
               StyleBox["t", "TI"], ")"}]}], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "x(t) =\n\\big(\nv(t),\ng(t),\ns(t),\np(t),\nm(t),\nr(t),\no(t)\n\\big)",
      "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "49ff01ed-a5a7-f147-9570-061a81c62eae"],
 "where: "
}], "Text",ExpressionUUID->"ccead7ee-4c64-e94c-bde0-9a45b524cca6"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["v", "TI"], "(", 
         StyleBox["t", "TI"], ")"}], TraditionalForm], "errors" -> {}, 
     "input" -> "v(t)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "a68a7cf9-494d-1542-925f-8e5229b228d1"],
 " = membrane potential state,"
}], "Item",ExpressionUUID->"8a1085f3-7908-cb49-aeff-a03502a2021c"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["g", "TI"], "(", 
         StyleBox["t", "TI"], ")"}], TraditionalForm], "errors" -> {}, 
     "input" -> "g(t)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "50f4ec31-48c8-ac4d-a2bf-985810fd431f"],
 " = ion channel gate state vector,"
}], "Item",ExpressionUUID->"af51d3c6-990b-de45-a782-ef8c9956bda8"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["s", "TI"], "(", 
         StyleBox["t", "TI"], ")"}], TraditionalForm], "errors" -> {}, 
     "input" -> "s(t)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "e22fc385-93b2-204f-9e42-c0056e0e0ea1"],
 " = synaptic state vector,"
}], "Item",ExpressionUUID->"eb6397e2-25c4-a745-b092-caf0d8109fc3"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["p", "TI"], "(", 
         StyleBox["t", "TI"], ")"}], TraditionalForm], "errors" -> {}, 
     "input" -> "p(t)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f53a6c84-d68d-3843-91a4-febe44816f00"],
 " = plasticity state vector,"
}], "Item",ExpressionUUID->"d1d00ebc-ea9d-774e-ad04-883074fc1688"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["m", "TI"], "(", 
         StyleBox["t", "TI"], ")"}], TraditionalForm], "errors" -> {}, 
     "input" -> "m(t)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "73a29cbc-c594-bd4c-9613-c0491abf2768"],
 " = internal memory/adaptation state,"
}], "Item",ExpressionUUID->"e657e9d9-3c1e-914e-ab49-604704a4c1c5"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["r", "TI"], "(", 
         StyleBox["t", "TI"], ")"}], TraditionalForm], "errors" -> {}, 
     "input" -> "r(t)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "bda25dfc-e07d-164a-9317-35c2a68ded74"],
 " = morphology or compartment state,"
}], "Item",ExpressionUUID->"c93f4a28-1d91-b54e-8192-b9eb8bcfd1ea"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["o", "TI"], "(", 
         StyleBox["t", "TI"], ")"}], TraditionalForm], "errors" -> {}, 
     "input" -> "o(t)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f967098b-28bf-0145-9cfd-b6d216728283"],
 " = output state."
}], "Item",ExpressionUUID->"ee77e358-b4a6-0b4c-870b-da1279924609"],

Cell[TextData[{
 "A more complete formulation for multicompartment neurons is: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["x", "TI"], 
         RowBox[{"(", 
           StyleBox["t", "TI"], ")"}], "\[LongEqual]", 
         RowBox[{"(", 
           RowBox[{
             StyleBox["v", FontSlant -> "Bold"], 
             RowBox[{"(", 
               StyleBox["t", "TI"], ")"}], ",", 
             StyleBox["g", FontSlant -> "Bold"], 
             RowBox[{"(", 
               StyleBox["t", "TI"], ")"}], ",", 
             StyleBox["s", FontSlant -> "Bold"], 
             RowBox[{"(", 
               StyleBox["t", "TI"], ")"}], ",", 
             StyleBox["p", FontSlant -> "Bold"], 
             RowBox[{"(", 
               StyleBox["t", "TI"], ")"}], ",", 
             StyleBox["m", FontSlant -> "Bold"], 
             RowBox[{"(", 
               StyleBox["t", "TI"], ")"}], ",", 
             StyleBox["r", FontSlant -> "Bold"], 
             RowBox[{"(", 
               StyleBox["t", "TI"], ")"}], ",", 
             StyleBox["o", FontSlant -> "Bold"], 
             RowBox[{"(", 
               StyleBox["t", "TI"], ")"}]}], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "x(t) =\n\\big(\n\\mathbf{v}(t),\n\\mathbf{g}(t),\n\\mathbf{s}(t),\n\
\\mathbf{p}(t),\n\\mathbf{m}(t),\n\\mathbf{r}(t),\n\\mathbf{o}(t)\n\\big)", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "fb81dd00-bbc1-b742-a653-da86459f43d6"],
 "where boldface variables are indexed over compartments. "
}], "Text",ExpressionUUID->"865d2b5b-a8a0-d542-ab64-3964a077b6da"]
}, Open  ]],

Cell[CellGroupData[{

Cell["2.2. General evolution law", "Subsection",ExpressionUUID->"03297fb9-0634-bb46-81eb-501df8b08a1a"],

Cell[TextData[{
 "The neuron evolves according to: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         FractionBox[
          RowBox[{
            StyleBox["d", "TI"], 
            StyleBox["x", "TI"]}], 
          RowBox[{
            StyleBox["d", "TI"], 
            StyleBox["t", "TI"]}]], "\[LongEqual]", 
         StyleBox["F", "TI"], 
         RowBox[{"(", 
           RowBox[{
             StyleBox["x", "TI"], ",", 
             StyleBox["u", "TI"], ",", 
             StyleBox["c", "TI"], ",", "\[Theta]", ",", 
             StyleBox["t", "TI"]}], ")"}]}], TraditionalForm], "errors" -> {},
      "input" -> "\\frac{dx}{dt} = F(x,u,c,\\theta,t)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "3c3ed6e9-c0cb-5c47-b849-cb38d9413310"],
 "where: "
}], "Text",ExpressionUUID->"2aaa947d-45f9-9645-9291-e2c8b502ff7b"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["u", "TI"], "(", 
         StyleBox["t", "TI"], ")"}], TraditionalForm], "errors" -> {}, 
     "input" -> "u(t)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "ffb76ab4-c6b0-b348-ad70-72f2b8465617"],
 " = external input processes,"
}], "Item",ExpressionUUID->"d97e9751-d203-fa45-a658-873bf0767d1e"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["c", "TI"], "(", 
         StyleBox["t", "TI"], ")"}], TraditionalForm], "errors" -> {}, 
     "input" -> "c(t)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "a76e04d9-5ea8-dc4e-aab2-d9132fe0e6aa"],
 " = context or environmental state,"
}], "Item",ExpressionUUID->"9d14d7d1-5545-644d-bd7e-844c205cb287"],

