 "\n16. Full dashboard\n",
 Cell[BoxData[
  RowBox[{"Manipulate", "[", "\[IndentingNewLine]", " ", 
   RowBox[{
    RowBox[{"Module", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "mat", ",", "state", ",", "density", ",", "phases", ",", "sources", ",",
         "pot", ",", "field", ",", "report"}], "}"}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"mat", "=", 
        RowBox[{"dampedLaplacian1D", "[", 
         RowBox[{"n", ",", "\[Gamma]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       "  ", 
       RowBox[{"state", "=", 
        RowBox[{"Normalize", "[", 
         RowBox[{
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"1.", "/", 
             RowBox[{"i", "^", "\[Alpha]"}]}], ",", 
            RowBox[{"{", 
             RowBox[{"i", ",", "1", ",", 
              RowBox[{"2", "^", "m"}]}], "}"}]}], "]"}], ",", "Norm"}], 
         "]"}]}], ";", "\[IndentingNewLine]", "  ", 
       RowBox[{"density", "=", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"1.", ",", "c"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"c", ",", "1."}], "}"}]}], "}"}], "/", "2"}]}], ";", 
       "\[IndentingNewLine]", "  ", 
       RowBox[{"phases", "=", 
        RowBox[{"quasiPeriodicSchedule", "[", 
         RowBox[{"steps", ",", "2"}], "]"}]}], ";", "\[IndentingNewLine]", 
       "  ", 
       RowBox[{"sources", "=", 
        RowBox[{"{", "\[IndentingNewLine]", "    ", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"-", "sx1"}], ",", "sy1"}], "}"}], ",", "amp1", ",", 
            "w1"}], "}"}], ",", "\[IndentingNewLine]", "    ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"sx2", ",", 
              RowBox[{"-", "sy2"}]}], "}"}], ",", "amp2", ",", "w2"}], "}"}], 
          ",", "\[IndentingNewLine]", "    ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"sx3", ",", "sy3"}], "}"}], ",", "amp3", ",", "w3"}], 
           "}"}]}], "\[IndentingNewLine]", "  ", "}"}]}], ";", 
       "\[IndentingNewLine]", "  ", 
       RowBox[{"pot", "=", 
        RowBox[{"sourceFieldPotential", "[", "sources", "]"}]}], ";", 
       "\[IndentingNewLine]", "  ", 
       RowBox[{"field", "=", 
        RowBox[{
         RowBox[{"effectiveForce2D", "[", 
          RowBox[{"pot", ",", "\[CapitalOmega]"}], "]"}], "[", 
         RowBox[{"x", ",", "y"}], "]"}]}], ";", "\[IndentingNewLine]", "  ", 
       RowBox[{"report", "=", 
        RowBox[{"multiscaleResonanceReport", "[", 
         RowBox[{
         "mat", ",", "state", ",", "density", ",", "phases", ",", "p", ",", 
          RowBox[{"Min", "[", 
           RowBox[{
            RowBox[{"m", "-", "1"}], ",", "8"}], "]"}], ",", "tol"}], "]"}]}],
        ";", "\[IndentingNewLine]", "  ", 
       RowBox[{"Column", "[", 
        RowBox[{"{", "\[IndentingNewLine]", "    ", 
         RowBox[{
          RowBox[{"Style", "[", 
           
           RowBox[{"\"\<Multiscale Resonance, Stability, and Field Topology \
Dashboard\>\"", ",", "15", ",", "Bold"}], "]"}], ",", "\[IndentingNewLine]", 
          "    ", 
          RowBox[{"report", "[", "\"\<Verdict\>\"", "]"}], ",", 
          "\[IndentingNewLine]", "    ", 
          RowBox[{"Row", "[", 
           RowBox[{"{", 
            RowBox[{"\"\<All three criteria met: \>\"", ",", 
             RowBox[{"report", "[", "\"\<AllThreeQ\>\"", "]"}]}], "}"}], 
           "]"}], ",", "\[IndentingNewLine]", "    ", 
          RowBox[{"Row", "[", 
           RowBox[{"{", 
            RowBox[{"\"\<Continuous-time stability margin: \>\"", ",", 
             RowBox[{"report", "[", 
              
              RowBox[{"\"\<Spectral\>\"", 
               ",", "\"\<StabilityMarginContinuous\>\""}], "]"}]}], "}"}], 
           "]"}], ",", "\[IndentingNewLine]", "    ", 
          RowBox[{"Row", "[", 
           RowBox[{"{", 
            RowBox[{"\"\<Fixed-scale residual: \>\"", ",", 
             RowBox[{"report", "[", "\"\<FixedScaleResidual\>\"", "]"}]}], 
            "}"}], "]"}], ",", "\[IndentingNewLine]", "    ", 
          RowBox[{"Row", "[", 
           RowBox[{"{", 
            RowBox[{"\"\<Pointer weights: \>\"", ",", 
             RowBox[{"report", "[", 
              RowBox[{"\"\<Selection\>\"", ",", "\"\<PointerWeights\>\""}], 
              "]"}]}], "}"}], "]"}], ",", "\[IndentingNewLine]", "    ", 
          RowBox[{"spectralPanel", "[", "mat", "]"}], ",", 
          "\[IndentingNewLine]", "    ", 
          RowBox[{"scalePanel", "[", 
           RowBox[{"state", ",", 
            RowBox[{"Min", "[", 
             RowBox[{
              RowBox[{"m", "-", "1"}], ",", "8"}], "]"}]}], "]"}], ",", 
          "\[IndentingNewLine]", "    ", 
          RowBox[{"pointerPanel", "[", 
           RowBox[{"density", ",", "phases", ",", "p"}], "]"}], ",", 
          "\[IndentingNewLine]", "    ", 
          RowBox[{"effectivePotentialPlot", "[", 
           RowBox[{"pot", ",", "\[CapitalOmega]", ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"-", "3"}], ",", "3"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"-", "3"}], ",", "3"}], "}"}]}], "]"}], ",", 
          "\[IndentingNewLine]", "    ", 
          RowBox[{"fieldCirculationPlot", "[", 
           RowBox[{"field", ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"-", "3"}], ",", "3"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"-", "3"}], ",", "3"}], "}"}]}], "]"}]}], 
         "\[IndentingNewLine]", "  ", "}"}], "]"}]}]}], "\[IndentingNewLine]",
      " ", "]"}], ",", "\[IndentingNewLine]", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"n", ",", "12", ",", "\"\<matrix size\>\""}], "}"}], ",", "4", 
      ",", "24", ",", "2"}], "}"}], ",", "\[IndentingNewLine]", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\[Gamma]", ",", "0.4", ",", "\"\<damping\>\""}], "}"}], ",", 
      "0.05", ",", "2", ",", "0.05"}], "}"}], ",", "\[IndentingNewLine]", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\[Alpha]", ",", "0.5", ",", "\"\<power-law exponent\>\""}], 
       "}"}], ",", "0.1", ",", "2", ",", "0.05"}], "}"}], ",", 
    "\[IndentingNewLine]", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"m", ",", "6", ",", "\"\<signal length 2^m\>\""}], "}"}], ",", 
      "3", ",", "9", ",", "1"}], "}"}], ",", "\[IndentingNewLine]", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"c", ",", "0.8", ",", "\"\<initial coherence\>\""}], "}"}], ",",
       "0", ",", "1", ",", "0.05"}], "}"}], ",", "\[IndentingNewLine]", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"p", ",", "0.15", ",", "\"\<dephasing strength\>\""}], "}"}], ",",
       "0", ",", "1", ",", "0.01"}], "}"}], ",", "\[IndentingNewLine]", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"steps", ",", "20", ",", "\"\<phase steps\>\""}], "}"}], ",", 
      "5", ",", "60", ",", "1"}], "}"}], ",", "\[IndentingNewLine]", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"tol", ",", 
        RowBox[{"10", "^", 
         RowBox[{"-", "6"}]}], ",", "\"\<scale tolerance\>\""}], "}"}], ",", 
      RowBox[{"10", "^", 
       RowBox[{"-", "10"}]}], ",", 
      RowBox[{"10", "^", 
       RowBox[{"-", "3"}]}], ",", 
      RowBox[{"ControlType", "->", "SetterBar"}]}], "}"}], ",", 
    "\[IndentingNewLine]", " ", "Delimiter", ",", "\[IndentingNewLine]", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\[CapitalOmega]", ",", "0.35", ",", "\"\<rotation rate\>\""}],
        "}"}], ",", "0", ",", "1", ",", "0.01"}], "}"}], ",", 
    "\[IndentingNewLine]", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"sx1", ",", "1.5", ",", "\"\<source 1 x-scale\>\""}], "}"}], ",",
       "0.2", ",", "2.5", ",", "0.1"}], "}"}], ",", "\[IndentingNewLine]", 
    " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"sy1", ",", "0.0", ",", "\"\<source 1 y-scale\>\""}], "}"}], ",", 
      RowBox[{"-", "2.5"}], ",", "2.5", ",", "0.1"}], "}"}], ",", 
    "\[IndentingNewLine]", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"sx2", ",", "1.0", ",", "\"\<source 2 x-scale\>\""}], "}"}], ",",
       "0.2", ",", "2.5", ",", "0.1"}], "}"}], ",", "\[IndentingNewLine]", 
    " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"sy2", ",", "0.8", ",", "\"\<source 2 y-scale\>\""}], "}"}], ",",
       "0.2", ",", "2.5", ",", "0.1"}], "}"}], ",", "\[IndentingNewLine]", 
    " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"sx3", ",", "0.5", ",", "\"\<source 3 x-scale\>\""}], "}"}], ",",
       "0.2", ",", "2.5", ",", "0.1"}], "}"}], ",", "\[IndentingNewLine]", 
    " ", 
    RowBox[{"{", 
